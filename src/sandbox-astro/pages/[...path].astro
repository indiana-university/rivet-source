---
import ComponentLayout from "@layouts/ComponentLayout.astro";
import IndexLayout from "@layouts/IndexLayout.astro";

export function getStaticPaths() {
	const allPages = import.meta.glob(
		["@src/**/*.astro", "!@src/sandbox-astro/**/*.astro"],
		{ eager: true },
	);
	const pageEntries: [string, any][] = Object.entries(allPages)
		.map(([k, page]) => {
			const key = k.replace("/src", "");
			return [key, page] as [string, any];
		})
		.filter(([key, page]) => page.title);
	const pageMap = new Map<string, any>(pageEntries);
	const flatPaths = [...pageMap.keys()];
	const allUniquePaths = new Set();

	for (const path of flatPaths) {
		allUniquePaths.add(path);
		let currentPath = path;
		let lastSlashIndex;
		while ((lastSlashIndex = currentPath.lastIndexOf("/")) !== -1) {
			currentPath = currentPath.slice(0, lastSlashIndex);
			allUniquePaths.add(currentPath || "/");
		}
	}

	const sortedPaths = Array.from(allUniquePaths).sort((a: string, b: string) =>
		a.localeCompare(b),
	);
	const pathMap = new Map();

	for (const path of sortedPaths as string[]) {
		const segments = path.split("/");
		const page = pageMap.get(path);
		const title = page?.title || segments.at(-1);
		const isFile = /\.[^/]*$/.test(path);
		const type = isFile ? "file" : "folder";
		const children = [];
		const currentNode = { children, page, path, title, type };
		pathMap.set(path, currentNode);
		const parentPath = path.replace(/\/[^/]*$/, "") || "/";

		if (parentPath !== path && pathMap.has(parentPath)) {
			const parentNode = pathMap.get(parentPath);
			parentNode.children.push(currentNode);
		}
	}

	return Array.from(pathMap.values()).map((props) => {
		const { path } = props;
		const params = { path };
		return { params, props };
	});
}

const { page, type } = Astro.props;
---

{
	type === "file" && (
		<ComponentLayout {...Astro.props}>
			<page.default />
		</ComponentLayout>
	)
}

{type === "folder" && <IndexLayout {...Astro.props} />}
