---
import "../../sass/rivet.scss";
import SideNav from "@components/SideNav.astro";
const { frontmatter = {} } = Astro.props;
const { title } = frontmatter;
const appTitle = "Rivet Design System";
const docTitle = [title, appTitle].join(" - ");
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{docTitle}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Azeret+Mono:ital,wght@0,100..900;1,100..900&family=Roboto+Flex:opsz,wdth,wght,YTLC,YTUC@8..144,25..151,100..1000,540,740&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
			rel="stylesheet"
		/>
		<link
			rel="stylesheet"
			href="https://unpkg.com/rivet-stickers@0.3.0/dist/rivet-sticker-element.css"
		/>
		<script
			type="module"
			src="https://unpkg.com/rivet-stickers@0.3.0/dist/rivet-stickers.js"
		></script>
		<link
			rel="stylesheet"
			href="https://unpkg.com/rivet-icons@3.0.0/dist/rivet-icon-element.css"
		/>
		<script
			type="module"
			src="https://unpkg.com/rivet-icons@3.0.0/dist/rivet-icons.js"></script>
		<script type="module" src="/rivet.js"></script>
	</head>
	<body>
		<header>
			<div class="rvt-border-bottom rvt-ts-base rvt-p-all-sm rvt-text-medium">{appTitle}</div>
			<SideNav />
		</header>
		<main>
			<h1 class="rvt-border-bottom rvt-ts-base rvt-p-tb-sm">{title}</h1>
			<div class="rvt-theme-light rvt-p-all-sm">
				<slot />
			</div>
			<div class="rvt-theme-dark rvt-p-all-sm">
				<slot />
			</div>
			<div class="rvt-theme-crimson rvt-p-all-sm">
				<slot />
			</div>
		</main>
	</body>
</html>

<style>
body {
	display: grid;
	grid-template-columns: 15rem 1fr;
}
</style>