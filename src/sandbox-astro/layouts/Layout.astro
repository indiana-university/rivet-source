---
const { frontmatter, label, title } = Astro.props;
const appTitle = "Rivet";
const pageTitle = title || frontmatter?.title || label || appTitle;
const currentPath = Astro.url.pathname;
const isRoot = currentPath === "/";
const docTitle = isRoot ? appTitle : [pageTitle, appTitle].join(" - ");
const breadcrumbs = (isRoot ? "" : currentPath)
	.split("/")
	.map((part, i, source) => {
		const current = i + 1 < source.length ? null : true;
		const label = current ? pageTitle : (part || appTitle);
		const _url = source.slice(1, i + 1).join("/");
		const url = `/${_url}`;
		return { current, label, url };
	})
	.filter((item) => item.url);
const parentPage = breadcrumbs.at(-2);
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{docTitle}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<script
			type="module"
			src="https://unpkg.com/rivet-stickers@0.3.0/dist/rivet-stickers.js"
		></script>
		<script
			type="module"
			src="https://unpkg.com/rivet-icons@3.0.0/dist/rivet-icons.js"></script>
		<script type="module" src="/src/rivet.js"></script>
	</head>
	<body>
		<header class="rvt-border-bottom rvt-flex rvt-items-center rvt-gap-sm rvt-p-all-sm">
			<a class="rvt-button rvt-button--small rvt-button--icon-only rvt-button--subtle" href={parentPage?.url}>
				<rvt-icon name="arrow-left"></rvt-icon>
				<span class="rvt-sr-only">{parentPage?.label}</span>
			</a>
			<nav class="rvt-border-left rvt-flex rvt-p-left-sm">
				<ol class="rvt-breadcrumbs">
					{breadcrumbs.map((item) => (
						<li aria-current={item.current}>
							<a href={item.url}>
								{item.label}
							</a>
						</li>
					))}
				</ol>
			</nav>
			<h1 class="rvt-sr-only">{title}</h1>
		</header>
		<slot />
	</body>
</html>
