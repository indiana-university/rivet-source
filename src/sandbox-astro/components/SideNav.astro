---
const { familyPages } = Astro.props;
---

<nav class="rvt-p-all-sm">
	{familyPages.map(({ parent, children }) => (
		<div class="rvt-sidenav rvt-sidenav--compact rvt-m-top-none">
			<h2 class="rvt-sidenav__label">{parent.title}</h2>
			<ul class="rvt-sidenav__list">
			{children.map((page) => (
				<li class="rvt-sidenav__item">
					<a
						aria-current={page.current ? "page" : null}
						class="rvt-sidenav__link"
						href={page.url}
					>
						{page.title}
					</a>
				</li>
			))}
			</ul>
		</div>
	))}
</nav>
