---
const allPages = Object.values(import.meta.glob("@pages/**/*.mdx", { eager: true }));
const all = allPages
	.map((page) => {
		const parts = page.url.split("/").filter((p) => p);
		const section = slugToTitle(parts[0]);
		const group = slugToTitle(parts[1]);
		const item = parts[2];
		const { frontmatter, url } = page;
		const { title } = frontmatter;
		const current = Astro.url.pathname === url;
		return { section, group, item, title, url, current };
	})
	.filter(({ section }) => section)
	.filter(({ group }) => group)
	.filter(({ item }) => item)
	.sort((a, b) => a.title.localeCompare(b.title));
const sections = Object.groupBy(all, (item) => item.section);
Object.entries(sections).forEach(([key, items]) => {
	const out = Object.groupBy(items, (item) => item.group);
	sections[key] = Object.entries(out).sort((a, b) =>
		a[0].localeCompare(b[0]),
	);
});
const nav = Object.entries(sections).sort((a, b) => a[0].localeCompare(b[0]));
console.log('##', nav)
const localPages = []

function slugToTitle(slug) {
	if (!slug) {
		return slug;
	}
	return slug
		.split(/[-_]/)
		.map((word) => word.charAt(0).toUpperCase() + word.slice(1))
		.join(" ");
}
