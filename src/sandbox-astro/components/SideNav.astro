---

<nav class="rvt-sidenav rvt-sidenav--compact rvt-p-all-sm rvt-m-top-none">
	{nav.map((section) => {
		const [sectionLabel, groups] = section;
		return (
			<h2 class="rvt-sidenav__label">{sectionLabel}</h2>
			<ul class="rvt-sidenav__list">
				{groups.map((group) => {
					const [groupLabel, items] = group;
					const [firstItem] = items;
					return (
						<li class="rvt-sidenav__item">
							<a class="rvt-sidenav__link" href={firstItem.url}>
								{groupLabel}
							</a>
							<ul class="rvt-sidenav__list u-show-if-has-current">
								{items.map((item) => (
									<li class="rvt-sidenav__item">
										<a
											aria-current={item.current ? "page" : null}
											class="rvt-sidenav__link"
											href={item.url}
										>
											{item.title}
										</a>
									</li>
								))}
							</ul>
						</li>
					)
				})}
			</ul>
		);
	})}
</nav>
