<div class="rvt-flex rvt-gap-xs">
	<button class="rvt-button" aria-pressed="true">Button pressed</button>
	<button class="rvt-button" aria-pressed="false">
		<rvt-icon name="thumbs-up"></rvt-icon>
		Like
	</button>
	<button class="rvt-button" aria-pressed="true">
		<rvt-icon name="thumbs-up"></rvt-icon>
		Like
	</button>
	<button class="rvt-button" aria-pressed="false">
		<rvt-icon name="heart"></rvt-icon>
		<span class="rvt-sr-only">Favorite</span>
	</button>
	<button class="rvt-button" aria-pressed="true">
		<rvt-icon name="heart"></rvt-icon>
		<span class="rvt-sr-only">Favorite</span>
	</button>
</div>

<script>
	document.addEventListener("click", (event) => {
		const pressed = "aria-pressed";
		const target = event.target.closest(`[${pressed}]`);
		if (target) {
			const value = target.getAttribute(pressed) === "true" ? false : true;
			target.setAttribute(pressed, value);
		}
	});
</script>
