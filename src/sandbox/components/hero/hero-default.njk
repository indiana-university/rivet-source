---
title: Hero - Default
---

<div class="rvt-hero">
	<div class="rvt-hero__inner">
		<div class="rvt-hero__body">
			<span class="rvt-hero__eyebrow">
				{Tag or section title}
			</span>
			<h1 class="rvt-hero__title">Become the best version of yourself at IU</h1>
			<div class="rvt-hero__teaser">
				<p>
					Develop the skills you need for a rewarding career, and follow in the
					footsteps of more than 729,000 IU alumni who are leading
					organizations, innovating the future, and making an impact on their
					communities and the world.
				</p>
			</div>
			<div class="rvt-hero__actions">
				<a href="/#" class="rvt-button rvt-button--cta rvt-button--solid">Discover careers</a>
				<a href="/#" class="rvt-button rvt-button--cta">Discover careers</a>
			</div>
		</div>

		<div class="rvt-hero__callout">
			<div class="rvt-card rvt-card--raised rvt-card--clickable">
				<div class="rvt-card__body">
					<div class="rvt-card__eyebrow">Category</div>
					<h2 class="rvt-card__title">
						<a href="#">Find your ideal campus life at IU</a>
					</h2>
					<div class="rvt-card__content [ rvt-ts-14 ]">
						<p>
							Organizations, innovating the future, and making an impact on
							their communities and the world.
						</p>
					</div>
				</div>
			</div>
		</div>

		{#
		<div class="rvt-hero__media">
			<img src="https://picsum.photos/id/29/600/400" alt="" />
		</div>
		#}
	</div>
</div>
