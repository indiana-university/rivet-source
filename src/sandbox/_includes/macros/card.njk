{% macro ProfileCard(type = 'plain') %}
<div class="rvt-card rvt-card--event">
	<div class="rvt-card__body">
		{% if type == 'avatar' %}
		<div class="rvt-avatar rvt-avatar--md rvt-m-bottom-sm">
			<img class="rvt-avatar__image" src="https://rivet.iu.edu/img/placeholder/avatar-1.webp" alt="">
		</div>
		{% endif %}
		<div class="rvt-card__eyebrow">{Campus/Team/Department}</div>
		<h2 class="rvt-card__title">
			<a href="#">{First and Last Name}</a>
		</h2>
		<ul class="rvt-card__event-list rvt-list-plain">
			<li>
				<rvt-icon name="user"></rvt-icon>
				<strong>Pronouns:</strong>
				<span>She/Her</span>
			</li>
			<li>
				<rvt-icon name="envelope"></rvt-icon>
				<a href="mailto:example@iu.edu">example@iu.edu</a>
			</li>
			<li>
				<rvt-icon name="phone"></rvt-icon>
				<a href="tel:8124441717">(812) 444-1717</a>
			</li>
			<li>
				<rvt-icon name="device"></rvt-icon>
				<a href="#">examplesite.com</a>
			</li>
		</ul>
		<div class="rvt-card__meta">
			<span>Areas of expertise</span>
		</div>
		<div class="rvt-card__tags">
			<ul class="rvt-list-inline rvt-gap-xs">
				<li>
					<a href="#" class="rvt-button rvt-button--tag">UI/UX Design</a>
				</li>
				<li>
					<a href="#" class="rvt-button rvt-button--tag">Branding</a>
				</li>
				<li>
					<a href="#" class="rvt-button rvt-button--tag">Illustration</a>
				</li>
			</ul>
		</div>
	</div>
</div>
{% endmacro %}

