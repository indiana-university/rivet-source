<div
	class="rvt-header__mobile-menu"
	id="mobile-menu"
	role="dialog"
	tabindex="-1"
	aria-labelledby="dialog-title"
	aria-describedby="dialog-description"
	data-rvt-dialog="mobile-menu"
	data-rvt-dialog-modal
	data-rvt-dialog-darken-page
	data-rvt-dialog-disable-page-interaction
	hidden
>
	<nav class="rvt-sidenav" aria-labelledby="sidenav-label" data-rvt-sidenav>
		<span class="rvt-sidenav__label [ rvt-p-left-sm ]" id="sidenav-label"
			>Site navigation</span
		>
		<ul class="rvt-sidenav__list [ rvt-p-top-xs ]">
			<li class="rvt-sidenav__item">
				<a href="#" class="rvt-sidenav__link">Section nav one</a>
			</li>
			<li class="rvt-sidenav__item">
				<a href="#" class="rvt-sidenav__link" aria-current="page"
					>Section nav two</a
				>
			</li>
			<li class="rvt-sidenav__item">
				<div class="rvt-sidenav__item-wrapper">
					<a href="#" class="rvt-sidenav__link">Section nav three</a>
					<button class="rvt-sidenav__toggle" data-rvt-sidenav-toggle>
						<span class="rvt-sr-only">Show more section nav three links</span>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="16"
							height="16"
							fill="currentColor"
							viewBox="0 0 16 16"
						>
							<path
								d="m15.146 6.263-1.292-1.526L8 9.69 2.146 4.737.854 6.263 8 12.31l7.146-6.047Z"
							/>
						</svg>
					</button>
				</div>
				<ul class="rvt-sidenav__list" data-rvt-sidenav-list>
					<li class="rvt-sidenav__item">
						<a href="#" class="rvt-sidenav__link">Level two</a>
					</li>
					<li class="rvt-sidenav__item">
						<a href="#" class="rvt-sidenav__link">Level two</a>
					</li>
					<li class="rvt-sidenav__item">
						<div class="rvt-sidenav__item-wrapper">
							<a href="#" class="rvt-sidenav__link">Level two</a>
							<button class="rvt-sidenav__toggle" data-rvt-sidenav-toggle>
								<span class="rvt-sr-only">Show more level two links</span>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="16"
									height="16"
									fill="currentColor"
									viewBox="0 0 16 16"
								>
									<path
										d="m15.146 6.263-1.292-1.526L8 9.69 2.146 4.737.854 6.263 8 12.31l7.146-6.047Z"
									/>
								</svg>
							</button>
						</div>
						<ul class="rvt-sidenav__list" data-rvt-sidenav-list>
							<li class="rvt-sidenav__item">
								<a href="#" class="rvt-sidenav__link">Level three</a>
							</li>
							<li class="rvt-sidenav__item">
								<a href="#" class="rvt-sidenav__link">Level three</a>
							</li>
						</ul>
					</li>
				</ul>
			</li>
		</ul>
	</nav>

	<button
		class="rvt-header__button rvt-header__button--mobile-menu-close"
		data-rvt-dialog-close="dialog-example"
		role="button"
		aria-label="Toggle menu"
	>
		<svg
			aria-hidden="true"
			fill="currentColor"
			focusable="false"
			height="16"
			viewBox="0 0 16 16"
			width="16"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path
				d="m3.5 2.086 4.5 4.5 4.5-4.5L13.914 3.5 9.414 8l4.5 4.5-1.414 1.414-4.5-4.5-4.5 4.5L2.086 12.5l4.5-4.5-4.5-4.5L3.5 2.086Z"
			></path>
		</svg>
	</button>
</div>
