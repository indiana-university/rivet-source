<div class="rvt-billboard rvt-billboard--reverse rvt-billboard--compact">
	<div class="rvt-billboard__image">
		<img
			src="https://picsum.photos/id/133/800/600"
			alt="Student in vintage-style Indiana University t-shirt"
		/>
	</div>
	<div class="rvt-billboard__body">
		<p class="rvt-billboard__eyebrow">{Featured Card}</p>
		<h2 class="rvt-billboard__title">
			{title should not exceed 32 characters}
		</h2>
		<div class="rvt-billboard__content">
			<p>
				{Billboard descriptions should not exceed one paragraph or 32
				characters. One to two brief sentences will keep the user engaged with
				your content.}
			</p>
		</div>
	</div>
</div>
