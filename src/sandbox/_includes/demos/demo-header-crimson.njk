<header data-site-header class="rvt-header rvt-theme-crimson">
  <!-- Hidden link for keyboard users to skip to main content -->
  <a class="rvt-skip-link" href="#main-content">Skip to main content</a>
  <div class="rvt-header__inner">
    <a class="rvt-lockup" href="/">
      <!-- Trident logo -->
      <div class="rvt-lockup__tab">
        <svg xmlns="http://www.w3.org/2000/svg" class="rvt-lockup__trident" width="28" height="34" viewBox="0 0 28 34">
          <path d="M-3.34344e-05 4.70897H8.83308V7.174H7.1897V21.1426H10.6134V2.72321H8.83308V0.121224H18.214V2.65476H16.2283V21.1426H19.7889V7.174H18.214V4.64047H27.0471V7.174H25.0614V23.6761L21.7746 26.8944H16.2967V30.455H18.214V33.8787H8.76463V30.592H10.6819V26.8259H5.20403L1.91726 23.6077V7.174H-3.34344e-05V4.70897Z" fill="currentColor"></path>
        </svg>
      </div>
      <!-- Website or application title -->
      <div class="rvt-lockup__body">
        <div class="rvt-lockup__title">{Lockup title}</div>
        <div class="rvt-lockup__subtitle">{School or department}</div>
      </div>
    </a>

    <!-- Menu slot -->
    <div class="rvt-header__controls">
      <nav class="rvt-header-menu">
        <ul data-visible-links class="rvt-header-menu__list">
          <li class="rvt-header-menu__item">
              <a class="rvt-header-menu__link" href="#">Academics</a>
          </li>
          <li class="rvt-header-menu__item">
              <a class="rvt-header-menu__link" href="#">Admissions</a>
          </li>

          <li class="rvt-header-menu__item">
              <a class="rvt-header-menu__link" href="#">Cost &amp; Financial Aid</a>
              <div class="rvt-dropdown" data-rvt-dropdown="example-dropdown">
                <button data-rvt-dropdown-toggle>
                  <svg aria-hidden="true" fill="currentColor" focusable="false" height="16" viewBox="0 0 16 16" width="16" xmlns="http://www.w3.org/2000/svg"><path d="m15.146 6.263-1.292-1.526L8 9.69 2.146 4.737.854 6.263 8 12.31l7.146-6.047Z"></path></svg>
                </button>
                <div class="rvt-dropdown__menu" data-rvt-dropdown-menu hidden>
                  <ul>
                    <li><a href="#">Item one</a></li>
                    <li><a href="#">Item two</a></li>
                    <li><a href="#">Item three</a></li>
                  </ul>
                </div>
              </div>
          </li>

          <li class="rvt-header-menu__item">
              <a class="rvt-header-menu__link" href="#">Research</a>
          </li>
          <li class="rvt-header-menu__item">
              <a class="rvt-header-menu__link" href="#">Student Support</a>
          </li>
          <li class="rvt-header-menu__item">
              <a class="rvt-header-menu__link" href="#">Campus Life</a>
          </li>
          <li class="rvt-header-menu__item">
              <a class="rvt-header-menu__link" href="#">About</a>
          </li>
          <li class="rvt-header-menu__item">
              <a class="rvt-header-menu__link" href="#">Alumni and Giving</a>
          </li>
        </ul>

        <!--
          TODO: think about adding this markup via JS on initialization
        -->
        <div class="rvt-header-menu__more rvt-dropdown" data-rvt-dropdown="example-dropdown">
          <button data-rvt-more-toggle data-rvt-dropdown-toggle>
            <span>More</span>
            <svg aria-hidden="true" fill="currentColor" focusable="false" height="16" viewBox="0 0 16 16" width="16" xmlns="http://www.w3.org/2000/svg"><path d="M4 8a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm6 0a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm4 2a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"></path></svg>
          </button>
          <div class="rvt-dropdown__menu rvt-dropdown__menu--right" data-rvt-dropdown-menu hidden>

            <ul data-hidden-links >
            </ul>

          </div>
        </div>
      </nav>
    </div>

    <div class="rvt-header__buttons">
      <button class="rvt-header__button">
        <svg aria-hidden="true" fill="currentColor" focusable="false" height="16" viewBox="0 0 16 16" width="16" xmlns="http://www.w3.org/2000/svg"><path d="M7 2a5 5 0 1 0 0 10A5 5 0 0 0 7 2ZM0 7a7 7 0 1 1 12.606 4.192l3.101 3.1-1.414 1.415-3.1-3.1A7 7 0 0 1 0 7Z"></path></svg>
      </button>
      <button data-rvt-dialog-trigger="dialog-example" aria-label="Toggle menu" class="rvt-header__button rvt-header__button--mobile-menu">
        <svg aria-hidden="true" fill="currentColor" focusable="false" height="16" viewBox="0 0 16 16" width="16" xmlns="http://www.w3.org/2000/svg"><path d="M15 4H1V2h14v2Zm0 5H1V7h14v2ZM1 14h14v-2H1v2Z"></path></svg>
      </button>
    </div>
  </div><!-- end header__inner -->
  {% include "demos/header-demos/header-mobile-menu.njk" %}
</header>
<script>
  const navElement = document.querySelector('[data-site-header]');
  const visibleLinks = navElement.querySelector('[data-visible-links]');
  const buttonElement = navElement.querySelector('[data-rvt-more-toggle]');
  const hiddenLinks = navElement.querySelector('[data-hidden-links]');

  let numberOfItems = 0;
  let totalSpace = 0;
  let itemHideWidths = [];
  let availableSpace;
  let numberOfVisibleItems;
  let requiredSpace;

  // Set up initial state
  [...visibleLinks.children].forEach(item => {
    // "+ 16" means we're guessing at a 1rem/16px gap between each
    // nav item. Could maybe figure a better way to calculate this
    // but it's dependent on how the items are styled.
    totalSpace += item.offsetWidth + 20;
    numberOfItems += 1;
    itemHideWidths.push(totalSpace);
  });

  function checkNav() {
    availableSpace = visibleLinks.offsetWidth;
    numberOfVisibleItems = [...visibleLinks.children].length;
    requiredSpace = itemHideWidths[numberOfVisibleItems - 1];

    if (requiredSpace > availableSpace) {
      // Move last link of visible to first link of hidden
      const lastVisibleChild = [...visibleLinks.children][numberOfVisibleItems - 1];
      hiddenLinks.insertAdjacentElement('afterbegin', lastVisibleChild);
      numberOfVisibleItems -= 1;
      // Recursively call this checkNav function
      checkNav();
    } else if (availableSpace > itemHideWidths[numberOfVisibleItems]) {
      // Move first link from hidden to end of visible links
      const firstHiddenChild = [...hiddenLinks.children][0];
      visibleLinks.insertAdjacentElement('beforeend', firstHiddenChild);
      numberOfVisibleItems += 1;
    }

    numberOfVisibleItems === numberOfItems ?
      buttonElement.setAttribute('hidden', '') :
      buttonElement.removeAttribute('hidden');
  }

  const navObserver = new ResizeObserver(entries => {
    for (const entry of entries) {
      checkNav();
    }
  });

  navObserver.observe(navElement);

  checkNav();

  // Dropdown hover
  const navListNode = document.querySelector('.rvt-header-menu');
  const navListItemNodes = document.querySelectorAll('.rvt-header-menu__item');

  navListNode.addEventListener('mouseover', event => {
    const listItemNode = event.target.closest('.rvt-header-menu__item');
    if (!listItemNode) return;
    const listItemDropdown = listItemNode.querySelector('[data-rvt-dropdown]');
    if (!listItemDropdown) return;
    const listItemDropdownMenu = listItemDropdown.querySelector('[data-rvt-dropdown-menu]');
    listItemDropdown.open();
    listItemDropdownMenu.style.left = `-${listItemNode.offsetWidth - 16}px`;
  });

  navListNode.addEventListener('mouseout', event => {
    const listItemNode = event.target.closest('.rvt-header-menu__item');
    if (!listItemNode) return;
    const listItemDropdown = listItemNode.querySelector('[data-rvt-dropdown]');
    if (!listItemDropdown) return;
    listItemDropdown.close();
  });
</script>