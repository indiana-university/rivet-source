									Normal title length is five
								</a>
							</li>
						</ul>
					</div>
				</div>

				<figure class="rvt-hero__media">
					<img
						src="https://picsum.photos/id/10/800/1200"
						alt="This image can have alt text now"
					/>
				</figure>
			</div>
		</div>
		<!-- end hero -->
	</div>

	<div class="rvt-section rvt-theme-light [ rvt-border-top rvt-p-bottom-none ]">
