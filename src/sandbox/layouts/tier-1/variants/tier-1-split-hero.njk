						<a href="/#" class="rvt-button rvt-button--outline"
							>See all degrees</a
						>
					</div>
					#}

					<div class="rvt-list-hub [ rvt-m-top-xxl ]">
						<h2 class="rvt-list-hub__title">Quick links</h2>
