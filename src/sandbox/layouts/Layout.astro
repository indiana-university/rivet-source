---
import "@src/rivet.scss";

const APP_NAME = "Rivet";
const title = Astro.props.title || APP_NAME;
const currentPath = Astro.url.pathname;
const isRoot = currentPath === "/";
const docTitle = isRoot ? APP_NAME : [title, APP_NAME].join(" - ");
const breadcrumbs = (isRoot ? "" : currentPath)
	.split("/")
	.map((part, i, source) => {
		const last = i === source.length - 1;
		const current: boolean | "page" = last ? "page" : false;
		const label = current ? title : part || APP_NAME;
		const _url = source.slice(1, i + 1).join("/");
		const url = `/${_url}`;
		return { current, label, last, url };
	});
const parentPage = breadcrumbs.at(-2);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{docTitle}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<script type="module">
			import Rivet from "/src/rivet.js";
			import "/src/rivet-icons.js";
			import "/src/rivet-stickers.js";
			Rivet.init();
		</script>
	</head>
	<body>
		<header
			class="rvt-border-bottom rvt-flex rvt-items-center rvt-gap-sm rvt-p-all-sm rvt-theme-dark"
		>
			<a
				class="rvt-button rvt-button--small rvt-button--icon-only rvt-button--subtle"
				href={parentPage?.url}
			>
				<rvt-icon name="arrow-left"></rvt-icon>
				<span class="rvt-sr-only">{parentPage?.label}</span>
			</a>
			<nav class="rvt-border-left rvt-flex rvt-p-left-sm">
				<ol class="rvt-breadcrumbs">
					{
						breadcrumbs.map((item) => (
							<li aria-current={item.current}>
								{!item.last && <a href={item.url}>{item.label}</a>}
								{item.last && item.label}
							</li>
						))
					}
				</ol>
			</nav>
			<h1 class="rvt-sr-only">{title}</h1>
		</header>
		<slot />
	</body>
</html>
