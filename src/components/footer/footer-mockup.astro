						</ul>
					</div>
					<div>
						<h3>Email</h3>
						<ul>
							<li>
								<a
									href="https://servicenow.iu.edu/kb?id=kb_article_view&sysparm_article=KB0023187"
								>
									About email at IU
								</a>
							</li>
							<li>
								<a
									href="https://uits.iu.edu/services/accounts-and-email/exchange/"
								>
									Exchange
								</a>
							</li>
						</ul>
					</div>
					<div>
						<h3>Find</h3>
						<ul>
							<li>
								<a href="https://directory.iu.edu"> People Directory </a>
							</li>
							<li>
								<a href="https://jobs.iu.edu">Jobs at IU</a>
							</li>
							<li>
								<a href="https://iu.edu/nondiscrimination/">
									Non-Discrimination Notice
								</a>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
		<div class="rvt-footer__section">
			<div class="rvt-footer__base">
				<div class="rvt-footer__logo">
