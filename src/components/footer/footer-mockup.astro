---
export const title = "Footer (mockup)";
const year = new Date().getFullYear();
---

<footer class="rvt-footer">
	<div class="rvt-container">
		<div class="rvt-footer__resources">
			<h2 class="rvt-sr-only">Resources</h2>
			<div class="rvt-footer__address">
				<h3>Indiana University</h3>
				<p>
					107 S. Indiana Avenue<br />
					Bloomington, IN 47405-7000
				</p>
				<p>
					<a href="tel:8128554848">(812) 855-4848</a>
				</p>
				<div class="rvt-footer__social">
					<h3 class="rvt-sr-only">Social media</h3>
					<ul>
						<li>
							<a href="#" class="rvt-social-link rvt-social-link--bluesky">
								<span class="rvt-sr-only">Bluesky</span>
							</a>
						</li>
						<li>
							<a href="#" class="rvt-social-link rvt-social-link--facebook">
								<span class="rvt-sr-only">Facebook</span>
							</a>
						</li>
						<li>
							<a href="#" class="rvt-social-link rvt-social-link--instagram">
								<span class="rvt-sr-only">Instagram</span>
							</a>
						</li>
						<li>
							<a href="#" class="rvt-social-link rvt-social-link--linkedin">
								<span class="rvt-sr-only">LinkedIn</span>
							</a>
						</li>
						<li>
							<a href="#" class="rvt-social-link rvt-social-link--youtube">
								<span class="rvt-sr-only">YouTube</span>
							</a>
						</li>
						<li>
							<a href="#" class="rvt-social-link rvt-social-link--x">
								<span class="rvt-sr-only">X</span>
							</a>
						</li>
					</ul>
				</div>
			</div>
			<div class="rvt-footer__links">
				<div>
					<h3>Services</h3>
					<ul>
						<li>
							<a href="https://one.iu.edu">One.IU</a>
						</li>
						<li>
							<a href="https://canvas.iu.edu">Canvas</a>
						</li>
					</ul>
				</div>
				<div>
					<h3>Email</h3>
					<ul>
						<li>
							<a
								href="https://servicenow.iu.edu/kb?id=kb_article_view&sysparm_article=KB0023187"
							>
								About email at IU
							</a>
						</li>
						<li>
							<a
								href="https://uits.iu.edu/services/accounts-and-email/exchange/"
							>
								Exchange
							</a>
						</li>
					</ul>
				</div>
				<div>
					<h3>Find</h3>
					<ul>
						<li>
							<a href="https://directory.iu.edu"> People Directory </a>
						</li>
						<li>
							<a href="https://jobs.iu.edu">Jobs at IU</a>
						</li>
						<li>
							<a href="https://iu.edu/nondiscrimination/">
								Non-Discrimination Notice
							</a>
						</li>
					</ul>
				</div>
			</div>
		</div>
		<div class="rvt-footer__legal">
			<h2 class="rvt-sr-only">Legal</h2>
			<ul>
				<li>
					<a href="https://accessibility.iu.edu/assistance/">
						Accessibility
					</a>
				</li>
				<li>
					<a href="#">Privacy Notice</a>
				</li>
				<li>
					<a href="#">Copyright</a> © {year} The Trustees
					of
					<a href="https://www.iu.edu">Indiana University</a>
				</li>
			</ul>
		</div>
	</div>
</footer>
