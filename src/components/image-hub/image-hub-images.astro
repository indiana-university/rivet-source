---
import ImageHub from "./image-hub.astro";
export const title = "Image Hub with three images";
---

<div>
	<ImageHub type="landscape-start" caption="Landscape start" />
</div>
<div class="rvt-m-top-xxl">
	<ImageHub type="landscape-end" caption="Landscape end" />
</div>
<div class="rvt-m-top-xxl">
	<ImageHub type="portrait-start" caption="Portrait start" />
</div>
<div class="rvt-m-top-xxl">
	<ImageHub type="portrait-end" caption="Portrait end" />
</div>
