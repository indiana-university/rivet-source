---
export const title = "Media Hub with single image";
---

<div class="rvt-container">
	<figure class="rvt-media-hub">
		<div class="rvt-media-hub__media">
			<picture class="rvt-media-hub__6">
				<source
					media="(max-width: 740px)"
					srcset="https://picsum.photos/id/18/1080/720"
				/>
				<img
					loading="lazy"
					decoding="async"
					src="https://picsum.photos/id/16/1200/800"
				/>
			</picture>
		</div>
		<figcaption class="rvt-media-hub__caption">Test caption</figcaption>
	</figure>
</div>
