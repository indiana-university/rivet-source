---
import MediaHub from "./media-hub.astro";
export const title = "Media Hub with three images";
---

<div>
	<MediaHub type="landscape-start" caption="Landscape start" />
</div>
<div class="rvt-m-top-xxl">
	<MediaHub type="landscape-end" caption="Landscape end" />
</div>
<div class="rvt-m-top-xxl">
	<MediaHub type="portrait-start" caption="Portrait start" />
</div>
<div class="rvt-m-top-xxl">
	<MediaHub type="portrait-end" caption="Portrait end" />
</div>
