---
const { teaser, type = "landscape-start", caption } = Astro.props;
---

<figure class={`rvt-media-hub rvt-media-hub--${type}`}>
	{teaser && (
		<p class="rvt-media-hub__teaser">
			Simple one to two sentence statement about about school or site that can
			also serve as a way to link to sections. Learn more about
			<a href="#">lorem ipsum</a>.
		</p>
	)}
	<ol class="rvt-media-hub__media">
		<li>
			<img src="https://picsum.photos/id/46/600/400" alt="" />
		</li>
		<li>
			<img src="https://picsum.photos/id/28/600/400" alt="" />
		</li>
		<li>
			<img src="https://picsum.photos/id/19/800/400" alt="" />
		</li>
	</ol>
	{caption && (
		<figcaption class="rvt-media-hub__caption">
			{caption}
		</figcaption>
	)}
</figure>
