---
export const title = "Media Hub with video";
---

<figure class="rvt-media-hub">
	<div class="rvt-media-hub__media">
		<div class="rvt-media-hub__column-third rvt-media-hub__row-bottom">
			<img src="https://picsum.photos/id/44/600/600" alt="" />
		</div>
		<div class="rvt-media-hub__column-third rvt-media-hub__row-bottom">
			<img src="https://picsum.photos/id/23/600/600" alt="" />
		</div>
		<div class="rvt-media-hub__column-third rvt-media-hub__row-bottom">
			<img src="https://picsum.photos/id/94/600/600" alt="" />
		</div>
		<div
			class="rvt-media-hub__column-full-width rvt-media-hub__row-top rvt-media-hub__16x9"
		>
			<iframe
				width="560"
				height="315"
				src="https://www.youtube.com/embed/L4coo0xCFcI?si=PETgKXU2LjV7ALLl"
				title="YouTube video player"
				frameborder="0"
				allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
				referrerpolicy="strict-origin-when-cross-origin"
				allowfullscreen
			>
			</iframe>
		</div>
	</div>
	<figcaption class="rvt-media-hub__caption">Test caption</figcaption>
</figure>
