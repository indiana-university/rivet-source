---
import { createId } from "@src/utilities/createId.js";

const { id } = Astro.props;
const searchInputId = createId();
---

<div
	aria-label="search"
	class="rvt-header__search-bar"
	data-rvt-dialog={id}
	data-rvt-dialog-modal
	data-rvt-dialog-disable-page-interaction
	hidden
	id={id}
	role="dialog"
	tabindex="-1"
>
	<form action="" class="rvt-container">
		<label for={searchInputId} class="rvt-sr-only"> Search this site </label>
		<input
			class="rvt-text-input"
			id={searchInputId}
			name="search"
			placeholder="Search this site"
			type="text"
		/>
		<button class="rvt-button rvt-button--strong" type="submit">
			Search
		</button>
		<button
			class="rvt-button rvt-button--subtle rvt-button--icon-only"
			data-rvt-dialog-close={id}
			type="button"
		>
			<rvt-icon name="close"></rvt-icon>
			<span class="rvt-sr-only">Close search</span>
		</button>
	</form>
</div>
