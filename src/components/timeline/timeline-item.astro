<div class="rvt-timeline__item">
	<div class="rvt-timeline__label">Label</div>
	<div class="rvt-timeline__content">
		<h2 class="rvt-timeline__title">
			This card title should be concise and should not exceed 78 characters or 3
			lines of text
		</h2>
		<div class="rvt-timeline__description rvt-rich-text">
			<p>
				Try and keep card descriptions brief. One to three short sentences will
				keep the user engaged with your content.
			</p>
		</div>
		<div class="rvt-timeline__dates">
			<p>
				<rvt-icon name="calendar"></rvt-icon>
				Important dates:
			</p>
			<ul class="rvt-list-plain">
				<li><strong>Enrollment deadline:</strong> June 1</li>
				<li><strong>Classes begin:</strong> August 25</li>
			</ul>
		</div>
		<div class="rvt-timeline__actions rvt-button-group">
			<a href="/" class="rvt-button rvt-button--cta">Browse course catalog</a>
			<a href="/" class="rvt-button rvt-button--cta">Register for classes</a>
		</div>
	</div>
</div>
