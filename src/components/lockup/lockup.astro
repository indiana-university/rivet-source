---
export const title = "Lockup";
---

<div class="resize">
	<rvt-lockup>
		<rvt-logo-iu tab></rvt-logo-iu>
		<div>
			<span slot="title">Indiana University</span>
		</div>
	</rvt-lockup>

	<rvt-lockup>
		<a href="/">
			<rvt-logo-iu tab></rvt-logo-iu>
			<div>
				<span slot="parent">Indiana University</span>
				<span slot="title">Bloomington</span>
			</div>
		</a>
	</rvt-lockup>

	<rvt-lockup>
		<a href="/">
			<rvt-logo-iu tab></rvt-logo-iu>
			<div>
				<span slot="parent">IU Bloomington</span>
				<span slot="title">Metropolitan Governance and Management Transitions Laboratory</span>
			</div>
		</a>
	</rvt-lockup>
</div>

<style>
	.resize {
		display: inline-flex;
		flex-direction: column;
		gap: var(--rvt-size-24);
		overflow: auto;
		padding: var(--rvt-size-8);
		resize: horizontal;
	}
</style>
