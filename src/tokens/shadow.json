{
	"shadow": {
		"$type": "shadow",
		"base": {
			"$value": {
				"color": "{color.shadow.light}",
				"offsetX": 0,
				"offsetY": "{size.4}",
				"blur": "{size.8}",
				"spread": 0
			}
		},
		"subtle": {
			"$value": {
				"color": "{color.shadow.extralight}",
				"offsetX": 0,
				"offsetY": "{size.3}",
				"blur": "{size.6}",
				"spread": 0
			}
		},
		"standard": {
			"$value": "{shadow.base}"
		},
		"heavy": {
			"$value": {
				"color": "{color.shadow.main}",
				"offsetX": 0,
				"offsetY": "{size.4}",
				"blur": "{size.16}",
				"spread": 0
			}
		}
	}
}
