{
  "shadow": {
    "$type": "shadow",
    "base": {
      "$value": {
        "color": "{color.shadow.light}",
        "offsetX": 0,
        "offsetY": "{spacing.xxs}",
        "blur": "{spacing.xs}",
        "spread": 0
      }
    },
    "subtle": {
      "$value": {
        "color": "{color.shadow.extralight}",
        "offsetX": 0,
        "offsetY": ".1875rem",
        "blur": ".375rem",
        "spread": 0
      }
    },
    "standard": {
      "$value": "{shadow.base}"
    },
    "heavy": {
      "$value": {
        "color": "{color.shadow.main}",
        "offsetX": 0,
        "offsetY": "{spacing.xxs}",
        "blur": "{spacing.sm}",
        "spread": 0
      }
    }
  }
}
