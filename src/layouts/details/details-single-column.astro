---
import DetailsContent from "./details-content.astro";
import Header from "@src/components/header/header.astro";
import HeroCallout from "@src/components/hero/hero-callout.astro";
import Footer from "@src/components/footer/footer-demo.astro";
export const title = "Details layout - Single column";
---

<Header />
<main>
	<div class="rvt-section rvt-theme-light">
		<HeroCallout />
	</div>
	<!-- Use a container for visual alignment -->
	<div class="rvt-container">
		<hr aria-hidden="true" class="rvt-m-all-none" />
	</div>
	<div class="rvt-container [ rvt-m-top-md ]">
		<nav role="navigation" aria-label="Breadcrumbs">
			<ol class="rvt-breadcrumbs">
				<li><a href="#">Home</a></li>
				<li><a href="#">Visited page</a></li>
				<li><a href="#">Visited page</a></li>
				<li><a href="#">Visited page</a></li>
				<li aria-current="page">Current page</li>
			</ol>
		</nav>
	</div>
	<div class="rvt-layout-base rvt-layout-base--single-column">
		<div class="rvt-layout-base__main">
			<div class="rvt-stack">
				<DetailsContent />
			</div>
		</div>
	</div>
</main>
<Footer />
