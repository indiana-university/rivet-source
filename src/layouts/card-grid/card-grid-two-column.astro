---
import Billboard from "@src/components/billboard/billboard.astro";
import Callout from "@src/components/callout/callout-demo.astro";
import Card from "@src/components/card/card.astro";
import ContactInfo from "@src/components/contact-info/contact-info-demo.astro";
import Header from "@src/components/header/header.astro";
import ListHub from "@src/components/list-hub/list-hub-demo.astro";
import Footer from "@src/components/footer/footer-demo.astro";
import Sidenav from "@src/components/sidenav/sidenav-demo.astro";
export const title = "Card grid - Two column";
---

<div class="rvt-theme-crimson">
	<Header />
</div>
<main>
	<div class="rvt-section rvt-theme-crimson">
		<Callout />
	</div>
	<div class="rvt-layout-base">
		<div class="rvt-layout-base__sidebar" id="sidebar-main-content">
			<Sidenav />
		</div>
		<div class="rvt-layout-base__main">
			<nav role="navigation" aria-label="Breadcrumbs">
				<ol class="rvt-breadcrumbs">
					<li><a href="#">Home</a></li>
					<li><a href="#">Visited page</a></li>
					<li><a href="#">Visited page</a></li>
					<li><a href="#">Visited page</a></li>
					<li aria-current="page">Current page</li>
				</ol>
			</nav>
			<div class="rvt-stack rvt-m-top-xl">
				<!--
          NOTE: Need to use a square aspect ratio image in the two column version
          due to width/height considerations.
        -->
				<Billboard />
				<Card type="feature" image badge eyebrow content />
				<div class="rvt-rich-text">
					<div>
						<span class="rvt-ts-14 rvt-font-mono">
							Showing X of X Resources
						</span>
						<h2>Optional Category Title (6)</h2>
					</div>
					<p>
						Optional description copy should not exceed one concise paragraph.
					</p>
				</div>
				<ul class="rvt-card-grid [ rvt-m-top-lg ]">
					{
						[...Array(6).keys()].map((i) => (
							<li>
								<div class="rvt-card">
									<div class="rvt-card__image">
										<img
											src={`https://picsum.photos/id/${i * 3}/600/400`}
											alt="Smiling students sitting outside on a bench"
										/>
									</div>
									<div class="rvt-card__body">
										<div class="rvt-card__eyebrow">Campus or category</div>
										<h2 class="rvt-card__title">
											<a href="#">
												This card title should be concise and should not exceed
												78 characters or 3 lines of text
											</a>
										</h2>
										<div class="rvt-card__content">
											<p>
												Minus ducimus sint amet similique, saepe aut natus fuga.
											</p>
										</div>
										<div class="rvt-card__meta">
											<time>Jun 21,2024</time>
										</div>
									</div>
								</div>
							</li>
						))
					}
				</ul>
				<ContactInfo />
				<ListHub />
			</div>
			<!-- end stack -->
		</div>
	</div>
</main>
<Footer />
