---
import Header from "@src/components/header/header-demo.astro";
import HeroProfile from "@src/components/hero/hero-profile.astro";
import Factoid from "@src/components/factoid/factoid.astro";
import Footer from "@src/components/footer/footer-demo.astro";
import ProfileContent from "./profile-content.astro";
export const title = "Profile Layout - Single column";
---

<Header />
<main>
	<div class="rvt-section rvt-theme-light">
		<HeroProfile />
	</div>
	<!-- Use a container for visual alignment -->
	<div class="rvt-section rvt-theme-light rvt-p-bottom-none">
		<div class="rvt-container">
			<Factoid />
		</div>
	</div>
	<div class="rvt-container [ rvt-m-top-md ]">
		<nav role="navigation" aria-label="Breadcrumbs">
			<ol class="rvt-breadcrumbs">
				<li><a href="#">Home</a></li>
				<li><a href="#">Visited page</a></li>
				<li><a href="#">Visited page</a></li>
				<li><a href="#">Visited page</a></li>
				<li aria-current="page">Current page</li>
			</ol>
		</nav>
	</div>
	<div class="rvt-layout-base rvt-layout-base--single-column rvt-theme-light">
		<div class="rvt-layout-base__main">
			<div class="rvt-stack rvt-m-top-lg">
				<ProfileContent />
			</div>
		</div>
	</div>
</main>
<Footer />
