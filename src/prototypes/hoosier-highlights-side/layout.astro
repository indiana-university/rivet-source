---
import Footer from "@src/components/footer/footer.astro";
import Header from "./header.astro";
import { menus as _menus } from "./const.js";
import { getMenus } from "./util.js";

const { Content, data, root = false, title } = Astro.props;
const menus = getMenus(_menus, Astro);
const breadcrumbs = [];
if (data) {
	let { parent } = data;
	while (parent) {
		breadcrumbs.unshift(parent);
		parent = parent.parent;
	}
}
const hideTitle = Astro.slots.has("default") || !!Content;
const childItems = data?.items || menus.current.items;
---

<Header menus={menus} />
<div class="rvt-container">
	<div class="layout-side">
		{!root && (
			<rvt-side-nav>
				<rvt-drilldown>
					{
						menus.all.map((menu: any) => (
							<div
								data-rvt-drilldown-menu={menu.id}
								data-rvt-drilldown-parent={menu.parent?.id}
								hidden={!menu.current}
							>
								<header>
									{menu.parent && !menu.hasCurrent && (
										<div class="rvt-button-group">
											<button
												class="rvt-button rvt-button--medium rvt-button--icon-only"
												data-rvt-drilldown-open="parent"
											>
												<rvt-icon name="chevron-left" />
												<span class="rvt-sr-only">Back</span>
											</button>
										</div>
									)}
									<h2>
										<a href={menu.url}>
											{menu.label}
										</a>
									</h2>
								</header>
								<ul>
									{menu.items.map((item: any) => (
										<li data-rvt-drilldown-child={item.id}>
											<a
												aria-current={item.current ? "page" : null}
												href={item.url || "#"}
											>
												{item.label}
											</a>
											{item.hasChildren && (
												<button
													class="rvt-button rvt-button--medium rvt-button--icon-only"
													data-rvt-drilldown-open="child"
												>
													<span class="rvt-sr-only">{`${item.label} menu`}</span>
													<rvt-icon name="chevron-right" />
												</button>
											)}
										</li>
									))}
								</ul>
							</div>
						))
					}
				</rvt-drilldown>
			</rvt-side-nav>
		)}
		{
			!root && (
				<rvt-breadcrumbs>
					<nav aria-label="Breadcrumbs">
						<ol class="rvt-breadcrumbs">
							{breadcrumbs.map((item, i) => (
								<li>
									<a href={item.url}>
										{i === 0 && <span class="rvt-sr-only">Home</span>}
										{i > 0 && item.label}
									</a>
								</li>
							))}
							<li aria-current="page">{title}</li>
						</ol>
					</nav>
				</rvt-breadcrumbs>
			)
		}
		<main id="main-content">
			{!hideTitle && (
				<div class="rvt-hero">
					<div class="rvt-hero__body">
						<h1 class="rvt-hero__title">Highlights in {title}</h1>
					</div>
				</div>
			)}
			{hideTitle && <h1 class="rvt-sr-only">{title}</h1>}
			{
				data?.articles && (
					<div class="content">
						{data.articles.map((article: any) => (
							<>
								<h2>{article.label}</h2>
								<p>{article.description}</p>
							</>
						))}
					</div>
				)
			}
			<slot />
			{
				childItems && (
					<div>
						<ul class="rvt-card-grid rvt-m-tb-none">
							{childItems.map((item: any) => (
								<li>
									<div class="rvt-card">
										<div class="rvt-card__body">
											<h3 class="rvt-card__title">
												<a href={item.url}>{item.label}</a>
											</h3>
											{item.articles && (
												<div class="rvt-card__content">
													{item.articles.map((article: any) => (
														<p>{article.label}</p>
													))}
												</div>
											)}
										</div>
									</div>
								</li>
							))}
						</ul>
					</div>
				)
			}
		</main>
	</div>
</div>
<Footer />

<style>
	.rvt-container:has(> .layout-side) {
		container-type: inline-size;
	}

	.layout-side {
		--border: var(--rvt-size-1) solid var(--rvt-color-theme-ui);
		--gap: var(--rvt-size-40);

		rvt-side-nav {
			display: none;
		}

		rvt-breadcrumbs {
			padding-block-end: var(--rvt-size-16);
		}

		.rvt-hero {
			margin-block-end: var(--gap);
		}
	}

	@container (width > 45rem) {
		.layout-side:has(rvt-side-nav) {
			display: grid;
			grid-template-columns: 20rem 1fr;
			grid-template-rows: auto 1fr;

			rvt-side-nav {
				border-block-start: var(--border);
				border-inline-end: var(--border);
				display: block;
				grid-column: 1 / 2;
				grid-row: 1 / -1;
				padding-block: var(--gap);
				padding-inline-end: var(--gap);
			}

			&:has(rvt-breadcrumbs) rvt-breadcrumbs,
			&:not(:has(rvt-breadcrumbs)) main {
				border-block-start: var(--border);
				padding-block-start: var(--gap);
			}

			rvt-breadcrumbs {
				grid-column: 2 / 3;
				grid-row: 1 / 2;
				padding-inline-start: var(--gap);
			}

			rvt-drilldown {
				header {
					padding-block-start: 0;
				}
			}

			main {
				grid-column: 2 / 3;
				grid-row: 2 / 3;
				padding-block-end: var(--gap);
				padding-inline-start: var(--gap);
			}
		}
	}

	rvt-related-nav {
		--height: var(--rvt-size-48);
		--padding: var(--rvt-size-12);
		display: block;

		nav {
			border-block: var(--rvt-size-1) solid var(--rvt-color-theme-ui);
			display: flex;
			flex-grow: 1;
			flex-shrink: 0;

			> * {
				margin-block: var(--rvt-size-n1);
			}

			> a:first-child {
				align-items: center;
				display: flex;
				font: var(--rvt-font-18-bold);
				gap: var(--rvt-size-8);

				&::before {
					background-color: currentColor;
					display: block;
					content: "";
					clip-path: path(var(--rvt-icon-arrow-left));
					height: var(--rvt-size-16);
					width: var(--rvt-size-16);
				}
			}
		}

		ul {
			display: flex;
			list-style: "";
			padding: 0;
		}

		a {
			border: var(--rvt-size-1) solid transparent;
			color: inherit;
			display: block;
			font: var(--rvt-font-14);
			padding-block: calc((var(--height) - 1lh - var(--rvt-size-2)) / 2);
			padding-inline: var(--padding);
			scroll-snap-align: start;
			text-decoration: none;

			&:hover {
				color: var(--rvt-color-theme-text-accent);
				text-decoration: underline;
			}

			&[aria-current="page"] {
				background-color: var(--rvt-color-theme-background-strong);
				border-color: var(--rvt-color-theme-ui);
				font-variation-settings: "GRAD" 150;
			}
		}
	}

	rvt-breadcrumbs {
		display: block;

		nav {
			display: flex;
		}
	}

	.rvt-hero {
		padding-inline: 0;
	}

	rvt-main-header {
		display: block;
		container-type: inline-size;
		margin-block-end: var(--rvt-size-32);
		padding-block-end: 0;

		rvt-related-nav {
			display: none;

			&:where(:not(:has(nav > a:first-child))) {
				display: none;
			}

			&:where(:has(nav > a:first-child)) {
				nav {
					border-block-start-color: transparent;
				}

				ul {
					display: none;
				}
			}

			rvt-list-more {
				visibility: hidden;
			}
		}

		@container (width > 40rem) {
			rvt-related-nav {
				display: block;

				nav {
					border-block-start-color: var(--rvt-color-theme-ui);
				}

				ul {
					display: flex;
				}

				rvt-list-more {
					visibility: visible;
				}
			}

			rvt-breadcrumbs {
				margin-block-start: var(--rvt-size-24);
			}
		}
	}

	.content {
		h2 {
			font: var(--rvt-font-20-fluid-black);
			margin-block-start: var(--rvt-size-32);
		}
	}

	.rvt-card-grid {
		--gap: clamp(var(--rvt-size-16), 5vw, var(--rvt-size-40));
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
	}

	main {
		padding-block-end: var(--rvt-size-32);
	}
</style>
