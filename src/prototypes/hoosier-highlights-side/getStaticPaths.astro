---
import Layout from "./layout.astro";
import { menus as _menus, site } from "./const.js";
import { getMenus, getUrl } from "./util.js";

export function getStaticPaths() {
	const menus = getMenus(_menus);
	const files = import.meta.glob(["./*.astro"], { eager: true });
	const contentMap = new Map(Object.entries(files));
	return menus.pages.map((data) => ({
		Content: contentMap.get(`./${data.id}.astro`)?.default,
		data,
		fileType: "prototype",
		page: { default: Layout },
		path: getUrl(data.id, { excludeBase: true }),
		site,
		title: data.label,
		type: "file",
	}));
}
