---
import Header from "@src/components/header/header.astro";
import Subnav from "./subnav.astro";

export const title = "Apply";
---

<Header />
<main>
	<header class="rvt-container">
		<div class="alpha-nav-dense">
			<nav aria-label="Breadcrumbs">
				<ol class="rvt-breadcrumbs">
					<li><a href="home.astro">Home</a></li>
					<li><a href="admissions.astro">Admissions</a></li>
					<li aria-current="page">{title}</li>
				</ol>
			</nav>
			<rvt-alpha-sibling-nav>
				<Subnav>
					<li><a href="apply.astro" aria-current="page">Apply</a></li>
					<li><a href="#">Admissions Paths</a></li>
					<li><a href="#">Admissions Events</a></li>
					<li><a href="#">Visit IU</a></li>
					<li><a href="#">Meet Your Counselors</a></li>
					<li><a href="#">Precollege Programs</a></li>
					<li><a href="#">Planning for IU</a></li>
					<li><a href="#">Class Profile</a></li>
					<li><a href="#">After Admission</a></li>
					<li><a href="#">Admissions Viewbook</a></li>
					<li><a href="#">For Councelors</a></li>
					<li><a href="#">For Families</a></li>
					<li><a href="#">Request Information</a></li>
				</Subnav>
			</rvt-alpha-sibling-nav>
		</div>
		<div class="demo-subsite">
			<a href="admissions.astro">Admissions</a>
			<h1>{title}</h1>
		</div>
		<Subnav>
			<li><a href="freshman-applicants.astro">Freshman Applicants</a></li>
			<li><a href="#">Graduate Applicants</a></li>
			<li><a href="#">Returning Applicants</a></li>
			<li><a href="#">Visiting & Non-degree Applicants</a></li>
			<li><a href="#">Transfer Applicants</a></li>
			<li><a href="#">Application Materials</a></li>
			<li><a href="#">Credits & Transfer</a></li>
			<li><a href="#">Manage Your Application</a></li>
			<li><a href="#">How to Apply</a></li>
		</Subnav>
	</header>
</main>

<style>
	header {
		margin-block-start: var(--rvt-size-16);
	}

	nav {
		margin-block: var(--rvt-size-8);
	}

	h1 {
		font: var(--rvt-font-26-fluid-black);
	}

	.demo-subsite {
		display: flex;
		flex-wrap: wrap;
		gap: 0 var(--rvt-size-32);

		> a {
			color: inherit;
			font: var(--rvt-font-26-fluid-black);
			text-decoration: none;

			&:hover {
				color: var(--rvt-color-theme-text-accent);
				text-decoration: underline;
			}
		}

		> h1 {
			font-weight: var(--rvt-font-weight-normal);
		}
	}

	*:has(> .alpha-nav-dense) {
		container-type: inline-size;

		@container (width > 40rem) {
			.alpha-nav-dense {
				flex-wrap: nowrap;
			}
		}
	}

	.alpha-nav-dense {
		align-items: center;
		border-block-end: var(--rvt-size-1) solid var(--rvt-color-theme-ui);
		display: flex;
		flex-wrap: wrap;
		gap: var(--rvt-size-8) var(--rvt-size-32);
		margin-block-end: var(--rvt-size-32);

		> * {
			margin: 0;
		}

		> nav:first-child {
			flex-shrink: 0;
		}

		.rvt-breadcrumbs {
			font: var(--rvt-font-14);
		}
	}

	rvt-alpha-sibling-nav {
		flex-grow: 1;

		nav {
			margin: 0;
		}

		rvt-alpha-subnav {
			border: none;

			li {
				border: none !important;
			}
		}

		li {
			padding: var(--rvt-size-6) var(--rvt-size-8);
		}

		a {
			font: var(--rvt-font-14);
			padding: 0;

			&[aria-current="page"] {
				color: var(--rvt-color-theme-text-accent);
				font-weight: var(--rvt-font-weight-bold);
				text-decoration: underline;
			}
		}

		[data-subnav-more] {
			border: none;

			button {
				--size-height: var(--rvt-size-32);
			}
		}
	}
</style>
