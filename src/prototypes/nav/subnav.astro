<nav aria-label="Related pages">
	<rvt-alpha-subnav>
		<ul>
			<slot />
		</ul>
		<div data-subnav-more data-trait-escape-close>
			<button
				aria-expanded="false"
				class="rvt-button rvt-button--small rvt-button--subtle"
				data-trait-toggle-expanded
			>
				More
				<rvt-icon name="chevron-down"></rvt-icon>
			</button>
			<ul></ul>
		</div>
	</rvt-alpha-subnav>
</nav>

<style>
	nav {
		margin-block-start: var(--rvt-size-16);
	}

	rvt-alpha-subnav {
		border-block: var(--rvt-size-1) solid var(--rvt-color-theme-ui);
		display: flex;
		justify-content: space-between;
		position: relative;

		ul {
			list-style: "";
			margin: 0;
			padding: 0;
		}

		a {
			color: inherit;
			display: block;
			font: var(--rvt-font-14);
			padding: var(--rvt-size-14) var(--rvt-size-16);
			text-decoration: none;

			&:hover {
				color: var(--rvt-color-theme-text-accent);
				text-decoration: underline;
			}
		}

		> ul {
			display: flex;
			flex-wrap: nowrap;

			> li {
				flex-shrink: 0;

				&:not(:last-child) {
					border-inline-end: var(--rvt-size-1) solid var(--rvt-color-theme-ui);
				}
			}
		}

		[data-subnav-more] {
			border-inline-start: var(--rvt-size-1) solid var(--rvt-color-theme-ui);

			&:has(ul:empty) {
				visibility: hidden;
			}

			&:has(button[aria-expanded="true"]) ul {
				--rvt-trait-auto-focus: true;
				display: block;

				> * {
					--rvt-trait-auto-focus: initial;
				}
			}

			button {
				--padding-inline-extra: var(--rvt-size-2);
				--size-height: var(--rvt-size-48);
			}

			ul {
				box-shadow: var(--rvt-shadow-base);
				display: none;
				margin-block-start: var(--rvt-size-8);
				padding-block: var(--rvt-size-8);
				position: absolute;
				right: 0;
				width: max-content;
			}

			a {
				padding-block: var(--rvt-size-8);
			}
		}
	}
</style>

<script>
	const root: HTMLElement = document.querySelector("rvt-alpha-subnav");
	const navList: HTMLElement = root.querySelector(":scope > ul");
	const navItems = navList.querySelectorAll(":scope > li");
	const moreContainer: HTMLElement = root.querySelector("[data-subnav-more]");
	const moreButton: HTMLElement = moreContainer.querySelector(":scope > button");
	const moreList = moreContainer.querySelector(":scope > ul");
	
	const items = Array.from(navItems)
		.map((el: HTMLElement) => ({
			el,
			width: el.offsetWidth
		}));

	const resizer = new ResizeObserver(() => {
		let availableWidth = root.offsetWidth - moreButton.offsetWidth;
		let usedWidth = 0;

		items.forEach((item) => {
			usedWidth += item.width;

			if (usedWidth > availableWidth) {
				moreList.appendChild(item.el);
			} else {
				navList.appendChild(item.el);
			}
		});
	});
	resizer.observe(root);
</script>
