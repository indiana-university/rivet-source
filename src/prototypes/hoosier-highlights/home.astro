---
import Layout from "./layout.astro";
import { getUrl } from "./util.js";

export { site } from "./const.js";
export const root = true;
export const title = "Home";
---

<Layout root={root} title={title}>
	<div class="rvt-hero rvt-hero--statement">
		<div class="rvt-hero__body">
			<h2 class="rvt-hero__title">Dig into history</h2>
			<p class="rvt-hero__teaser">
				Discover major milestones and events over Indiana University's 200-year legacy. Be inspired and make your mark for the next generation of Hoosiers.
			</p>
		</div>
	</div>
</Layout>
