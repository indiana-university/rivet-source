---
import Layout from "./layout.astro";
import { url } from "./util.js";

export const title = "Apply";
---

<Layout showTitle={false} title={title}>
	<Fragment slot="parent">
		<a href={url("admissions")}> Admissions </a>
	</Fragment>
	<Fragment slot="siblings">
		<li><a href={url("apply")} aria-current="page">Apply</a></li>
		<li><a href={url("admissions-paths")}>Admissions Paths</a></li>
		<li><a href="#">Admissions Events</a></li>
		<li><a href="#">Visit IU</a></li>
		<li><a href="#">Meet Your Counselors</a></li>
		<li><a href="#">Precollege Programs</a></li>
		<li><a href="#">Planning for IU</a></li>
		<li><a href="#">Class Profile</a></li>
		<li><a href="#">After Admission</a></li>
		<li><a href="#">Admissions Viewbook</a></li>
		<li><a href="#">For Councelors</a></li>
		<li><a href="#">For Families</a></li>
		<li><a href="#">Request Information</a></li>
	</Fragment>
	<Fragment slot="breadcrumbs">
		<li><a href={url("admissions")}>Admissions</a></li>
	</Fragment>
	<Fragment slot="hero">
		<div class="rvt-hero">
			<div class="rvt-hero__body">
				<h2 class="rvt-hero__title">Your journey starts here</h2>
				<p class="rvt-hero__teaser">
					Whether you're just starting your application or have questions about
					the process, we're ready to help you find your way home to IU.
				</p>
			</div>
		</div>
	</Fragment>
	<Fragment slot="content">
		<h3>Which best describes you?</h3>
		<ul class="rvt-card-grid">
			<li>
				<div class="rvt-card rvt-card--feature">
					<div class="rvt-card__sticker">
						<rvt-sticker name="person" theme="crimson" size="sm"> </rvt-sticker>
					</div>
					<div class="rvt-card__body">
						<h4 class="rvt-card__title">
							<a href={url("freshman-applicants")}>Freshman applicant</a>
						</h4>
						<div class="rvt-card__content">
							<p>
								You're a first-time college student ready to join our traditions
								and build your legacy from day one.
							</p>
						</div>
					</div>
				</div>
			</li>
			<li>
				<div class="rvt-card rvt-card--feature">
					<div class="rvt-card__sticker">
						<rvt-sticker name="arrows-right-left" theme="crimson" size="sm">
						</rvt-sticker>
					</div>
					<div class="rvt-card__body">
						<h4 class="rvt-card__title">
							<a href="#">Transfer applicant</a>
						</h4>
						<div class="rvt-card__content">
							<p>
								You've started your journey elsewhere and are ready to bring
								your experience to the campus where you belong.
							</p>
						</div>
					</div>
				</div>
			</li>
			<li>
				<div class="rvt-card rvt-card--feature">
					<div class="rvt-card__sticker">
						<rvt-sticker name="cap" theme="crimson" size="sm"> </rvt-sticker>
					</div>
					<div class="rvt-card__body">
						<h4 class="rvt-card__title">
							<a href={url("graduate-applicants")}>Graduate applicant</a>
						</h4>
						<div class="rvt-card__content">
							<p>
								You're a scholar or professional seeking world-class mentorship
								to lead your field and advance your expertise.
							</p>
						</div>
					</div>
				</div>
			</li>
		</ul>
	</Fragment>
	<Fragment slot="children">
		<ul>
			<li>
				<a href={url("freshman-applicants")}>Freshman Applicants</a>
			</li>
			<li>
				<a href="#">Graduate Applicants</a>
			</li>
			<li>
				<a href="#">Returning Applicants</a>
			</li>
			<li>
				<a href="#">Visiting & Non-degree Applicants</a>
			</li>
			<li>
				<a href="#">Transfer Applicants</a>
			</li>
			<li>
				<a href="#">Application Materials</a>
			</li>
			<li>
				<a href="#">Credits & Transfer</a>
			</li>
			<li>
				<a href="#">Manage Your Application</a>
			</li>
			<li>
				<a href="#">How to Apply</a>
			</li>
		</ul>
	</Fragment>
</Layout>

<style>
	h3 {
		color: var(--rvt-color-theme-text-accent);
		font: var(--rvt-font-26-fluid-black);
	}
</style>
