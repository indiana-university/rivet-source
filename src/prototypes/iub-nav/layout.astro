---
import Header from "./header.astro";
import ListMore from "./list-more.astro";

const { title, showTitle = true, showBreadcrumbs = true } = Astro.props;
---

<Header />
<main>
	<rvt-main-header>
		<header class="rvt-container">
			<rvt-related-nav>
				<nav aria-label="Related pages">
					<slot name="parent" />
					<ListMore>
						<slot name="siblings" />
					</ListMore>
				</nav>
			</rvt-related-nav>
			{showBreadcrumbs && (
				<rvt-breadcrumbs>
					<nav aria-label="Breadcrumbs">
						<ol class="rvt-breadcrumbs">
							<li>
								<a href="home.astro">
									<span class="rvt-sr-only">Home</span>
								</a>
							</li>
							<slot name="breadcrumbs" />
							<li aria-current="page">{title}</li>
						</ol>
					</nav>
				</rvt-breadcrumbs>
			)}
			{showTitle && <h1>{title}</h1>}
			{!showTitle && <h1 class="rvt-sr-only">{title}</h1>}
		</header>
	</rvt-main-header>
	<div class="rvt-container">
		<slot name="content" />
	</div>
</main>

<style is:global>
	rvt-main-header {
		display: block;
		container-type: inline-size;

		rvt-related-nav {
			&:where(:not(:has(nav > a:first-child))) {
				display: none;
			}

			rvt-list-more {
				visibility: hidden;
			}
		}

		rvt-breadcrumbs {
			display: none;
			margin-block-start: var(--rvt-size-24);
		}

		h1 {
			font: var(--rvt-font-26-fluid-black);
			margin-block-start: var(--rvt-size-24);
		}

		@container (width > 40rem) {
			rvt-related-nav {
				border-block-end: var(--rvt-size-1) solid var(--rvt-color-theme-ui);
				display: block;

				rvt-list-more {
					visibility: visible;
				}
			}

			rvt-breadcrumbs {
				display: block;
			}
		}
	}

	rvt-related-nav {
		display: block;
		padding-block: var(--rvt-size-16);

		nav {
			align-items: center;
			display: flex;
			gap: var(--rvt-size-24);

			> a:first-child {
				align-items: center;
				display: flex;
				font: var(--rvt-font-18-bold);
				gap: var(--rvt-size-8);
				padding: 0;

				&::before {
					background-color: currentColor;
					display: block;
					content: "";
					clip-path: path(var(--rvt-icon-arrow-left));
					height: var(--rvt-size-16);
					width: var(--rvt-size-16);
				}
			}
		}

		a {
			color: inherit;
			display: block;
			font: var(--rvt-font-14);
			padding-block: var(--rvt-size-2);
			text-decoration: none;

			&:hover {
				color: var(--rvt-color-theme-text-accent);
				text-decoration: underline;
			}

			&[aria-current="page"] {
				color: var(--rvt-color-theme-text-accent);
				font-variation-settings: "GRAD" 150;
				text-decoration: underline;
				text-decoration-thickness: var(--rvt-size-2);
				text-underline-offset: var(--rvt-size-6);
			}
		}

		ul {
			list-style: "";
			margin: 0;
			padding: 0;
		}

		rvt-list-more {
			> ul {
				display: flex;
				flex-wrap: nowrap;
				_gap: var(--rvt-size-24);

				> li {
					flex-shrink: 0;
					padding-inline-end: var(--rvt-size-24);
				}
			}
		}
	}
</style>
