---
import Header from "./header.astro";
import ScrollSnap from "./scroll-snap.astro";
import { url } from "./util.js";

const {
	headerTheme = "light",
	showTitle = true,
	showBreadcrumbs = true,
	title,
} = Astro.props;
const themeClass = `rvt-theme-${headerTheme}`;
---

<Header theme={headerTheme} />
<main>
	<rvt-main-header class={themeClass}>
		<header class="rvt-container">
			<rvt-related-nav>
				<ScrollSnap>
					<nav aria-label="Related pages">
						<slot name="parent" />
						<ul>
							<slot name="siblings" />
						</ul>
					</nav>
				</ScrollSnap>
			</rvt-related-nav>
			{showBreadcrumbs && (
				<rvt-breadcrumbs>
					<nav aria-label="Breadcrumbs">
						<ol class="rvt-breadcrumbs">
							<li>
								<a href={url("home")}>
									<span class="rvt-sr-only">Home</span>
								</a>
							</li>
							<slot name="breadcrumbs" />
							<li aria-current="page">{title}</li>
						</ol>
					</nav>
				</rvt-breadcrumbs>
			)}
			{showTitle && <h1>{title}</h1>}
			{!showTitle && <h1 class="rvt-sr-only">{title}</h1>}
		</header>
	</rvt-main-header>
	{Astro.slots.has("hero") && (
		<div class:list={["rvt-section", themeClass]}>
			<slot name="hero" />
		</div>
	)}
	{Astro.slots.has("content") && (
		<div class="rvt-container rvt-section">
			<slot name="content" />
		</div>
	)}
	{Astro.slots.has("children") && (
		<div class="rvt-container rvt-section">
			<slot name="children" />
		</div>
	)}
</main>

<style is:global>
	rvt-header > header {
		padding-block: var(--rvt-size-24);
	}

	rvt-main-header {
		display: block;
		container-type: inline-size;

		rvt-related-nav {
			display: none;
			margin-block-end: var(--rvt-size-24);

			&:where(:not(:has(nav > a:first-child))) {
				display: none;
			}

			&:where(:has(nav > a:first-child)) {
				nav {
					border-block-start-color: transparent;
				}

				ul {
					display: none;
				}
			}

			rvt-list-more {
				visibility: hidden;
			}
		}

		rvt-breadcrumbs {
			_display: none;
			_margin-block-start: var(--rvt-size-24);
		}

		h1 {
			font: var(--rvt-font-26-fluid-black);
			margin-block-start: var(--rvt-size-24);
		}

		@container (width > 40rem) {
			rvt-related-nav {
				display: block;

				nav {
					border-block-start-color: var(--rvt-color-theme-ui);
				}

				ul {
					display: flex;
				}

				rvt-list-more {
					visibility: visible;
				}
			}

			rvt-breadcrumbs {
				_display: block;
			}
		}
	}

	rvt-related-nav {
		--height: var(--rvt-size-48);
		--padding: var(--rvt-size-12);
		display: block;

		nav {
			border-block: var(--rvt-size-1) solid var(--rvt-color-theme-ui);
			display: flex;
			flex-grow: 1;
			flex-shrink: 0;

			> * {
				margin-block: var(--rvt-size-n1);
			}

			> a:first-child {
				align-items: center;
				display: flex;
				font: var(--rvt-font-18-bold);
				gap: var(--rvt-size-8);

				&::before {
					background-color: currentColor;
					display: block;
					content: "";
					clip-path: path(var(--rvt-icon-arrow-left));
					height: var(--rvt-size-16);
					width: var(--rvt-size-16);
				}
			}
		}

		ul {
			display: flex;
			list-style: "";
			padding: 0;
		}

		a {
			border: var(--rvt-size-1) solid transparent;
			color: inherit;
			display: block;
			font: var(--rvt-font-14);
			padding-block: calc((var(--height) - 1lh - var(--rvt-size-2)) / 2);
			padding-inline: var(--padding);
			scroll-snap-align: start;
			text-decoration: none;

			&:hover {
				color: var(--rvt-color-theme-text-accent);
				text-decoration: underline;
			}

			&[aria-current="page"] {
				background-color: var(--rvt-color-theme-background-strong);
				border-color: var(--rvt-color-theme-ui);
				font-variation-settings: "GRAD" 150;
			}
		}
	}
</style>
