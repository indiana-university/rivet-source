---
import Header from "./header.astro";
import ListMore from "./list-more.astro";

const { title, showTitle = true, showBreadcrumbs = true } = Astro.props;
---

<Header />
<main>
	<header class="rvt-container">
		<rvt-main-header>
			<nav>
				<slot name="parent" />
				<ListMore>
					<slot name="siblings" />
				</ListMore>
			</nav>
		</rvt-main-header>
		{showBreadcrumbs && (
			<rvt-breadcrumbs>
				<nav aria-label="Breadcrumbs">
					<ol class="rvt-breadcrumbs">
						<slot name="breadcrumbs" />
						<li aria-current="page">{title}</li>
					</ol>
				</nav>
			</rvt-breadcrumbs>
		)}
		{showTitle && <h1>{title}</h1>}
		{!showTitle && <h1 class="rvt-sr-only">{title}</h1>}
	</header>
	<div class="rvt-container">
		<slot name="content" />
	</div>
</main>

<style>
	rvt-main-header {
		border-block-end: var(--rvt-size-1) solid var(--rvt-color-theme-ui);
		display: block;
		padding-block: var(--rvt-size-16);

		nav {
			align-items: center;
			display: flex;
			gap: var(--rvt-size-24);

			> a:first-child {
				align-items: center;
				display: flex;
				font: var(--rvt-font-18-bold);
				gap: var(--rvt-size-8);
				padding: 0;

				&::before {
					background-color: currentColor;
					display: block;
					content: "";
					clip-path: path(var(--rvt-icon-arrow-left));
					height: var(--rvt-size-16);
					width: var(--rvt-size-16);
				}
			}
		}

		a {
			color: inherit;
			display: block;
			font: var(--rvt-font-16);
			_padding-block: var(--rvt-size-2);
			text-decoration: none;

			&:hover {
				color: var(--rvt-color-theme-text-accent);
				text-decoration: underline;
			}

			&[aria-current="page"] {
				color: var(--rvt-color-theme-text-accent);
				font: var(--rvt-font-16-bold);
				text-decoration: underline;
			}
		}

		ul {
			list-style: "";
			margin: 0;
			padding: 0;
		}

		rvt-list-more {
			> ul {
				display: flex;
				flex-wrap: nowrap;
				_gap: var(--rvt-size-24);

				> li {
					flex-shrink: 0;
					padding-inline-end: var(--rvt-size-24);
				}
			}
		}
	}

	rvt-breadcrumbs {
		display: block;
		margin-block-start: var(--rvt-size-24);
	}

	h1 {
		font: var(--rvt-font-26-fluid-black);
		margin-block-start: var(--rvt-size-24);
	}
</style>
