---
import Layout from "./layout.astro";
import { url } from "./util.js";

export const root = true;
export { site } from "./const.js";
export const title = "Home";
---

<Layout
	headerTheme="light"
	showTitle={false}
	showBreadcrumbs={false}
	title={title}
>
	<Fragment slot="siblings">
		<li><a href="#">Academics</a></li>
		<li><a href={url("admissions")}>Admissions</a></li>
		<li><a href={url("cost-aid")}>Cost & Aid</a></li>
		<li><a href="#">Campus Life</a></li>
		<li><a href="#">Support & Services</a></li>
		<li><a href="#">Research</a></li>
		<li><a href="#">About IU</a></li>
		<li><a href="#">Alumni & Giving</a></li>
	</Fragment>
	<Fragment slot="hero">
		<div class="rvt-hero rvt-hero--statement">
			<div class="rvt-hero__body">
				<h2 class="rvt-hero__title">Welcome home</h2>
				<p class="rvt-hero__teaser">
					Indiana University is more than a campus &mdash; it's a community that
					feels like family and a global stage for your ambition. Surround
					yourself with mentors who invest in your future and a landscape
					designed to inspire.
				</p>
				<div class="rvt-hero__actions">
					<a
						href={url("apply")}
						class="rvt-button rvt-button--cta rvt-button--strong"
					>
						Apply to Bloomington
					</a>
					<a href={url("home")} class="rvt-button rvt-button--cta">
						Explore degree programs
					</a>
				</div>
			</div>
			<figure class="rvt-hero__figure">
				<div class="rvt-hero__images">
					<img
						src="https://raw.githubusercontent.com/basham/rivet-assets/refs/heads/main/images/hero-01-students-imu.webp"
						alt="Three students joke outside the Indiana Memorial Union while enjoying coffees."
					/>
				</div>
			</figure>
		</div>
	</Fragment>
</Layout>
