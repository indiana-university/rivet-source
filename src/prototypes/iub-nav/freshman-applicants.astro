---
import Layout from "./layout.astro";
import { url } from "./util.js";

export { site } from "./const.js";
export const title = "Freshman Applicants";
---

<Layout showTitle={false} title={title}>
	<Fragment slot="breadcrumbs">
		<li><a href={url("admissions")}>Admissions</a></li>
		<li><a href={url("apply")}>Apply</a></li>
	</Fragment>
	<Fragment slot="hero">
		<div class="rvt-hero">
			<div class="rvt-hero__body">
				<h2 class="rvt-hero__title">
					The application process for future freshmen
				</h2>
				<p class="rvt-hero__teaser">
					How to apply to Indiana University, in a few easy steps.
				</p>
				<div class="rvt-hero__actions">
					<a href="#" class="rvt-button rvt-button--cta rvt-button--strong">
						See steps to apply
					</a>
					<a href={url("apply")} class="rvt-button rvt-button--cta">
						Apply now
					</a>
				</div>
			</div>
		</div>
	</Fragment>
</Layout>
