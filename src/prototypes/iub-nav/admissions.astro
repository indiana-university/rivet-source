---
import Layout from "./layout.astro";

export const title = "Admissions";
---

<Layout showTitle={false} title={title}>
	<Fragment slot="siblings">
		<li><a href="#">Academics</a></li>
		<li><a href="admissions.astro" aria-current="page">Admissions</a></li>
		<li><a href="cost-aid.astro">Cost & Aid</a></li>
		<li><a href="#">Campus Life</a></li>
		<li><a href="#">Support & Services</a></li>
		<li><a href="#">Research</a></li>
		<li><a href="#">About IU</a></li>
		<li><a href="#">Alumni & Giving</a></li>
		<li><a href="#">Required Disclosures</a></li>
	</Fragment>
	<Fragment slot="content">
		<div class="rvt-hero rvt-hero--feature">
			<div class="rvt-hero__body">
				<h2 class="rvt-hero__title">Lead the way</h2>
				<p class="rvt-hero__teaser">
					Applying to IU is more than a step &mdash; it's the start of your best chapter. Work with world-class mentors, intern with industry leaders, and join a community that bleeds cream and crimson.
				</p>
				<div class="rvt-hero__actions">
					<a href="apply.astro" class="rvt-button rvt-button--cta rvt-button--strong">
						Apply now
					</a>
					<a href="#" class="rvt-button rvt-button--cta">
						Visit campus
					</a>
				</div>
			</div>
			<figure class="rvt-hero__figure">
				<div class="rvt-hero__images">
					<img
						src="https://raw.githubusercontent.com/basham/rivet-assets/refs/heads/main/images/hero-02-student-graduating.webp"
						alt="Student is dressed for the graduation ceremony, wearing a black academic gown, crimson hood, and black cap with tassel. The tassel is positioned on the left side, signifying they have just graduated."
					/>
				</div>
			</figure>
			<div class="rvt-hero__list-hub">
				<div class="rvt-list-hub">
					<h2 class="rvt-list-hub__title">Quick links</h2>
					<ul class="rvt-list-hub__list">
						<li class="rvt-list-hub__item">
							<a class="rvt-list-hub__link" href="admissions-paths.astro">
								Explore admissions paths
							</a>
						</li>
						<li class="rvt-list-hub__item">
							<a class="rvt-list-hub__link" href="#">
								Meet admissions counselors
							</a>
						</li>
						<li class="rvt-list-hub__item">
							<a class="rvt-list-hub__link" href="#">
								See class profile
							</a>
						</li>
						<li class="rvt-list-hub__item">
							<a class="rvt-list-hub__link" href="#">
								Plan for IU
							</a>
						</li>
						<li class="rvt-list-hub__item">
							<a class="rvt-list-hub__link" href="#">
								Request more info
							</a>
						</li>
					</ul>
				</div>
			</div>
		</div>
		<div class="rvt-container rvt-section">
			<hr>
			<ul>
				<li><a href="apply.astro">Apply</a></li>
				<li><a href="admissions-paths.astro">Admissions Paths</a></li>
				<li><a href="#">Admissions Events</a></li>
				<li><a href="#">Visit IU</a></li>
				<li><a href="#">Meet Your Counselors</a></li>
				<li><a href="#">Precollege Programs</a></li>
				<li><a href="#">Planning for IU</a></li>
				<li><a href="#">Class Profile</a></li>
				<li><a href="#">After Admission</a></li>
				<li><a href="#">Admissions Viewbook</a></li>
				<li><a href="#">For Councelors</a></li>
				<li><a href="#">For Families</a></li>
				<li><a href="#">Request Information</a></li>
			</ul>
		</div>
	</Fragment>
</Layout>
