---
import { createId } from "@src/utilities/createId.js";
import { removeEnd } from "@src/utilities/removeEnd.js";
import { url } from "./util.js";

const ids = {
	main: createId(),
	admissions: createId(),
	apply: createId(),
	costAid: createId(),
};
const mainMenu = {
	id: ids.main,
	label: "IU Bloomington",
	parent: null,
	url: url("home"),
	items: [
		["Academics"],
		["Admissions", url("admissions"), ids.admissions],
		["Cost & Aid", url("cost-aid")],
		["Campus Life"],
		["Support & Services"],
		["Research"],
		["About IU"],
		["Alumni & Giving"],
		["Required Disclosures"],
	],
};
const admissionsMenu = {
	id: ids.admissions,
	label: "Admissions",
	parent: ids.main,
	url: url("admissions"),
	items: [
		["Apply", url("apply"), ids.apply],
		["Admissions Paths", url("admissions-paths")],
		["Admissions Events"],
		["Visit IU"],
		["Meet Your Counselors"],
		["Precollege Programs"],
		["Planning for IU"],
		["Class Profile"],
		["After Admission"],
		["Admissions Viewbook"],
		["For Counselors"],
		["For Families"],
		["Request Information"],
	],
};
const applyMenu = {
	id: ids.apply,
	label: "Apply",
	parent: ids.admissions,
	url: url("apply"),
	items: [
		["Freshman Applicants", url("freshman-applicants")],
		["Graduate Applicants", url("graduate-applicants")],
		["Returning Applicants"],
		["Visiting & Non-degree Applicants"],
		["Transfer Applicants"],
		["Application Materials"],
		["Credits & Transfer"],
		["Manage Your Application"],
		["How to Apply"],
	],
};
const costAidMenu = {
	id: ids.costAid,
	label: "Cost & Aid",
	parent: ids.main,
	url: url("cost-aid"),
	items: [
		["Cost of Attendance"],
		["Financial Aid"],
		["Scholarships"],
		["Grants & Fellowships"],
		["Loans"],
		["Pay Your Bill"],
	],
};
const menus = [mainMenu, admissionsMenu, applyMenu, costAidMenu].map((menu) => {
	const items = menu.items.map((item) => {
		const [label, url, child] = item;
		return { label, url, child };
	});
	return {
		...menu,
		items,
	};
});

const currentPage = removeEnd(Astro.url.pathname, "/");
const currentMenu = menus.find((menu) =>
	menu.items.some((item) => item[1] === currentPage),
);
---

<nav data-menu-main={ids.main}>
	{
		menus.map((menu) => (
			<div data-menu={menu.id} data-menu-parent={menu.parent}>
				<header>
					{menu.parent && (
						<div class="rvt-button-group">
							{menu.id !== ids.main && menu.parent !== ids.main && (
								<button
									class="rvt-button rvt-button--medium"
									data-open-menu="main"
								>
									<rvt-icon name="chevrons-left" />
									Main
								</button>
							)}
							<button
								class="rvt-button rvt-button--medium"
								data-open-menu="parent"
							>
								<rvt-icon name="chevron-left" />
								Back
							</button>
						</div>
					)}

					<h2>
						<a href={menu.url}>{menu.label}</a>
					</h2>
					{false && menu !== currentMenu && currentMenu && (
						<button data-open-menu={currentMenu.id}>
							<rvt-icon name="arrow-anchor-down-right" />
							<span>Current page</span>
						</button>
					)}
				</header>
				<ul>
					{menu.items.map((item) => (
						<li data-menu-child={item.child}>
							<a
								aria-current={item.url === currentPage ? "page" : null}
								href={item.url || "#"}
							>
								{item.label}
							</a>
							{item.child && (
								<button
									class="rvt-button rvt-button--medium rvt-button--icon-only"
									data-open-menu="child"
								>
									<span class="rvt-sr-only">{`${item.label} menu`}</span>
									<rvt-icon name="chevron-right" />
								</button>
							)}
						</li>
					))}
				</ul>
			</div>
		))
	}
</nav>

<style>
	nav {
		button {
			--color-border: var(--rvt-color-theme-ui);
			--color-border-hover: var(--rvt-color-theme-ui);
			--color-text-hover: var(--rvt-color-theme-text-accent);
		}

		header {
			h2 {
				&:not(:first-child) {
					margin-block-start: var(--rvt-size-24);
				}

				a {
					font: var(--rvt-font-20-bold);
					margin: 0;
					padding-inline: 0;
				}
			}
		}

		ul {
			border-block-end: var(--rvt-size-1) solid var(--rvt-color-theme-ui);
			margin-block-start: var(--rvt-size-8);
		}

		li {
			display: flex;
			gap: var(--rvt-size-8);
			padding: var(--rvt-size-8);

			a {
				flex-grow: 1;
				margin: 0;
			}

			&:has([aria-current="page"]) {
				background-color: var(--rvt-color-theme-background-strong);

				a {
					color: inherit;
					font: var(--rvt-font-16);
					font-variation-settings: "GRAD" 150;

					&:hover {
						color: var(--rvt-color-theme-text-accent);
					}
				}
			}
		}
	}
</style>

<script>
	const prefix = "data-menu";

	function isNotHTML(element) {
		return !(element instanceof HTMLElement);
	}

	function openMenu(menuElement) {
		if (isNotHTML(menuElement)) {
			return;
		}
		document.querySelectorAll(`[${prefix}]`).forEach((el) => {
			if (isNotHTML(el)) {
				return;
			}
			el.hidden = el !== menuElement;
		});
		window.requestAnimationFrame(() => {
			const firstLink = menuElement.querySelector("ul a");
			if (isNotHTML(firstLink)) {
				return;
			}
			firstLink.focus();
		});
	}

	function triggerMenuButton(button) {
		if (isNotHTML(button)) {
			return;
		}
		const type = button.dataset.openMenu;
		const attribute = `${prefix}-${type}`;
		const source = button.closest(`[${attribute}]`);
		const id = source.getAttribute(attribute);
		const menu = document.querySelector(`[${prefix}=${id}]`);
		openMenu(menu);
	}

	document.addEventListener("click", (event) => {
		if (isNotHTML(event.target)) {
			return;
		}
		const button = event.target.closest("[data-open-menu]");
		triggerMenuButton(button);
	});

	document.addEventListener(
		"keydown",
		(event) => {
			if (event.key !== "Escape") {
				return;
			}
			if (isNotHTML(event.target)) {
				return;
			}
			const type = event.shiftKey ? "main" : "parent";
			const attribute = `${prefix}-${type}`;
			const source = event.target.closest(`[${attribute}]`);
			if (isNotHTML(source)) {
				return;
			}
			const id = source.getAttribute(attribute);
			const menu = document.querySelector(`[${prefix}=${id}]`);
			openMenu(menu);
			event.stopPropagation();
		},
		{ capture: true },
	);

	function openCurrentMenu() {
		const currentMenu = document.querySelector(
			`[${prefix}]:has([aria-current=page])`,
		);
		const firstMenu = document.querySelector(`[${prefix}]`);
		openMenu(currentMenu || firstMenu);
	}

	openCurrentMenu();
</script>
