---
import { createId } from "@src/utilities/createId.js";

const ids = {
	main: createId(),
	admissions: createId(),
	apply: createId(),
	costAid: createId(),
};
const mainMenu = {
	id: ids.main,
	label: "IU Bloomington",
	parent: null,
	url: "home.astro",
	items: [
		["Academics"],
		["Admissions", "admissions.astro", ids.admissions],
		["Cost & Aid", "cost-aid.astro"],
		["Campus Life"],
		["Support & Services"],
		["Research"],
		["About IU"],
		["Alumni & Giving"],
		["Required Disclosures"],
	]
};
const admissionsMenu = {
	id: ids.admissions,
	label: "Admissions",
	parent: ids.main,
	url: "admissions.astro",
	items: [
		["Apply", "apply.astro", ids.apply],
		["Admissions Paths", "admissions-paths.astro"],
		["Admissions Events"],
		["Visit IU"],
		["Meet Your Counselors"],
		["Precollege Programs"],
		["Planning for IU"],
		["Class Profile"],
		["After Admission"],
		["Admissions Viewbook"],
		["For Counselors"],
		["For Families"],
		["Request Information"],
	]
};
const applyMenu = {
	id: ids.apply,
	label: "Apply",
	parent: ids.admissions,
	url: "apply.astro",
	items: [
		["Freshman Applicants", "freshman-applicants.astro"],
		["Graduate Applicants", "graduate-applicants.astro"],
		["Returning Applicants"],
		["Visiting & Non-degree Applicants"],
		["Transfer Applicants"],
		["Application Materials"],
		["Credits & Transfer"],
		["Manage Your Application"],
		["How to Apply"],
	]
};
const costAidMenu = {
	id: ids.costAid,
	label: "Cost & Aid",
	parent: ids.main,
	url: "cost-aid.astro",
	items: [
		["Cost of Attendance"],
		["Financial Aid"],
		["Scholarships"],
		["Grants & Fellowships"],
		["Loans"],
		["Pay Your Bill"],
	]
};
const menus = [
	mainMenu,
	admissionsMenu,
	applyMenu,
	costAidMenu,
].map((menu) => {
	const items = menu.items.map((item) => {
		const [label, url, child] = item;
		return { label, url, child };
	})
	return {
		...menu,
		items
	};
});

const currentPage = Astro.params.path.split("/").pop();
const currentMenu = menus
	.find((menu) => menu.items.some((item) => item[1] === currentPage));
---

<nav>
	{menus.map((menu) => (
		<div data-menu={menu.id}>
			<header>
				{menu.parent && (
					<div class="rvt-button-group">
						{menu.id !== ids.main && menu.parent !== ids.main && (
							<button class="rvt-button rvt-button--medium" data-open-menu={ids.main}>
								<rvt-icon name="chevrons-left"></rvt-icon>
								Main
							</button>
						)}
						<button class="rvt-button rvt-button--medium" data-open-menu={menu.parent}>
							<rvt-icon name="chevron-left"></rvt-icon>
							Back
						</button>
					</div>
				)}

				<h2>
					{menu.label}
				</h2>
				{false && menu !== currentMenu && currentMenu && (
					<button data-open-menu={currentMenu.id}>
						<rvt-icon name="arrow-anchor-down-right"></rvt-icon>
						<span>Current page</span>
					</button>
				)}
			</header>
			<ul>
				<li>
					<a href={menu.url}>
						{menu.parent ? `Explore ${menu.label}` : "Home"}
					</a>
				</li>
				{menu.items.map((item) => (
					<li>
						<a
							aria-current={item.url === currentPage ? "page" : null}
							href={item.url || "#"}
						>
							{item.label}
						</a>
						{item.child && (
							<button
								class="rvt-button rvt-button--medium rvt-button--icon-only"
								data-open-menu={item.child}
							>
								<span class="rvt-sr-only">{`${item.label} menu`}</span>
								<rvt-icon name="chevron-right"></rvt-icon>
							</button>
						)}
					</li>
				))}
			</ul>
		</div>
	))}
</nav>

<style>
	nav {
		button {
			--color-border: var(--rvt-color-theme-ui);
			--color-border-hover: var(--rvt-color-theme-ui);
			--color-text-hover: var(--rvt-color-theme-text-accent);
		}

		header {
			h2 {
				font: var(--rvt-font-20-bold);

				&:not(:first-child) {
					margin-block-start: var(--rvt-size-24);
				}
			}
		}

		ul {
			border-block-end: var(--rvt-size-1) solid var(--rvt-color-theme-ui);
			margin-block-start: var(--rvt-size-8);
		}

		li {
			display: flex;
			gap: var(--rvt-size-8);
			padding: var(--rvt-size-8);

			a {
				flex-grow: 1;
				margin: 0;
			}

			&:has([aria-current="page"]) {
				background-color: var(--rvt-color-theme-background-strong);

				a {
					color: inherit;
					font: var(--rvt-font-16);
					font-variation-settings: "GRAD" 150;

					&:hover {
						color: var(--rvt-color-theme-text-accent);
					}
				}
			}
		}
	}
</style>

<script>
	function openMenu(menuElement) {
		document.querySelectorAll("[data-menu]").forEach((el) => {
			if (!(el instanceof HTMLElement)) {
				return;
			}
			el.hidden = el !== menuElement;
		});
		window.requestAnimationFrame(() => {
			menuElement.querySelector("ul a")?.focus();
		});
	}

	function triggerMenuButton(button) {
		if (!(button instanceof HTMLElement)) {
			return;
		}
		const selector = `[data-menu=${button.dataset.openMenu}]`;
		const menuElement = document.querySelector(selector);
		openMenu(menuElement);
	}

	document.addEventListener("click", (event) => {
		if (!(event.target instanceof HTMLElement)) {
			return;
		}
		const button = event.target.closest("[data-open-menu]");
		triggerMenuButton(button);
	});

	function openCurrentMenu() {
		const currentMenu = document.querySelector("[data-menu]:has([aria-current=page])");
		const firstMenu = document.querySelector("[data-menu]");
		openMenu(currentMenu || firstMenu);
	}

	openCurrentMenu();

	document.addEventListener("keydown", (event) => {
		if (event.key !== "Escape") {
			return;
		}
		if (!(event.target instanceof HTMLElement)) {
			return;
		}
		const menu = event.target.closest("[data-menu]");
		if (!menu) {
			return;
		}
		const button = menu.querySelector(":scope > div > [data-open-menu]");
		triggerMenuButton(button);
		event.preventDefault();
	}, { capture: true });
</script>
