{
	"source": ["src/tokens/**/*.json"],
	"platforms": {
		"scss": {
			"transformGroup": "scss",
			"files": [
				{
					"destination": "src/base/tokens.scss",
					"format": "scss/map-deep"
				}
			]
		},
		"css": {
			"transformGroup": "css",
			"prefix": "rvt",
			"files": [
				{
					"destination": "src/base/tokens.css",
					"format": "css/variables"
				}
			]
		},
		"json": {
			"transformGroup": "js",
			"prefix": "rvt",
			"files": [
				{
					"destination": "dist/tokens.json",
					"format": "json/flat"
				}
			],
			"transforms": ["name/kebab"]
		}
	}
}
