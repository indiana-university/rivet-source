{
	"name": "@rivet-iu/core",
	"version": "3.0.0-alpha.11",
	"description": "Rivet Design System for Indiana University",
	"publishConfig": {
		"access": "public"
	},
	"license": "BSD-3-Clause",
	"homepage": "https://rivet.iu.edu",
	"repository": {
		"type": "git",
		"url": "https://github.com/indiana-university/rivet-source"
	},
	"bugs": {
		"url": "https://github.com/indiana-university/rivet-source/issues",
		"email": "rivet@iu.edu"
	},
	"type": "module",
	"imports": {
		"#components/*": "./src/components/*",
		"#layouts/*": "./src/layouts/*",
		"#utilities/*": "./src/utilities/*"
	},
	"exports": {
		".": "./dist/rivet.js",
		"./package.json": "./package.json",
		"./dist/*": "./dist/*",
		"./src/*": "./src/*"
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "vite build",
		"prepare": "pnpm build",
		"preview": "pnpm build"
	},
	"devDependencies": {
		"@laynezh/vite-plugin-lib-assets": "2.2.0",
		"sass": "1.102.0",
		"vite": "8.2.0",
		"vite-plugin-banner": "0.8.1"
	},
	"dependencies": {
		"@fontsource-variable/crimson-pro": "5.3.0",
		"@fontsource-variable/roboto-flex": "5.3.0",
		"@fontsource-variable/roboto-mono": "5.3.0",
		"@oddbird/css-anchor-positioning": "0.10.2",
		"@rivet-iu/tokens": "workspace:*",
		"wicked-elements": "3.1.2"
	}
}
