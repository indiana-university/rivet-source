	"files": ["dist"],
	"scripts": {
		"build": "vite build",
		"postbuild": "zip -r dist/rivet.zip dist"
	},
	"devDependencies": {
		"sass": "1.99.0",
		"vite": "7.3.2",
		"vite-plugin-banner": "0.8.1"
	},
	"dependencies": {
		"@rivet-iu/tokens": "workspace:*",
		"wicked-elements": "3.1.2"
	}
}
