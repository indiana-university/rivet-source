---
import { createId } from "../../utilities/createId.js";

export const title = "Hide field label";

const inputId = `hidden-form-search-${createId()}`;
---

<div class="rvt-input-group">
	<label for={inputId} rvt-util="sr-only">
		Search
	</label>
	<input
		class="rvt-input-group__input rvt-text-input"
		id={inputId}
		type="text"
	/>
	<div class="rvt-input-group__append">
		<button class="rvt-button" type="button">
			Search
		</button>
	</div>
</div>
