---
import { createId } from "../../utilities/createId.js";

export const title = "Prevent text breaking";

const checkboxOneName = `prevent-break-checkbox-demo-${createId()}`;
const checkboxTwoName = `prevent-break-checkbox-demo-${createId()}`;
const checkboxOneId = `prevent-break-checkbox-one-${createId()}`;
const checkboxTwoId = `prevent-break-checkbox-two-${createId()}`;
---

<form>
	<fieldset class="rvt-fieldset">
		<legend class="rvt-sr-only">Checkbox list</legend>
		<ul class="rvt-list-reset">
			<li class="rvt-checkbox rvt-m-bottom-sm">
				<input type="checkbox" name={checkboxOneName} id={checkboxOneId} />
				<label for={checkboxOneId} class="rvt-m-right-sm rvt-text-nobr"
					>The label for this checkbox is quite long, but will not break onto a
					new line</label
				>
			</li>
			<li class="rvt-checkbox">
				<input type="checkbox" name={checkboxTwoName} id={checkboxTwoId} />
				<label for={checkboxTwoId}>Option two</label>
			</li>
		</ul>
	</fieldset>
	<button type="submit" class="rvt-button rvt-button--strong">Submit</button>
</form>
