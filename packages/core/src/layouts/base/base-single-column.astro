---
import Header from "#components/header/header-demo.astro";
import HeroCallout from "#components/hero/hero-callout.astro";
import Footer from "#components/footer/footer-demo.astro";
export const title = "Base layout - Single column";
---

<Header />
<main>
	<div class="rvt-section rvt-theme-light">
		<HeroCallout />
	</div>
	<div class="rvt-container">
		<hr aria-hidden="true" class="rvt-m-all-none" />
	</div>
	<div class="rvt-container [ rvt-m-top-md ]">
		<nav role="navigation" aria-label="Breadcrumbs">
			<ol class="rvt-breadcrumbs">
				<li><a href="#">Home</a></li>
				<li><a href="#">Visited page</a></li>
				<li><a href="#">Visited page</a></li>
				<li><a href="#">Visited page</a></li>
				<li aria-current="page">Current page</li>
			</ol>
		</nav>
	</div>
	<div class="rvt-layout-base rvt-layout-base--single-column">
		<div class="rvt-layout-base__main">
			<div class="rvt-empty-state">
				<div class="rvt-empty-state__content">
					<p>Base Layout - Main content...</p>
				</div>
			</div>
		</div>
	</div>
</main>
<Footer />
