---
import { createId } from "../../utilities/createId.js";

const checkboxOneId = `checkbox-filter-one-${createId()}`;
const checkboxTwoId = `checkbox-filter-two-${createId()}`;
const checkboxThreeId = `checkbox-filter-three-${createId()}`;
const textOneId = `filter-form-text-one-${createId()}`;
const textTwoId = `filter-form-text-two-${createId()}`;
const textThreeId = `filter-form-text-three-${createId()}`;
const selectId = `filter-form-select-${createId()}`;
---

<form class="rvt-bg-black-000 rvt-p-all-md rvt-flex rvt-flex-column rvt-gap-md">
	<div class="rvt-grid rvt-grid--4">
		<div>
			<label for={textOneId} class="rvt-label">Lorem Ipsum</label>
			<input type="text" class="rvt-input" id={textOneId} />
		</div>
		<div>
			<label for={textTwoId} class="rvt-label">Lorem Ipsum</label>
			<input type="text" class="rvt-input" id={textTwoId} />
		</div>
		<div>
			<label for={selectId} class="rvt-label">Select Input</label>
			<div class="rvt-select">
				<select id={selectId}>
					<option value="option one">Option One</option>
					<option value="option two">Option Two</option>
					<option value="option three">Option Three</option>
				</select>
			</div>
		</div>
		<div>
			<label for={textThreeId} class="rvt-label">Lorem Ipsum</label>
			<input type="text" class="rvt-input" id={textThreeId} />
		</div>
	</div>

	<fieldset class="rvt-fieldset">
		<legend class="rvt-font-medium rvt-ts-14">Checkbox list</legend>
		<ul class="rvt-list-inline">
			<li>
				<div class="rvt-checkbox">
					<input
						type="checkbox"
						name={`checkbox-demo-${createId()}`}
						id={checkboxOneId}
						checked
					/>
					<label for={checkboxOneId}>Option one</label>
				</div>
			</li>
			<li>
				<div class="rvt-checkbox">
					<input
						type="checkbox"
						name={`checkbox-demo-${createId()}`}
						id={checkboxTwoId}
					/>
					<label for={checkboxTwoId}>Option two</label>
				</div>
			</li>
			<li>
				<div class="rvt-checkbox">
					<input
						type="checkbox"
						name={`checkbox-demo-${createId()}`}
						id={checkboxThreeId}
					/>
					<label for={checkboxThreeId}>Option three</label>
				</div>
			</li>
		</ul>
	</fieldset>

	<div class="rvt-flex rvt-gap-sm rvt-justify-end">
		<button class="rvt-button rvt-button--strong" type="submit"
			>Filter results</button
		>
		<button class="rvt-button" type="button">Filter results</button>
	</div>
</form>
