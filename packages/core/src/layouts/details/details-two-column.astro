---
import Breadcrumbs from "#components/breadcrumbs/breadcrumbs-demo.astro";
import DetailsContent from "./details-content.astro";
import Footer from "#components/footer/footer-demo.astro";
import Header from "#components/header/header-demo.astro";
import HeroCallout from "#components/hero/hero-callout.astro";
import Sidenav from "#components/sidenav/sidenav-demo.astro";
export const title = "Details layout - Two columns";
---

<Header />
<main>
	<div class="rvt-section">
		<HeroCallout />
	</div>
	<div class="rvt-container">
		<hr aria-hidden="true" class="rvt-m-all-none" />
	</div>
	<div class="rvt-layout-base">
		<div class="rvt-layout-base__sidebar" id="sidebar-main-content">
			<Sidenav />
		</div>
		<div class="rvt-layout-base__main">
			<Breadcrumbs />
			<div class="rvt-stack rvt-m-top-xl">
				<DetailsContent />
			</div>
		</div>
	</div>
</main>
<Footer />
