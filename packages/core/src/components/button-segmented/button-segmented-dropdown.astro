---
export const title = "Segmented Button with Dropdown";
---

<div aria-label="Dropdown group" class="rvt-button-segmented" role="group">
	<rvt-button>
		<button type="button">
			<rvt-icon name="file"></rvt-icon>
			Meeting Agenda.pdf
		</button>
	</rvt-button>
	<div class="rvt-dropdown rvt-p-left-xxs" data-rvt-dropdown>
		<rvt-button>
			<button data-rvt-dropdown-toggle type="button">
				<rvt-icon name="chevron-down"></rvt-icon>
				<rvt-sr-only>Toggle options menu</rvt-sr-only>
			</button>
		</rvt-button>
		<div class="rvt-dropdown__menu" data-rvt-dropdown-menu hidden>
			<button role="menuitemradio" type="button">
				Preview
			</button>
			<button role="menuitemradio" type="button">
				Open
			</button>
			<button role="menuitemradio" type="button">
				Save As...
			</button>
		</div>
	</div>
</div>

<div class="rvt-m-top-md">
	<div aria-label="Dropdown group" class="rvt-button-segmented" role="group">
		<rvt-button>
			<button type="button">Light</button>
		</rvt-button>
		<rvt-button>
			<button type="button">Dark</button>
		</rvt-button>
		<rvt-button>
			<button type="button">Crimson</button>
		</rvt-button>
	</div>
</div>
