---
export const title = "Empty State - Actions and Icons";
---

<div class="rvt-empty-state">
	<div class="rvt-empty-state__content">
		<div class="rvt-p-all-md rvt-m-bottom-md rvt-bg-black-100 rvt-inline-flex rvt-border-radius-circle">
			<rvt-icon name="bell"></rvt-icon>
		</div>
		<p>There's nothing here yet.</p>
	</div>
	<div class="rvt-empty-state__actions">
		<rvt-button type="strong">
			<button type="button">Create your first item</button>
		</rvt-button>
		<rvt-button type="subtle">
			<a href="#">Read the documentation</a>
		</rvt-button>
	</div>
</div>
