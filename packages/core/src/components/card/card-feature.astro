---
import Card from "./card.astro";
export const title = "Feature Card";
---

<div>
	<Card badge content eyebrow image type="feature" />
</div>

<div class="rvt-m-top-sm">
	<Card badge content eyebrow sticker type="feature" />
</div>

<div class="rvt-m-top-sm">
	<Card badge content eyebrow type="feature" />
</div>

<hr class="rvt-m-tb-xl" />

<ul class="rvt-card-grid">
	<li><Card type="feature" /></li>
	<li><Card badge type="feature" /></li>
	<li><Card badge eyebrow type="feature" /></li>
	<li><Card badge content eyebrow type="feature" /></li>
	<li><Card badge content eyebrow type="feature" /></li>
	<li><Card badge content eyebrow sticker type="feature" /></li>
	<li><Card badge content eyebrow image type="feature" /></li>
</ul>
