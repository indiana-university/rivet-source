---
import Card from "./card.astro";
export const title = "Event Card";
---

<div>
	<Card badge details eyebrow image meta raised type="event" />
</div>

<div class="rvt-m-top-xl">
	<Card badge date details eyebrow meta raised type="event" />
</div>

<div class="rvt-m-top-xl">
	<Card badge details eyebrow meta raised type="event" />
</div>

<ul class="rvt-card-grid rvt-m-top-xl">
	<li><Card type="event" /></li>
	<li><Card badge type="event" /></li>
	<li><Card badge eyebrow type="event" /></li>
	<li><Card badge details eyebrow type="event" /></li>
	<li><Card badge details eyebrow meta type="event" /></li>
	<li><Card badge date details eyebrow meta type="event" /></li>
	<li><Card badge details eyebrow image meta type="event" /></li>
</ul>
