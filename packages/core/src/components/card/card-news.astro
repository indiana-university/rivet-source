</div>

<div class="rvt-m-top-xl">
	<Card badge eyebrow meta raised sticker type="news" />
</div>

<div class="rvt-m-top-xl">
	<Card badge eyebrow meta raised type="news" />
</div>

<ul class="rvt-card-grid rvt-m-top-xl">
	<li><Card type="news" /></li>
	<li><Card badge type="news" /></li>
	<li><Card badge eyebrow type="news" /></li>
	<li><Card badge eyebrow type="news" /></li>
	<li><Card badge eyebrow meta type="news" /></li>
	<li><Card badge eyebrow meta sticker type="news" /></li>
	<li><Card badge eyebrow image meta type="news" /></li>
</ul>
