---
const {
	avatar,
	badge,
	content,
	date,
	details,
	eyebrow,
	image,
	meta,
	raised,
	sticker,
	subtitle,
	type = "default",
} = Astro.props;
---

{type === "default" && (
	<div class:list={["rvt-card", { "rvt-card--raised": raised }]}>
		{image && (
			<div class="rvt-card__image">
				<img
					alt="Smiling students sitting outside on a bench"
					src="https://rivet.iu.edu/img/placeholder/list-card-3.webp"
				/>
			</div>
		)}
		{sticker && (
			<div class="rvt-card__sticker">
				<rvt-sticker name="pencil-ruler" size="sm" theme="crimson" />
			</div>
		)}
		<div class="rvt-card__body">
			{badge && (
				<div class="rvt-card__badge">
					<strong class="rvt-badge">Featured</strong>
				</div>
			)}
			{eyebrow && <rvt-eyebrow>Tag or category</rvt-eyebrow>}
			<h2 class="rvt-card__title">
				<a href="#">Find your ideal campus life at IU</a>
			</h2>
			{content && (
				<div class="rvt-card__content">
					<p>
						Each of our nine campuses offers a welcoming, inclusive environment
						that feels like home, whatever your background, interests, or goals.
						Whether you want a Big Ten college experience, the dynamic pace of
						an urban research university, the community feeling of a regional
						campus close to home, or the flexibility of a fully online degree
						program, you'll find it at IU.
					</p>
					<ul class="rvt-list">
						<li>One two</li>
						<li>One two</li>
						<li>One two</li>
					</ul>
				</div>
			)}
			{meta && (
				<>
					<div class="rvt-card__meta">November 5, 1955</div>
					<div class="rvt-card__tags">
						<ul class="rvt-list-inline rvt-gap-xs">
							<li>
								<a class="rvt-button rvt-button--small" href="#">
									Tag one
								</a>
							</li>
							<li>
								<a class="rvt-button rvt-button--small" href="#">
									Tag two
								</a>
							</li>
							<li>
								<a class="rvt-button rvt-button--small" href="#">
									Tag three
								</a>
							</li>
							<li>
								<a class="rvt-button rvt-button--small" href="#">
									Tag four
								</a>
							</li>
						</ul>
					</div>
				</>
			)}
		</div>
	</div>
)}

{type === "event" && (
	<div
		class:list={["rvt-card", "rvt-card--event", { "rvt-card--raised": raised }]}
	>
		{date && (
			<div class="rvt-card__date">
				<div class="rvt-cal">
					<span class="rvt-cal__month">Dec</span>
					<span class="rvt-cal__day">21</span>
					<span class="rvt-cal__year">2024</span>
				</div>
			</div>
		)}
		{image && (
			<div class="rvt-card__image">
				<img
					alt="Smiling students sitting outside on a bench"
					src="https://rivet.iu.edu/img/placeholder/list-card-3.webp"
				/>
			</div>
		)}
		<div class="rvt-card__body">
			{badge && (
				<div class="rvt-card__badge">
					<strong class="rvt-badge">Featured</strong>
				</div>
			)}
			{eyebrow && <rvt-eyebrow>Tag or campus</rvt-eyebrow>}
			<h2 class="rvt-card__title">
				<a href="#">Find your ideal campus life at IU</a>
			</h2>
			{details && (
				<ul class="rvt-card__details">
					<li>
						<rvt-icon name="calendar" />
						<time>Dec 21, 2024</time>
					</li>
					<li>
						<rvt-icon name="clock" />
						<time>9:00 AM</time>
					</li>
					<li>
						<rvt-icon name="map-pin" />
						<span>Indianapolis Campus Center</span>
					</li>
				</ul>
			)}
			{meta && (
				<>
					<div class="rvt-card__meta">Tags</div>
					<div class="rvt-card__tags">
						<ul class="rvt-list-inline rvt-gap-xs">
							<li>
								<a class="rvt-button rvt-button--small" href="#">
									Tag one
								</a>
							</li>
							<li>
								<a class="rvt-button rvt-button--small" href="#">
									Tag two
								</a>
							</li>
							<li>
								<a class="rvt-button rvt-button--small" href="#">
									Tag three
								</a>
							</li>
							<li>
								<a class="rvt-button rvt-button--small" href="#">
									Tag four
								</a>
							</li>
						</ul>
					</div>
				</>
			)}
		</div>
	</div>
)}

{type === "feature" && (
	<div class="rvt-card rvt-card--feature">
		{image && (
			<div class="rvt-card__image">
				<img
					alt="Smiling students sitting outside on a bench"
					src="https://rivet.iu.edu/img/placeholder/list-card-3.webp"
				/>
			</div>
		)}
		{sticker && (
			<div class="rvt-card__sticker">
				<rvt-sticker name="pencil-ruler" size="sm" theme="crimson" />
			</div>
		)}
		<div class="rvt-card__body">
			{badge && (
				<div class="rvt-card__badge">
					<strong class="rvt-badge">Featured</strong>
				</div>
			)}
			{eyebrow && <rvt-eyebrow>Category</rvt-eyebrow>}
			<h2 class="rvt-card__title">
				<a href="#">Find your ideal campus life at IU</a>
			</h2>
			{content && (
				<div class="rvt-card__content">
					<p>
						Each of our nine campuses offers a welcoming, inclusive environment
						that feels like home, whatever your background, interests, or goals.
						Whether you want a Big Ten college experience, the dynamic pace of
						an urban research university, the community feeling of a regional
						campus close to home, or the flexibility of a fully online degree
						program, you’ll find it at IU.
					</p>
				</div>
			)}
		</div>
	</div>
)}

{type === "news" && (
	<div
		class:list={["rvt-card", "rvt-card--news", { "rvt-card--raised": raised }]}
	>
		{image && (
			<div class="rvt-card__image">
				<img
					alt="Smiling students sitting outside on a bench"
					src="https://rivet.iu.edu/img/placeholder/list-card-3.webp"
				/>
			</div>
		)}
		{sticker && (
			<div class="rvt-card__sticker">
				<rvt-sticker name="bike" size="sm" theme="crimson" />
			</div>
		)}
		<div class="rvt-card__body">
			{badge && (
				<div class="rvt-card__badge">
					<strong class="rvt-badge">Featured</strong>
				</div>
			)}
			{eyebrow && <rvt-eyebrow>Category</rvt-eyebrow>}
			<h2 class="rvt-card__title">
				<a href="#">Find your ideal campus life at IU</a>
			</h2>
			{meta && (
				<>
					<div class="rvt-card__meta">Tag, category, or date</div>
					<div class="rvt-card__tags">
						<ul class="rvt-list-inline rvt-gap-xs">
							<li>
								<a class="rvt-button rvt-button--small" href="#">
									Tag one
								</a>
							</li>
							<li>
								<a class="rvt-button rvt-button--small" href="#">
									Tag two
								</a>
							</li>
							<li>
								<a class="rvt-button rvt-button--small" href="#">
									Tag three
								</a>
							</li>
							<li>
								<a class="rvt-button rvt-button--small" href="#">
									Tag four
								</a>
							</li>
						</ul>
					</div>
				</>
			)}
		</div>
	</div>
)}

{type === "profile" && (
	<div
		class:list={[
			"rvt-card",
			"rvt-card--profile",
			{ "rvt-card--raised": raised },
		]}
	>
		{avatar && (
			<div class="rvt-card__avatar">
				<div class="rvt-avatar rvt-avatar--md">
					<img
						alt=""
						class="rvt-avatar__image"
						src="https://rivet.iu.edu/img/placeholder/avatar-1.webp"
					/>
				</div>
			</div>
		)}
		<div class="rvt-card__body">
			{eyebrow && <rvt-eyebrow>Campus/Team/Department</rvt-eyebrow>}
			<h2 class="rvt-card__title">
				<a href="#">First and Last Name</a>
			</h2>
			{subtitle && <div class="rvt-card__subtitle">Person's Title</div>}
			{details && (
				<ul class="rvt-card__details">
					<li>
						<rvt-icon name="envelope" />
						<a href="mailto:example@iu.edu">example@iu.edu</a>
					</li>
					<li>
						<rvt-icon name="phone" />
						<a href="tel:8124441717">(812)&nbsp;444&#8209;1717</a>
					</li>
					<li>
						<rvt-icon name="device" />
						<a href="#">examplesite.com</a>
					</li>
					<li>
						<rvt-icon name="user" />
						<span>
							<strong>Pronouns:</strong> She/Her
						</span>
					</li>
				</ul>
			)}
			{meta && (
				<>
					<div class="rvt-card__meta">Areas of expertise</div>
					<div class="rvt-card__tags">
						<ul class="rvt-list-inline rvt-gap-xs">
							<li>
								<span class="rvt-badge">UI/UX Design</span>
							</li>
							<li>
								<span class="rvt-badge">Branding</span>
							</li>
							<li>
								<span class="rvt-badge">Illustration</span>
							</li>
						</ul>
					</div>
				</>
			)}
		</div>
	</div>
)}
