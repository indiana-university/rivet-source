---
import { createId } from "../../utilities/createId.js";

const labelId = `sidenav-label-${createId()}`;
---

<nav
	aria-labelledby={labelId}
	class="rvt-sidenav"
	data-rvt-sidenav="base-two-column"
	data-rvt-sidenav-collapse-on-mobile
>
	<span class="rvt-sidenav__label" id={labelId}>
		Section pages <rvt-sr-only>({Astro.props.label})</rvt-sr-only>
	</span>
	<ul class="rvt-sidenav__list">
		<li class="rvt-sidenav__item">
			<a class="rvt-sidenav__link" href="#">
				Section nav one
			</a>
		</li>
		<li class="rvt-sidenav__item">
			<a aria-current="page" class="rvt-sidenav__link" href="#">
				Section nav two
			</a>
		</li>
		<li class="rvt-sidenav__item">
			<div class="rvt-sidenav__item-wrapper">
				<a class="rvt-sidenav__link" href="#">
					Section nav three
				</a>
				<button
					class="rvt-sidenav__toggle"
					data-rvt-sidenav-toggle
					type="button"
				>
					<rvt-sr-only>
						Expand or hide links nested under the Section nav three section
					</rvt-sr-only>
				</button>
			</div>
			<ul class="rvt-sidenav__list" data-rvt-sidenav-list>
				<li class="rvt-sidenav__item">
					<a class="rvt-sidenav__link" href="#">
						Level two
					</a>
				</li>
				<li class="rvt-sidenav__item">
					<a class="rvt-sidenav__link" href="#">
						Level two
					</a>
				</li>
				<li class="rvt-sidenav__item">
					<div class="rvt-sidenav__item-wrapper">
						<a class="rvt-sidenav__link" href="#">
							Level two
						</a>
						<button
							class="rvt-sidenav__toggle"
							data-rvt-sidenav-toggle
							type="button"
						>
							<rvt-sr-only>
								Expand or hide links nested under the Level two section
							</rvt-sr-only>
						</button>
					</div>
					<ul class="rvt-sidenav__list" data-rvt-sidenav-list>
						<li class="rvt-sidenav__item">
							<a class="rvt-sidenav__link" href="#">
								Level three
							</a>
						</li>
						<li class="rvt-sidenav__item">
							<a class="rvt-sidenav__link" href="#">
								Level three
							</a>
						</li>
					</ul>
				</li>
			</ul>
		</li>
	</ul>
</nav>
