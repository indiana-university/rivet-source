---
import { createId } from "../../utilities/createId.js";

export const title = "Sidenav";

const labelId = `sidenav-label-${createId()}`;
---

<nav aria-labelledby={labelId} class="rvt-sidenav" data-rvt-sidenav>
	<span class="rvt-sidenav__label" id={labelId}>
		Section pages <rvt-sr-only>({Astro.props.label})</rvt-sr-only>
	</span>
	<ul class="rvt-sidenav__list">
		<li class="rvt-sidenav__item">
			<a class="rvt-sidenav__link" href="#">
				Section nav one
			</a>
		</li>
		<li class="rvt-sidenav__item">
			<a aria-current="page" class="rvt-sidenav__link" href="#">
				Section nav two
			</a>
		</li>
		<li class="rvt-sidenav__item">
			<a class="rvt-sidenav__link" href="#">
				Section nav three
			</a>
		</li>
	</ul>
</nav>
