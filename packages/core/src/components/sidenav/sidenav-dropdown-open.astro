---
import { createId } from "../../utilities/createId.js";

export const title = "Sidenav - Open";

const labelId = `sidenav-label-${createId()}`;
---

<nav
	aria-labelledby={labelId}
	class="rvt-sidenav"
	data-rvt-sidenav
	data-rvt-sidenav-open-all
>
	<span class="rvt-sidenav__label" id={labelId}>
		Section pages <span class="rvt-sr-only">({Astro.props.label})</span>
	</span>
	<ul class="rvt-sidenav__list">
		<li class="rvt-sidenav__item">
			<a class="rvt-sidenav__link" href="#">Section nav one</a>
		</li>
		<li class="rvt-sidenav__item">
			<a aria-current="page" class="rvt-sidenav__link" href="#"
				>Section nav two</a
			>
		</li>
		<li class="rvt-sidenav__item">
			<div class="rvt-sidenav__item-wrapper">
				<a class="rvt-sidenav__link" href="#">Section nav three</a>
				<button
					class="rvt-sidenav__toggle"
					data-rvt-sidenav-toggle="toggle-1"
					type="button"
				>
					<span class="rvt-sr-only"
						>Expand or hide links nested under the Section nav three section</span
					>
					<svg
						height="16"
						viewBox="0 0 16 16"
						width="16"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path
							d="M8,12.46a2,2,0,0,1-1.52-.7L1.24,5.65a1,1,0,1,1,1.52-1.3L8,10.46l5.24-6.11a1,1,0,0,1,1.52,1.3L9.52,11.76A2,2,0,0,1,8,12.46Z"
							fill="currentColor"></path>
					</svg>
				</button>
			</div>
			<ul class="rvt-sidenav__list" data-rvt-sidenav-list="toggle-1">
				<li class="rvt-sidenav__item">
					<a class="rvt-sidenav__link" href="#">Level two</a>
				</li>
				<li class="rvt-sidenav__item">
					<a class="rvt-sidenav__link" href="#">Level two</a>
				</li>
				<li class="rvt-sidenav__item">
					<div class="rvt-sidenav__item-wrapper">
						<a class="rvt-sidenav__link" href="#">Level two</a>
						<button
							class="rvt-sidenav__toggle"
							data-rvt-sidenav-toggle="toggle-2"
							type="button"
						>
							<span class="rvt-sr-only"
								>Expand or hide links nested under the Level two section</span
							>
							<svg
								height="16"
								viewBox="0 0 16 16"
								width="16"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									d="M8,12.46a2,2,0,0,1-1.52-.7L1.24,5.65a1,1,0,1,1,1.52-1.3L8,10.46l5.24-6.11a1,1,0,0,1,1.52,1.3L9.52,11.76A2,2,0,0,1,8,12.46Z"
									fill="currentColor"></path>
							</svg>
						</button>
					</div>
					<ul class="rvt-sidenav__list" data-rvt-sidenav-list="toggle-2">
						<li class="rvt-sidenav__item">
							<a class="rvt-sidenav__link" href="#">Level three</a>
						</li>
						<li class="rvt-sidenav__item">
							<a class="rvt-sidenav__link" href="#">Level three</a>
						</li>
					</ul>
				</li>
			</ul>
		</li>
	</ul>
</nav>
