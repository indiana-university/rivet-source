---
export const title = "Hero - Profile";
---

<div class="rvt-hero rvt-hero--profile">
	<div class="rvt-hero__avatar">
		<div class="rvt-avatar rvt-avatar--md">
			<img
				alt=""
				class="rvt-avatar__image"
				src="https://rivet.iu.edu/img/placeholder/avatar-1.webp"
			/>
		</div>
		<a class="rvt-button rvt-button--small rvt-button--icon-only" href="#">
			<rvt-icon name="download"></rvt-icon>
			<rvt-sr-only>Download avatar image</rvt-sr-only>
		</a>
	</div>
	<div class="rvt-hero__body">
		<rvt-eyebrow>Faculty</rvt-eyebrow>
		<h1 class="rvt-hero__title">Ava Carter</h1>
		<p class="rvt-hero__subtitle">PhD, MA</p>
		<p class="rvt-hero__teaser">Assistant Professor of Sports Marketing</p>
		<div class="rvt-hero__actions">
			<a
				class="rvt-button rvt-button--cta rvt-button--strong"
				href="https://mediaschool.indiana.edu"
			>
				Read publications
			</a>
		</div>
	</div>
</div>
