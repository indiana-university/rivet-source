---
import { createId } from "../../utilities/createId.js";

export const title = "Dialog - Mounted";

const appId = `app-${createId()}`;
const dialogId = `dialog-example-${createId()}`;
const dialogTitleId = `dialog-title-${createId()}`;
const dialogDescriptionId = `dialog-description-${createId()}`;
---

<div data-rvt-dialog-mount id={appId}>
	<h1>Some test header</h1>
	<rvt-button>
		<button data-rvt-dialog-trigger={dialogId} type="button">
			Dialog example
		</button>
	</rvt-button>
	<div
		aria-describedby={dialogDescriptionId}
		aria-labelledby={dialogTitleId}
		class="rvt-dialog"
		data-rvt-dialog={dialogId}
		data-rvt-dialog-darken-page
		data-rvt-dialog-disable-page-interaction
		hidden
		id={dialogId}
		role="dialog"
		tabindex="-1"
	>
		<header
			aria-label={`Dialog (${Astro.props.label})`}
			class="rvt-dialog__header"
		>
			<h1 class="rvt-dialog__title" id={dialogTitleId}>
				Dialog title
			</h1>
		</header>
		<div class="rvt-dialog__body">
			<p id={dialogDescriptionId}>
				The default dialog appears near the middle of the screen. It does not
				darken the page behind it and does not close when the user clicks
				outside of it. You can use data attributes to configure the appearance
				and behavior of the dialog.
			</p>
		</div>
		<div class="rvt-dialog__controls">
			<rvt-button type="strong">
				<button type="button">OK</button>
			</rvt-button>
			<rvt-button>
				<button data-rvt-dialog-close={dialogId} type="button">
					Cancel
				</button>
			</rvt-button>
		</div>
		<button
			class="rvt-dialog__close"
			data-rvt-dialog-close={dialogId}
			type="button"
		>
			<rvt-icon name="close"></rvt-icon>
			<rvt-sr-only>Close</rvt-sr-only>
		</button>
	</div>
</div>
