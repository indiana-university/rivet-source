---
import { createId } from "../../utilities/createId.js";

export const title = "Confirmation Dialog";

const dialogId = `dialog-confirmation-${createId()}`;
const dialogTitleId = `dialog-title-${createId()}`;
const dialogDescriptionId = `dialog-description-${createId()}`;
---

<button
	class="rvt-button rvt-button--strong"
	data-rvt-dialog-trigger={dialogId}
	type="button"
>
	<span>Delete files</span>
</button>
<div
	aria-describedby={dialogDescriptionId}
	aria-labelledby={dialogTitleId}
	class="rvt-dialog"
	data-rvt-dialog={dialogId}
	data-rvt-dialog-darken-page
	data-rvt-dialog-disable-page-interaction
	data-rvt-dialog-modal
	hidden
	id={dialogId}
	role="dialog"
	tabindex="-1"
>
	<header
		aria-label={`Dialog (${Astro.props.label})`}
		class="rvt-dialog__header"
	>
		<h1 class="rvt-dialog__title" id={dialogTitleId}>Delete files</h1>
	</header>
	<div class="rvt-dialog__body">
		<p class="m-top-remove m-bottom-xl" id={dialogDescriptionId}>
			Are you sure you want to <strong>delete your files</strong>? This action
			cannot be undone.
		</p>
	</div>
	<div class="rvt-dialog__controls">
		<button class="rvt-button rvt-button--strong" type="button">
			<span>Delete my files</span>
		</button>
		<button
			class="rvt-button rvt-button--secondary"
			data-rvt-dialog-close={dialogId}
			type="button"
		>
			<span>Cancel</span>
		</button>
	</div>
</div>
