---
import { createId } from "../../utilities/createId.js";

export const title = "Dialog with hidden child element";

const dialogId = `dialog-example-${createId()}`;
const dialogTitleId = `dialog-title-${createId()}`;
const dialogDescriptionId = `dialog-description-${createId()}`;
---

<button class="rvt-button" data-rvt-dialog-trigger={dialogId} type="button">
	<span>Dialog example</span>
</button>
<div
	aria-describedby={dialogDescriptionId}
	aria-labelledby={dialogTitleId}
	class="rvt-dialog"
	data-rvt-dialog={dialogId}
	hidden
	id={dialogId}
	role="dialog"
	tabindex="-1"
>
	<header
		aria-label={`Dialog (${Astro.props.label})`}
		class="rvt-dialog__header"
	>
		<h1 class="rvt-dialog__title" id={dialogTitleId}>Dialog title</h1>
	</header>
	<div class="rvt-dialog__body">
		<p id={dialogDescriptionId}>
			The default dialog appears near the middle of the screen. It does not
			darken the page behind it and does not close when the user clicks outside
			of it. You can use data attributes to configure the appearance and
			behavior of the dialog.
		</p>
	</div>
	<div class="rvt-dialog__controls">
		<button class="rvt-button" role="button" type="button">
			<span>OK</span>
		</button>
		<button
			class="rvt-button rvt-button--secondary"
			data-rvt-dialog-close={dialogId}
			role="button"
			type="button"
		>
			<span>Cancel</span>
		</button>
		<button
			aria-hidden="true"
			class="rvt-button"
			hidden
			role="button"
			style="display: none"
			type="button"
		>
			<span>Hidden</span>
		</button>
	</div>
</div>
