---
import { createId } from "../../utilities/createId.js";

export const title = "Dialog - Help widget";

const dialogId = `dialog-help-widget-${createId()}`;
const dialogDescriptionId = `dialog-description-${createId()}`;
---

<div
	aria-describedby={dialogDescriptionId}
	class="rvt-dialog"
	data-rvt-dialog={dialogId}
	data-rvt-dialog-bottom-right
	data-rvt-dialog-open-on-init
	hidden
	id={dialogId}
	role="dialog"
	tabindex="-1"
>
	<div class="rvt-dialog__body">
		<p class="rvt-m-all-none" id={dialogDescriptionId}>
			Do you need help with your task? Support center technicians are available
			over chat to provide live assistance.
		</p>
	</div>
	<div class="rvt-dialog__controls">
		<rvt-button type="strong">
			<button type="button">Chat</button>
		</rvt-button>
		<rvt-button>
			<button data-rvt-dialog-close={dialogId} type="button">
				No thanks
			</button>
		</rvt-button>
	</div>
</div>
