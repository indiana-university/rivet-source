---
import { createId } from "../../utilities/createId.js";

export const title = "Dialog form";

const dialogId = `dialog-form-${createId()}`;
const dialogTitleId = `dialog-title-${createId()}`;
const titleInputId = `dialog-form-title-${createId()}`;
const descriptionInputId = `dialog-form-description-${createId()}`;
const selectInputId = `dialog-form-select-${createId()}`;
const checkboxGroupName = `dialog-form-checkbox-demo-${createId()}`;
const checkboxOneId = `dialog-form-checkbox-one-${createId()}`;
const checkboxTwoId = `dialog-form-checkbox-two-${createId()}`;
const checkboxThreeId = `dialog-form-checkbox-three-${createId()}`;
---

<rvt-button>
	<button data-rvt-dialog-trigger={dialogId} type="button">
		Dialog with form
	</button>
</rvt-button>
<div
	aria-labelledby={dialogTitleId}
	class="rvt-dialog"
	data-rvt-dialog={dialogId}
	data-rvt-dialog-darken-page
	data-rvt-dialog-disable-page-interaction
	data-rvt-dialog-modal
	hidden
	id={dialogId}
	role="dialog"
	tabindex="-1"
>
	<header
		aria-label={`Dialog (${Astro.props.label})`}
		class="rvt-dialog__header"
	>
		<h1 class="rvt-dialog__title" id={dialogTitleId}>
			Dialog title
		</h1>
	</header>
	<div class="rvt-dialog__body">
		<div class="m-bottom-sm">
			<label class="rvt-label" for={titleInputId}>
				Title
			</label>
			<input class="rvt-text-input" id={titleInputId} type="text" />
		</div>
		<label class="rvt-label" for={descriptionInputId}>
			Description
		</label>
		<textarea class="rvt-textarea" id={descriptionInputId}></textarea>
		<fieldset class="rvt-fieldset">
			<legend class="rvt-ts-20 rvt-m-bottom-sm">
				<strong>Select dropdown</strong> default
			</legend>
			<label class="rvt-label" for={selectInputId}>
				Select input:
			</label>
			<div class="rvt-select m-bottom-md">
				<select id={selectInputId}>
					<option value="">Option One</option>
					<option value="">Option Two</option>
					<option value="">Option Three</option>
					<option value="">Option Four</option>
				</select>
			</div>
		</fieldset>
		<fieldset class="rvt-fieldset rvt-m-top-xl">
			<legend class="rvt-ts-20 rvt-text-bold">Category</legend>
			<ul class="rvt-list-inline">
				<li>
					<div class="rvt-checkbox">
						<input
							checked
							id={checkboxOneId}
							name={checkboxGroupName}
							type="checkbox"
						/>
						<label for={checkboxOneId}>Option one</label>
					</div>
				</li>
				<li>
					<div class="rvt-checkbox">
						<input
							id={checkboxTwoId}
							name={checkboxGroupName}
							type="checkbox"
						/>
						<label for={checkboxTwoId}>Option two</label>
					</div>
				</li>
				<li>
					<div class="rvt-checkbox">
						<input
							id={checkboxThreeId}
							name={checkboxGroupName}
							type="checkbox"
						/>
						<label for={checkboxThreeId}>Option three</label>
					</div>
				</li>
			</ul>
		</fieldset>
	</div>
	<div class="rvt-dialog__controls">
		<rvt-button type="strong">
			<button type="button">Submit</button>
		</rvt-button>
		<rvt-button>
			<button data-rvt-dialog-close={dialogId} type="button">
				Cancel
			</button>
		</rvt-button>
	</div>
	<button
		class="rvt-dialog__close"
		data-rvt-dialog-close={dialogId}
		type="button"
	>
		<rvt-icon name="close"></rvt-icon>
		<rvt-sr-only>Close</rvt-sr-only>
	</button>
</div>
