---
import { createId } from "../../utilities/createId.js";

export const title = "Textarea with validation alerts";

const successTextareaId = `textarea-success-${createId()}`;
const warningTextareaId = `textarea-warning-${createId()}`;
const dangerTextareaId = `textarea-danger-${createId()}`;
const infoTextareaId = `textarea-info-${createId()}`;
const successAlertMessageId = `textarea-success-alert-${createId()}`;
const warningAlertMessageId = `textarea-warning-alert-${createId()}`;
const dangerAlertMessageId = `textarea-danger-alert-${createId()}`;
const infoAlertMessageId = `textarea-info-alert-${createId()}`;
---

<!-- Success -->
<label class="rvt-label" for={successTextareaId}>Textarea</label>
<textarea class="rvt-textarea rvt-validation-success" id={successTextareaId}
></textarea>
<div class="rvt-inline-alert rvt-inline-alert--success">
	<span class="rvt-inline-alert__icon">
		<svg
			aria-hidden="true"
			height="16"
			viewBox="0 0 16 16"
			width="16"
			xmlns="http://www.w3.org/2000/svg"
		>
			<g fill="currentColor">
				<path
					d="M10.2,5.4,7.1,9.53,5.67,8.25a1,1,0,1,0-1.34,1.5l2.05,1.82a1.29,1.29,0,0,0,.83.32h.12a1.23,1.23,0,0,0,.88-.49L11.8,6.6a1,1,0,1,0-1.6-1.2Z"
				></path>
				<path
					d="M8,0a8,8,0,1,0,8,8A8,8,0,0,0,8,0ZM8,14a6,6,0,1,1,6-6A6,6,0,0,1,8,14Z"
				></path>
			</g>
		</svg>
	</span>
	<span class="rvt-inline-alert__message" id={successAlertMessageId}
		>Your Essay is valid!</span
	>
</div>

<!-- Warning -->
<label class="rvt-label [ rvt-m-top-md ]" for={warningTextareaId}
	>Textarea</label
>
<textarea class="rvt-textarea rvt-validation-warning" id={warningTextareaId}
></textarea>
<div class="rvt-inline-alert rvt-inline-alert--warning">
	<span class="rvt-inline-alert__icon">
		<svg
			aria-hidden="true"
			height="16"
			viewBox="0 0 16 16"
			width="16"
			xmlns="http://www.w3.org/2000/svg"
		>
			<g fill="currentColor">
				<path d="M11,9H5A1,1,0,0,1,5,7h6a1,1,0,0,1,0,2Z"></path>
				<path
					d="M8,16a8,8,0,1,1,8-8A8,8,0,0,1,8,16ZM8,2a6,6,0,1,0,6,6A6,6,0,0,0,8,2Z"
				></path>
			</g>
		</svg>
	</span>
	<span class="rvt-inline-alert__message" id={warningAlertMessageId}
		>Your Response has some misspellings!</span
	>
</div>

<!-- Danger -->
<label class="rvt-label [ rvt-m-top-md ]" for={dangerTextareaId}>Textarea</label
>
<textarea class="rvt-textarea rvt-validation-danger" id={dangerTextareaId}
></textarea>
<div class="rvt-inline-alert rvt-inline-alert--danger">
	<span class="rvt-inline-alert__icon">
		<svg
			aria-hidden="true"
			height="16"
			viewBox="0 0 16 16"
			width="16"
			xmlns="http://www.w3.org/2000/svg"
		>
			<g fill="currentColor">
				<path
					d="M8,0a8,8,0,1,0,8,8A8,8,0,0,0,8,0ZM8,14a6,6,0,1,1,6-6A6,6,0,0,1,8,14Z"
				></path>
				<path
					d="M10.83,5.17a1,1,0,0,0-1.41,0L8,6.59,6.59,5.17A1,1,0,0,0,5.17,6.59L6.59,8,5.17,9.41a1,1,0,1,0,1.41,1.41L8,9.41l1.41,1.41a1,1,0,0,0,1.41-1.41L9.41,8l1.41-1.41A1,1,0,0,0,10.83,5.17Z"
				></path>
			</g>
		</svg>
	</span>
	<span class="rvt-inline-alert__message" id={dangerAlertMessageId}
		>Your Description has special characters that need to be replaced.</span
	>
</div>

<!-- Info -->
<label class="rvt-label [ rvt-m-top-md ]" for={infoTextareaId}>Textarea</label>
<textarea class="rvt-textarea rvt-validation-info" id={infoTextareaId}
></textarea>
<div class="rvt-inline-alert rvt-inline-alert--info">
	<span class="rvt-inline-alert__icon">
		<svg
			aria-hidden="true"
			height="16"
			viewBox="0 0 16 16"
			width="16"
			xmlns="http://www.w3.org/2000/svg"
		>
			<g fill="currentColor">
				<path
					d="M8,16a8,8,0,1,1,8-8A8,8,0,0,1,8,16ZM8,2a6,6,0,1,0,6,6A6,6,0,0,0,8,2Z"
				></path>
				<path d="M8,12a1,1,0,0,1-1-1V8A1,1,0,0,1,9,8v3A1,1,0,0,1,8,12Z"></path>
				<circle cx="8" cy="5" r="1"></circle>
			</g>
		</svg>
	</span>
	<span class="rvt-inline-alert__message" id={infoAlertMessageId}
		>Add a Message to give users more information.</span
	>
</div>
