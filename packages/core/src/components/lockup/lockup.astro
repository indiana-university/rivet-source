<style>
	.resize {
		display: grid;
		gap: var(--rvt-size-24);
		grid-auto-columns: minmax(0, 1fr);
		grid-auto-flow: column;
		overflow: auto;
		padding: var(--rvt-size-8);
		resize: horizontal;

		> div {
			display: flex;
			flex-direction: column;
			gap: var(--rvt-size-24);
		}
	}
</style>
