		<rvt-lockup type="campus">
			<a href="/">
				<span>Indiana University</span>
				<span>South Bend</span>
			</a>
		</rvt-lockup>

		<rvt-lockup type="campus">
			<a href="/">
				<span>Indiana University</span>
				<span>Online</span>
			</a>
		</rvt-lockup>
