---
import { createId } from "../../utilities/createId.js";

export const title = "Text Input with validation alerts";

const successInputId = `text-input-success-${createId()}`;
const warningInputId = `text-input-warning-${createId()}`;
const dangerInputId = `text-input-danger-${createId()}`;
const infoInputId = `text-input-info-${createId()}`;
const successAlertMessageId = `text-input-success-alert-${createId()}`;
const warningAlertMessageId = `text-input-warning-alert-${createId()}`;
const dangerAlertMessageId = `text-input-danger-alert-${createId()}`;
const infoAlertMessageId = `text-input-info-alert-${createId()}`;
---

<!-- Success -->
<label class="rvt-label" for={successInputId}>Text Input</label>
<input
	class="rvt-text-input rvt-validation-success"
	id={successInputId}
	type="text"
/>
<div class="rvt-inline-alert rvt-inline-alert--success">
	<span class="rvt-inline-alert__icon">
		<svg
			aria-hidden="true"
			height="16"
			viewBox="0 0 16 16"
			width="16"
			xmlns="http://www.w3.org/2000/svg"
		>
			<g fill="currentColor">
				<path
					d="M10.2,5.4,7.1,9.53,5.67,8.25a1,1,0,1,0-1.34,1.5l2.05,1.82a1.29,1.29,0,0,0,.83.32h.12a1.23,1.23,0,0,0,.88-.49L11.8,6.6a1,1,0,1,0-1.6-1.2Z"
				></path>
				<path
					d="M8,0a8,8,0,1,0,8,8A8,8,0,0,0,8,0ZM8,14a6,6,0,1,1,6-6A6,6,0,0,1,8,14Z"
				></path>
			</g>
		</svg>
	</span>
	<span class="rvt-inline-alert__message" id={successAlertMessageId}
		>First name is valid!</span
	>
</div>

<!-- Warning -->
<label class="rvt-label [ rvt-m-top-md ]" for={warningInputId}>Text Input</label
>
<input
	class="rvt-text-input rvt-validation-warning"
	id={warningInputId}
	type="text"
/>
<div class="rvt-inline-alert rvt-inline-alert--warning">
	<span class="rvt-inline-alert__icon">
		<svg
			aria-hidden="true"
			height="16"
			viewBox="0 0 16 16"
			width="16"
			xmlns="http://www.w3.org/2000/svg"
		>
			<g fill="currentColor">
				<path d="M11,9H5A1,1,0,0,1,5,7h6a1,1,0,0,1,0,2Z"></path>
				<path
					d="M8,16a8,8,0,1,1,8-8A8,8,0,0,1,8,16ZM8,2a6,6,0,1,0,6,6A6,6,0,0,0,8,2Z"
				></path>
			</g>
		</svg>
	</span>
	<span class="rvt-inline-alert__message" id={warningAlertMessageId}
		>Your Password is weak.</span
	>
</div>

<!-- Danger -->
<label class="rvt-label [ rvt-m-top-md ]" for={dangerInputId}>Text Input</label>
<input
	class="rvt-text-input rvt-validation-danger"
	id={dangerInputId}
	type="text"
/>
<div class="rvt-inline-alert rvt-inline-alert--danger">
	<span class="rvt-inline-alert__icon">
		<svg
			aria-hidden="true"
			height="16"
			viewBox="0 0 16 16"
			width="16"
			xmlns="http://www.w3.org/2000/svg"
		>
			<g fill="currentColor">
				<path
					d="M8,0a8,8,0,1,0,8,8A8,8,0,0,0,8,0ZM8,14a6,6,0,1,1,6-6A6,6,0,0,1,8,14Z"
				></path>
				<path
					d="M10.83,5.17a1,1,0,0,0-1.41,0L8,6.59,6.59,5.17A1,1,0,0,0,5.17,6.59L6.59,8,5.17,9.41a1,1,0,1,0,1.41,1.41L8,9.41l1.41,1.41a1,1,0,0,0,1.41-1.41L9.41,8l1.41-1.41A1,1,0,0,0,10.83,5.17Z"
				></path>
			</g>
		</svg>
	</span>
	<span class="rvt-inline-alert__message" id={dangerAlertMessageId}
		>The Username you entered is taken.</span
	>
</div>

<!-- Info -->
<label class="rvt-label [ rvt-m-top-md ]" for={infoInputId}>Text Input</label>
<input
	class="rvt-text-input rvt-validation-info"
	id={infoInputId}
	type="text"
/>
<div class="rvt-inline-alert rvt-inline-alert--info">
	<span class="rvt-inline-alert__icon">
		<svg
			aria-hidden="true"
			height="16"
			viewBox="0 0 16 16"
			width="16"
			xmlns="http://www.w3.org/2000/svg"
		>
			<g fill="currentColor">
				<path
					d="M8,16a8,8,0,1,1,8-8A8,8,0,0,1,8,16ZM8,2a6,6,0,1,0,6,6A6,6,0,0,0,8,2Z"
				></path>
				<path d="M8,12a1,1,0,0,1-1-1V8A1,1,0,0,1,9,8v3A1,1,0,0,1,8,12Z"></path>
				<circle cx="8" cy="5" r="1"></circle>
			</g>
		</svg>
	</span>
	<span class="rvt-inline-alert__message" id={infoAlertMessageId}
		>The Description tells users more about this stuff.</span
	>
</div>
