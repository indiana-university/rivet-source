---
export const title = "Tabs";
---

<div class="rvt-tabs" data-rvt-tabs>
	<div
		aria-label="Rivet tabs"
		class="rvt-tabs__tablist"
		data-rvt-tablist
		role="tablist"
	>
		<button class="rvt-tabs__tab" data-rvt-tab type="button">Tab one</button>
		<button class="rvt-tabs__tab" data-rvt-tab="remove-me" type="button"
			>Tab two</button
		>
		<button class="rvt-tabs__tab" data-rvt-tab type="button">Tab three</button>
		<button class="rvt-tabs__tab" data-rvt-tab="tab-four" type="button"
			>Tab four</button
		>
	</div>
	<div class="rvt-tabs__panel" data-rvt-tab-panel>
		<span class="rvt-ts-23 rvt-text-bold"
			>Become the best version of yourself at IU</span
		>
		<p>
			Develop the skills you need for a rewarding career, and follow in the
			footsteps of more than 729,000 IU alumni who are leading organizations,
			innovating the future, and making an impact on their communities and the
			world.
		</p>
	</div>
	<div class="rvt-tabs__panel" data-rvt-tab-panel="remove-me">
		<span class="rvt-ts-23 rvt-text-bold">Find your calling</span>
		<p>
			IU offers more than 2,300 different programs of study. Not sure what to
			focus on? No problem. Browse by interest area to find options you'd enjoy
			pursuing.
		</p>
	</div>
	<div class="rvt-tabs__panel" data-rvt-tab-panel data-rvt-tab-init>
		<span class="rvt-ts-23 rvt-text-bold"
			>Pursue your passion or explore the possibilities</span
		>
		<p>
			From nursing to criminal justice, epidemiology to environmental science,
			social work to cybersecurity, and more than 900 academic programs in
			between, IU gives you the power to study whatever sparks your interest,
			with the support of world-class professors and faculty who care about your
			success.
		</p>
	</div>
	<div class="rvt-tabs__panel" data-rvt-tab-panel="tab-four">
		<span class="rvt-ts-23 rvt-text-bold"
			>Find your ideal campus life at IU</span
		>
		<p>
			Each of our nine campuses offers a welcoming, inclusive environment that
			feels like home, whatever your background, interests, or goals. Whether
			you want a Big Ten college experience, the dynamic pace of an urban
			research university, the community feeling of a regional campus close to
			home, or the flexibility of a fully online degree program, you’ll find it
			at IU.
		</p>
	</div>
</div>

<button class="rvt-button rvt-m-top-xl" data-add-tab type="button"
	>Add tab</button
>
<button
	class="rvt-button rvt-button--strong rvt-m-left-sm"
	data-remove-tab
	type="button"
>
	Remove tab two
</button>
<button class="rvt-button rvt-m-left-sm" data-activate-named-tab type="button">
	Activate tab four by ID
</button>
<button
	class="rvt-button rvt-m-left-sm"
	data-activate-indexed-tab
	type="button"
>
	Activate tab one by index
</button>
<button
	class="rvt-button rvt-button--strong rvt-m-left-sm"
	data-remove-indexed-tab
	type="button"
>
	Remove tab three by index
</button>

<script>
	const tabs = document.querySelector("[data-rvt-tabs]");

	document
		.querySelector("[data-add-tab]")
		.addEventListener("click", (event) => {
			const addedTab = tabs.addTab("New tab");
			addedTab.panel.innerHTML = `<h2>This is a new tab</h2><p>It's pretty great!</p>`;
		});

	document
		.querySelector("[data-remove-tab]")
		.addEventListener("click", (event) => {
			tabs.removeTab("remove-me");
			event.target.disabled = true;
		});

	document
		.querySelector("[data-activate-named-tab]")
		.addEventListener("click", (event) => {
			tabs.activateTab("tab-four");
		});

	document
		.querySelector("[data-activate-indexed-tab]")
		.addEventListener("click", (event) => {
			tabs.activateTab(0);
		});

	document
		.querySelector("[data-remove-indexed-tab]")
		.addEventListener("click", (event) => {
			tabs.removeTab(2);
			event.target.disabled = true;
		});

	document.addEventListener("rvtTabAdded", (event) => console.log(event));
	document.addEventListener("rvtTabRemoved", (event) => console.log(event));
</script>
