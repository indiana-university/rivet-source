---
import Footer from "./footer.astro";
export const title = "Footer";

const { label } = Astro.props;
---

<Footer label={`bare ${label}`} />

<div class="rvt-m-top-lg">
	<Footer social label={`social ${label}`} />
</div>

<div class="rvt-m-top-lg">
	<Footer resources label={`resources ${label}`} />
</div>

<div class="rvt-m-top-lg">
	<Footer resources social label={`social and resources ${label}`} />
</div>
