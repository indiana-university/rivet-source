---
import Footer from "./footer.astro";
export const title = "Footer";

const { label } = Astro.props;
---

<Footer label={`bare ${label}`} />

<div class="rvt-m-top-lg">
	<Footer label={`social ${label}`} social />
</div>

<div class="rvt-m-top-lg">
	<Footer label={`resources ${label}`} resources />
</div>

<div class="rvt-m-top-lg">
	<Footer label={`social and resources ${label}`} resources social />
</div>
