---
import FooterResources from "./footer-resources.astro";
import FooterSocial from "./footer-social.astro";
import FooterLegal from "./footer-legal.astro";
const { crimson, resources, social } = Astro.props;
const label = Astro.props.label ? `Site (${Astro.props.label})` : "Site";
---

<footer
	aria-label={label}
	class:list={["rvt-footer", { "rvt-theme-crimson": crimson }]}
>
	<div class="rvt-container">
		{resources && <FooterResources />}
		{social && <FooterSocial />}
		<FooterLegal />
	</div>
</footer>
