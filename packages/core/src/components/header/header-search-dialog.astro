---
import { createId } from "../../utilities/createId.js";

const dialogId = Astro.props.dialogId ?? `search-dialog-${createId()}`;
const searchInputId = Astro.props.searchInputId ?? `search-query-${createId()}`;
---

<div
	class="rvt-header__search-bar"
	aria-label="search"
	id={dialogId}
	role="dialog"
	tabindex="-1"
	data-rvt-dialog={dialogId}
	data-rvt-dialog-modal=""
	data-rvt-dialog-disable-page-interaction=""
	hidden
>
	<div class="rvt-header__search-bar-inner">
		<form class="rvt-container">
			<label for={searchInputId} class="rvt-label rvt-sr-only"
				>Search the site</label
			>
			<div class="rvt-input-group [ rvt-m-top-none rvt-gap-xs ]">
				<div
					class="rvt-input-group__prepend [ rvt-p-all-sm rvt-flex rvt-items-center rvt-justify-center rvt-color-crimson-500 ]"
				>
					<rvt-icon name="magnifying-glass"></rvt-icon>
				</div>
				<input
					class="rvt-text-input rvt-input-group__input [ rvt-border-all-none ]"
					name="search"
					placeholder="Search the site"
					type="text"
					id={searchInputId}
				/>
				<div class="rvt-input-group__append [ rvt-flex rvt-gap-xs ]">
					<button class="rvt-button rvt-button--strong" type="submit">
						<span>Search</span>
					</button>
					<button
						class="rvt-button rvt-sr-only rvt-focusable"
						data-rvt-dialog-close={dialogId}
						type="button"
					>
						Close search
					</button>
				</div>
			</div>
		</form>
	</div>
</div>
