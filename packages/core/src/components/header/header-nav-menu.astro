---
const list = [
	["Academics"],
	["Admissions"],
	[
		"Cost &amp; Financial Aid",
		"page",
		["Cost of Attendance", "Financial Aid", "Scholarships"],
	],
	["Research"],
	["Student Support"],
	["Campus Life"],
	["About"],
	["Alumni and Giving"],
];
---

<nav class="rvt-header-menu" data-rvt-priority-nav>
	<ul class="rvt-header-menu__list" data-rvt-priority-nav-links>
		{
			list.map(([label, current, children = []]: any) => (
				<li
					class="rvt-header-menu__item"
					data-rvt-dropdown-open-on-hover={!!children.length}
				>
					<a
						aria-current={current}
						class="rvt-header-menu__link"
						href="#"
						set:html={label}
					/>
					{!!children.length && (
						<div class="rvt-dropdown" data-rvt-dropdown>
							<button data-rvt-dropdown-toggle>
								<svg
									aria-hidden="true"
									fill="currentColor"
									focusable="false"
									height="16"
									viewBox="0 0 16 16"
									width="16"
									xmlns="http://www.w3.org/2000/svg"
								>
									<path d="m15.146 6.263-1.292-1.526L8 9.69 2.146 4.737.854 6.263 8 12.31l7.146-6.047Z" />
								</svg>
							</button>
							<div class="rvt-dropdown__menu" data-rvt-dropdown-menu hidden>
								<ul>
									{children.map((childLabel: String) => (
										<li>
											<a href="#">{childLabel}</a>
										</li>
									))}
								</ul>
							</div>
						</div>
					)}
				</li>
			))
		}
	</ul>
</nav>
