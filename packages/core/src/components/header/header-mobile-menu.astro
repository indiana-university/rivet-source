---
import { createId } from "../../utilities/createId.js";

const dialogId = Astro.props.dialogId ?? `mobile-menu-${createId()}`;
const labelId = `sidenav-label-${createId()}`;
const dialogTitleId = `mobile-menu-title-${createId()}`;
const dialogDescriptionId = `mobile-menu-description-${createId()}`;
---

<div
	aria-describedby={dialogDescriptionId}
	aria-labelledby={dialogTitleId}
	class="rvt-header__mobile-menu"
	data-rvt-dialog={dialogId}
	data-rvt-dialog-darken-page
	data-rvt-dialog-disable-page-interaction
	data-rvt-dialog-modal
	hidden
	id={dialogId}
	role="dialog"
	tabindex="-1"
>
	<nav aria-labelledby={labelId} class="rvt-sidenav" data-rvt-sidenav>
		<span class="rvt-sidenav__label [ rvt-p-left-sm ]" id={labelId}>
			Site navigation <span class="rvt-sr-only">({Astro.props.label})</span>
		</span>
		<ul class="rvt-sidenav__list [ rvt-p-top-xs ]">
			<li class="rvt-sidenav__item">
				<a class="rvt-sidenav__link" href="#">Section nav one</a>
			</li>
			<li class="rvt-sidenav__item">
				<a aria-current="page" class="rvt-sidenav__link" href="#"
					>Section nav two</a
				>
			</li>
			<li class="rvt-sidenav__item">
				<div class="rvt-sidenav__item-wrapper">
					<a class="rvt-sidenav__link" href="#">Section nav three</a>
					<button
						class="rvt-sidenav__toggle"
						data-rvt-sidenav-toggle
						type="button"
					>
						<span class="rvt-sr-only">Show more section nav three links</span>
						<svg
							fill="currentColor"
							height="16"
							viewBox="0 0 16 16"
							width="16"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								d="m15.146 6.263-1.292-1.526L8 9.69 2.146 4.737.854 6.263 8 12.31l7.146-6.047Z"
							></path>
						</svg>
					</button>
				</div>
				<ul class="rvt-sidenav__list" data-rvt-sidenav-list>
					<li class="rvt-sidenav__item">
						<a class="rvt-sidenav__link" href="#">Level two</a>
					</li>
					<li class="rvt-sidenav__item">
						<a class="rvt-sidenav__link" href="#">Level two</a>
					</li>
					<li class="rvt-sidenav__item">
						<div class="rvt-sidenav__item-wrapper">
							<a class="rvt-sidenav__link" href="#">Level two</a>
							<button
								class="rvt-sidenav__toggle"
								data-rvt-sidenav-toggle
								type="button"
							>
								<span class="rvt-sr-only">Show more level two links</span>
								<svg
									fill="currentColor"
									height="16"
									viewBox="0 0 16 16"
									width="16"
									xmlns="http://www.w3.org/2000/svg"
								>
									<path
										d="m15.146 6.263-1.292-1.526L8 9.69 2.146 4.737.854 6.263 8 12.31l7.146-6.047Z"
									></path>
								</svg>
							</button>
						</div>
						<ul class="rvt-sidenav__list" data-rvt-sidenav-list>
							<li class="rvt-sidenav__item">
								<a class="rvt-sidenav__link" href="#">Level three</a>
							</li>
							<li class="rvt-sidenav__item">
								<a class="rvt-sidenav__link" href="#">Level three</a>
							</li>
						</ul>
					</li>
				</ul>
			</li>
		</ul>
	</nav>

	<button
		aria-label="Toggle menu"
		class="rvt-header__button rvt-header__button--mobile-menu-close"
		data-rvt-dialog-close={dialogId}
		role="button"
		type="button"
	>
		<svg
			aria-hidden="true"
			fill="currentColor"
			focusable="false"
			height="16"
			viewBox="0 0 16 16"
			width="16"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path
				d="m3.5 2.086 4.5 4.5 4.5-4.5L13.914 3.5 9.414 8l4.5 4.5-1.414 1.414-4.5-4.5-4.5 4.5L2.086 12.5l4.5-4.5-4.5-4.5L3.5 2.086Z"
			></path>
		</svg>
	</button>
</div>
