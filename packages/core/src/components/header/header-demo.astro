---
import Lockup from "../lockup/lockup.astro";
import MobileMenu from "./header-mobile-menu.astro";
import SearchDialog from "./header-search-dialog.astro";
---

<header data-site-header class="rvt-header rvt-theme-light">
	<a class="rvt-skip-link" href="#main-content">Skip to main content</a>
	<div class="rvt-header__inner">
		<Lockup />
		<!-- Menu slot -->
		<div class="rvt-header__controls">
			<nav class="rvt-header-menu" data-rvt-priority-nav>
				<ul class="rvt-header-menu__list" data-rvt-priority-nav-links>
					<li class="rvt-header-menu__item">
						<a class="rvt-header-menu__link" href="#">Academics</a>
					</li>
					<li class="rvt-header-menu__item">
						<a class="rvt-header-menu__link" href="#">Admissions</a>
					</li>
					<li class="rvt-header-menu__item" data-rvt-dropdown-open-on-hover>
						<a class="rvt-header-menu__link" aria-current="page" href="#"
							>Cost &amp; Financial Aid</a
						>
						<div class="rvt-dropdown" data-rvt-dropdown="about-dropdown">
							<button data-rvt-dropdown-toggle>
								<svg
									aria-hidden="true"
									fill="currentColor"
									focusable="false"
									height="16"
									viewBox="0 0 16 16"
									width="16"
									xmlns="http://www.w3.org/2000/svg"
								>
									<path
										d="m15.146 6.263-1.292-1.526L8 9.69 2.146 4.737.854 6.263 8 12.31l7.146-6.047Z"
									></path>
								</svg>
							</button>
							<div class="rvt-dropdown__menu" data-rvt-dropdown-menu hidden>
								<ul>
									<li><a href="#">Item one</a></li>
									<li><a href="#">Item two</a></li>
									<li><a href="#">Item three</a></li>
								</ul>
							</div>
						</div>
					</li>
					<li class="rvt-header-menu__item">
						<a class="rvt-header-menu__link" href="#">Research</a>
					</li>
					<li class="rvt-header-menu__item">
						<a class="rvt-header-menu__link" href="#">Student Support</a>
					</li>
					<li class="rvt-header-menu__item" data-rvt-dropdown-open-on-hover>
						<a class="rvt-header-menu__link" href="#">About</a>
						<div class="rvt-dropdown" data-rvt-dropdown="about-dropdown">
							<button data-rvt-dropdown-toggle>
								<svg
									aria-hidden="true"
									fill="currentColor"
									focusable="false"
									height="16"
									viewBox="0 0 16 16"
									width="16"
									xmlns="http://www.w3.org/2000/svg"
								>
									<path
										d="m15.146 6.263-1.292-1.526L8 9.69 2.146 4.737.854 6.263 8 12.31l7.146-6.047Z"
									></path>
								</svg>
							</button>
							<div class="rvt-dropdown__menu" data-rvt-dropdown-menu hidden>
								<ul>
									<li><a href="#">About item one</a></li>
									<li><a href="#">About item two</a></li>
									<li><a href="#">About item three</a></li>
								</ul>
							</div>
						</div>
					</li>
					<li class="rvt-header-menu__item">
						<a class="rvt-header-menu__link" href="#">Campus life</a>
					</li>
					<li class="rvt-header-menu__item">
						<a class="rvt-header-menu__link" href="#">Alumni and Giving</a>
					</li>
				</ul>
			</nav>
		</div>

		<div class="rvt-header__buttons">
			<button
				data-rvt-dialog-trigger="mobile-menu"
				aria-label="Toggle menu"
				class="rvt-header__button rvt-header__button--mobile-menu"
			>
				<svg
					aria-hidden="true"
					fill="currentColor"
					focusable="false"
					height="16"
					viewBox="0 0 16 16"
					width="16"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path d="M15 4H1V2h14v2Zm0 5H1V7h14v2ZM1 14h14v-2H1v2Z"></path>
				</svg>
			</button>
			<button class="rvt-header__button" data-rvt-dialog-trigger="search-bar">
				<svg
					aria-hidden="true"
					fill="currentColor"
					focusable="false"
					height="16"
					viewBox="0 0 16 16"
					width="16"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						d="M7 2a5 5 0 1 0 0 10A5 5 0 0 0 7 2ZM0 7a7 7 0 1 1 12.606 4.192l3.101 3.1-1.414 1.415-3.1-3.1A7 7 0 0 1 0 7Z"
					></path>
				</svg>
			</button>
			<!--
        TODO: the "rvt-header__buttons" element allows multiple
        buttons in addition to the search and mobile menu buttons.
        For example and "Apply" CTA. This needs a bit more thought
        and design work to figure out a smaller size for CTA buttons,
        mobile behavior, etc.
      -->

			<!-- <a href="#" class="rvt-button rvt-button--cta rvt-button--strong">Visit</a>
      <a href="#" class="rvt-button rvt-button--cta">Apply</a> -->
		</div>
	</div>
	<!-- end header__inner -->
</header>
<!-- Mobile navigation and search includes -->
<MobileMenu />
<SearchDialog />
