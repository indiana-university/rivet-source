---
import { createId } from "../../utilities/createId.js";
import Lockup from "../lockup/lockup.astro";
import MobileMenu from "./header-mobile-menu.astro";
import NavMenu from "./header-nav-menu.astro";
import SearchDialog from "./header-search-dialog.astro";

export const title = "Header with nav and search";

const { theme } = Astro.props;
const crimsonTheme = theme === "crimson";
const label = Astro.props.label ? `Site (${Astro.props.label})` : "Site";
const mobileMenuDialogId = `mobile-menu-${createId()}`;
const searchDialogId = `search-dialog-${createId()}`;
---

<header
	class:list={["rvt-header", { "rvt-theme-crimson": crimsonTheme }]}
	aria-label={label}
>
	<a class="rvt-skip-link" href="#main-content">Skip to main content</a>
	<div class="rvt-header__inner">
		<Lockup />
		<div class="rvt-header__controls">
			<NavMenu {...Astro.props} />
		</div>
		<div class="rvt-header__buttons">
			<button
				class="rvt-button rvt-button--medium rvt-button--icon-only rvt-header__button--mobile-menu"
				data-rvt-dialog-trigger={mobileMenuDialogId}
				type="button"
			>
				<rvt-icon name="menu"></rvt-icon>
				<span class="rvt-sr-only">Menu</span>
			</button>
			<button
				class="rvt-button rvt-button--medium rvt-button--icon-only"
				data-rvt-dialog-trigger={searchDialogId}
				type="button"
			>
				<rvt-icon name="magnifying-glass"></rvt-icon>
				<span class="rvt-sr-only">Search</span>
			</button>
		</div>
	</div>
</header>
<MobileMenu {...Astro.props} dialogId={mobileMenuDialogId} />
<SearchDialog dialogId={searchDialogId} />
