---
import ImageHub from "./image-hub.astro";
export const title = "Image Hub with three images";
---

<div>
	<ImageHub caption="Landscape start" type="landscape-start" />
</div>
<div class="rvt-m-top-xxl">
	<ImageHub caption="Landscape end" type="landscape-end" />
</div>
<div class="rvt-m-top-xxl">
	<ImageHub caption="Portrait start" type="portrait-start" />
</div>
<div class="rvt-m-top-xxl">
	<ImageHub caption="Portrait end" type="portrait-end" />
</div>
