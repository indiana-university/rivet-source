---
import { createId } from "../../utilities/createId.js";

export const title = "File Input - Multiple";

const fileInputId = `multiple-file-input-${createId()}`;
const fileDescriptionId = `file-description-two-${createId()}`;
---

<div class="rvt-file" data-rvt-file-input={fileInputId}>
	<input
		aria-describedby={fileDescriptionId}
		data-rvt-file-input-button={fileInputId}
		id={fileInputId}
		multiple
		type="file"
	/>
	<label for={fileInputId}>
		<span>Upload multiple files</span>
		<rvt-icon name="file"></rvt-icon>
	</label>
	<div
		class="rvt-file__preview"
		data-rvt-file-input-preview={fileInputId}
		id={fileDescriptionId}
	>
		No files selected
	</div>
</div>
