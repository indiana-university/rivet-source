---
import { createId } from "../../utilities/createId.js";

export const title = "File Input";

const fileInputId = `single-file-input-${createId()}`;
const fileDescriptionId = `file-description-${createId()}`;
---

<div class="rvt-file" data-rvt-file-input={fileInputId}>
	<input
		aria-describedby={fileDescriptionId}
		data-rvt-file-input-button={fileInputId}
		id={fileInputId}
		type="file"
	/>
	<label class="rvt-button" for={fileInputId}>
		<span>Upload a file</span>
		<svg
			aria-hidden="true"
			height="16"
			viewBox="0 0 16 16"
			width="16"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path
				d="M10.41,1H3.5A1.3,1.3,0,0,0,2.2,2.3V13.7A1.3,1.3,0,0,0,3.5,15h9a1.3,1.3,0,0,0,1.3-1.3V4.39ZM11.8,5.21V6H9.25V3h.34ZM4.2,13V3h3V6.75A1.25,1.25,0,0,0,8.5,8h3.3v5Z"
				fill="currentColor"></path>
		</svg>
	</label>
	<div
		class="rvt-file__preview"
		data-rvt-file-input-preview={fileInputId}
		id={fileDescriptionId}
	>
		No file selected
	</div>
</div>
