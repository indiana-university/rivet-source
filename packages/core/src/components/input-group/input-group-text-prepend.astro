---
import { createId } from "../../utilities/createId.js";

export const title = "Input with text, prepend";

const inputId = `text-prepend-example-${createId()}`;
const textId = `website-text-${createId()}`;
---

<label for={inputId} class="rvt-sr-only">Website</label>
<div class="rvt-input-group">
	<div class="rvt-input-group__prepend">
		<div class="rvt-input-group__text" id={textId}>https://</div>
	</div>
	<input
		class="rvt-text-input rvt-input-group__input"
		type="text"
		id={inputId}
		aria-describedby={textId}
	/>
</div>
