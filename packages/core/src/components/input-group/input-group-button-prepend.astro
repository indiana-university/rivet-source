---
import { createId } from "../../utilities/createId.js";

export const title = "Input with button, prepend";

const dropdownId = `dropdown-navigation-${createId()}`;
const inputId = `segmented-prepend-${createId()}`;
---

<label class="rvt-label" for={inputId} rvt-util="sr-only">
	Add new
</label>
<div class="rvt-input-group">
	<div class="rvt-input-group__prepend">
		<div class="rvt-dropdown" data-rvt-dropdown={dropdownId}>
			<rvt-button>
				<button
					aria-expanded="false"
					data-rvt-dropdown-toggle={dropdownId}
					type="button"
				>
					All stuff
					<rvt-icon name="chevron-down"></rvt-icon>
				</button>
			</rvt-button>
			<div
				class="rvt-dropdown__menu"
				data-rvt-dropdown-menu
				hidden
				id={dropdownId}
				role="menu"
			>
				<a href="#">Item one</a>
				<a href="#">Item two</a>
				<a aria-current="page" href="#">
					Item three
				</a>
				<div aria-label="Related" role="group">
					<a href="#">Related item one</a>
					<a href="#">Related item two</a>
				</div>
			</div>
		</div>
	</div>
	<input
		class="rvt-text-input rvt-input-group__input"
		id={inputId}
		type="text"
	/>
</div>
