---
import { createId } from "../../utilities/createId.js";

export const title = "Input with button, prepend";

const dropdownId = `dropdown-navigation-${createId()}`;
const inputId = `segmented-prepend-${createId()}`;
---

<label class="rvt-label rvt-sr-only" for={inputId}>Add new</label>
<div class="rvt-input-group">
	<div class="rvt-input-group__prepend">
		<div class="rvt-dropdown" data-rvt-dropdown={dropdownId}>
			<button
				aria-expanded="false"
				class="rvt-button rvt-button--secondary"
				data-rvt-dropdown-toggle={dropdownId}
				type="button"
			>
				<span class="rvt-dropdown__toggle-text">All stuff</span>
				<svg
					aria-hidden="true"
					class="rvt-m-left-xs"
					height="16"
					viewBox="0 0 16 16"
					width="16"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						d="M8,12.46a2,2,0,0,1-1.52-.7L1.24,5.65a1,1,0,1,1,1.52-1.3L8,10.46l5.24-6.11a1,1,0,0,1,1.52,1.3L9.52,11.76A2,2,0,0,1,8,12.46Z"
						fill="currentColor"></path>
				</svg>
			</button>
			<div
				class="rvt-dropdown__menu"
				data-rvt-dropdown-menu
				hidden
				id={dropdownId}
				role="menu"
			>
				<a href="#">Item one</a>
				<a href="#">Item two</a>
				<a aria-current="page" href="#">Item three</a>
				<div aria-label="Related" role="group">
					<a href="#">Related item one</a>
					<a href="#">Related item two</a>
				</div>
			</div>
		</div>
	</div>
	<input
		class="rvt-text-input rvt-input-group__input"
		id={inputId}
		type="text"
	/>
</div>
