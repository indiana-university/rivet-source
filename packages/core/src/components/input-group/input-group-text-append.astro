---
import { createId } from "../../utilities/createId.js";

export const title = "Input with text, append";

const inputId = `text-append-example-${createId()}`;
const textId = `email-text-${createId()}`;
---

<label for={inputId}>Email address</label>
<div class="rvt-input-group">
	<input
		class="rvt-text-input rvt-input-group__input"
		type="text"
		id={inputId}
		aria-describedby={textId}
	/>
	<div class="rvt-input-group__append">
		<div class="rvt-input-group__text" id={textId}>@iu.edu</div>
	</div>
</div>
