---
import { example } from "./example.js";

export const title = "Drilldown";

const { menus = example } = Astro.props;
---

<rvt-drilldown>
	{menus.map((menu: any) => (
		<div
			data-rvt-drilldown-menu={menu.id}
			data-rvt-drilldown-parent={menu.parent?.id}
		>
			<header aria-label={`${menu.label} (${Astro.props.label})`}>
				{menu.parent && (
					<div class="rvt-button-group">
						{menu.depth > 1 && (
							<rvt-button size="medium">
								<button data-rvt-drilldown-open="main" type="button">
									<rvt-icon name="chevrons-left" />
									Main
								</button>
							</rvt-button>
						)}
						<rvt-button size="medium">
							<button data-rvt-drilldown-open="parent" type="button">
								<rvt-icon name="chevron-left"></rvt-icon>
								Back
							</button>
						</rvt-button>
					</div>
				)}
				<h2>
					<a href={menu.url}>{menu.label}</a>
				</h2>
			</header>
			<ul>
				{menu.items.map((item: any) => (
					<li data-rvt-drilldown-child={item.id}>
						<a
							aria-current={item.current ? "page" : null}
							href={item.url || "#"}
						>
							{item.label}
						</a>
						{item.hasChildren && (
							<rvt-button size="medium">
								<button data-rvt-drilldown-open="child" type="button">
									<rvt-sr-only>{`${item.label} menu`}</rvt-sr-only>
									<rvt-icon name="chevron-right"></rvt-icon>
								</button>
							</rvt-button>
						)}
					</li>
				))}
			</ul>
		</div>
	))}
</rvt-drilldown>
