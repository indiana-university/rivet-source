---
export const title = "Pagination";

const label = `${title} (${Astro.props.label})`;
---

<nav aria-label={label}>
	<rvt-pagination>
		<ul>
			<li>
				<a href="?page=1" rel="first">
					First
					<rvt-sr-only>page</rvt-sr-only>
				</a>
			</li>
			<li>
				<a href="?page=7" rel="prev">
					<rvt-sr-only>Previous page</rvt-sr-only>
				</a>
			</li>
			<li>
				<a href="?page=6">
					<rvt-sr-only>Page</rvt-sr-only> 6
				</a>
			</li>
			<li>
				<a href="?page=7">
					<rvt-sr-only>Page</rvt-sr-only> 7
				</a>
			</li>
			<li>
				<a aria-current="page" href="?page=8">
					<rvt-sr-only>Page</rvt-sr-only> 8
				</a>
			</li>
			<li>
				<a href="?page=9">
					<rvt-sr-only>Page</rvt-sr-only> 9
				</a>
			</li>
			<li>
				<a href="?page=10">
					<rvt-sr-only>Page</rvt-sr-only> 10
				</a>
			</li>
			<li>
				<a href="?page=9" rel="next">
					<rvt-sr-only>Next page</rvt-sr-only>
				</a>
			</li>
			<li>
				<a href="?page=14" rel="last">
					Last
					<rvt-sr-only>page</rvt-sr-only>
				</a>
			</li>
		</ul>
	</rvt-pagination>
</nav>
