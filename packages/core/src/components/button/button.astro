---
export const title = "Button";

const rows = [
	{
		label: "Strong / Extra Large",
		props: { size: "extra-large", tone: "strong" },
	},
	{ label: "Strong / Large", props: { tone: "strong" } },
	{ label: "Strong / Medium", props: { size: "medium", tone: "strong" } },
	{ label: "Strong / Small", props: { size: "small", tone: "strong" } },
	{ label: "Normal / Extra Large", props: { size: "extra-large" } },
	{ label: "Normal / Large", props: {} },
	{ label: "Normal / Medium", props: { size: "medium" } },
	{ label: "Normal / Small", props: { size: "small" } },
	{
		label: "Subtle / Extra Large",
		props: { size: "extra-large", tone: "subtle" },
	},
	{ label: "Subtle / Large", props: { tone: "subtle" } },
	{ label: "Subtle / Medium", props: { size: "medium", tone: "subtle" } },
	{ label: "Subtle / Small", props: { size: "small", tone: "subtle" } },
];
---

<table class="rvt-table">
	<thead>
		<tr>
			<th scope="col"></th>
			<th scope="col">Text</th>
			<th scope="col">Icon text</th>
			<th scope="col">Icon only</th>
			<th scope="col">Pressed</th>
			<th scope="col">Disabled</th>
		</tr>
	</thead>
	<tbody>
		{rows.map((row) => (
			<tr>
				<th scope="row">{row.label}</th>
				<td>
					<rvt-button {...row.props}>
						<button type="button">Button</button>
					</rvt-button>
				</td>
				<td>
					<rvt-button {...row.props}>
						<button type="button">
							<rvt-icon name="plus"></rvt-icon>
							Button
						</button>
					</rvt-button>
				</td>
				<td>
					<rvt-button {...row.props}>
						<button type="button">
							<rvt-icon name="plus"></rvt-icon>
							<rvt-sr-only>Button</rvt-sr-only>
						</button>
					</rvt-button>
				</td>
				<td>
					<rvt-button {...row.props}>
						<button aria-pressed="true" type="button">
							Button
						</button>
					</rvt-button>
				</td>
				<td>
					<rvt-button {...row.props}>
						<button disabled type="button">
							Button
						</button>
					</rvt-button>
				</td>
			</tr>
		))}
	</tbody>
</table>
