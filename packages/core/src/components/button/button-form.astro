---
export const title = "Form Button";
---

<table class="rvt-table">
	<thead>
		<tr>
			<th scope="col"></th>
			<th scope="col">Text</th>
			<th scope="col">Icon text</th>
			<th scope="col">Icon only</th>
			<th scope="col">Pressed</th>
			<th scope="col">Disabled</th>
		</tr>
	</thead>
	<tbody>
		<tr>
			<th scope="row">Strong / Large</th>
			<td>
				<button class="rvt-button rvt-button--strong" type="button">
					Button
				</button>
			</td>
			<td>
				<button class="rvt-button rvt-button--strong" type="button">
					<rvt-icon name="plus"></rvt-icon>
					Button
				</button>
			</td>
			<td>
				<button
					class="rvt-button rvt-button--strong rvt-button--icon-only"
					type="button"
				>
					<rvt-icon name="plus"></rvt-icon>
					<span class="rvt-sr-only">Button</span>
				</button>
			</td>
			<td>
				<button
					aria-pressed="true"
					class="rvt-button rvt-button--strong"
					type="button"
				>
					Button
				</button>
