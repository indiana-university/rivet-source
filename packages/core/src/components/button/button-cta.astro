---
export const title = "Call-to-Action Button";

const rows = [
	{ label: "Strong / Large", props: { type: "strong" } },
	{ label: "Strong / Medium", props: { size: "medium", type: "strong" } },
	{ label: "Strong / Small", props: { size: "small", type: "strong" } },
	{ label: "Normal / Large", props: {} },
	{ label: "Normal / Medium", props: { size: "medium" } },
	{ label: "Normal / Small", props: { size: "small" } },
	{ label: "Subtle / Large", props: { type: "subtle" } },
	{ label: "Subtle / Medium", props: { size: "medium", type: "subtle" } },
	{ label: "Subtle / Small", props: { size: "small", type: "subtle" } },
];
---

<table class="rvt-table">
	<thead>
		<tr>
			<th scope="col"></th>
			<th scope="col">In-page link</th>
			<th scope="col">Internal link</th>
			<th scope="col">External link</th>
			<th scope="col">Disabled link</th>
		</tr>
	</thead>
	<tbody>
		{rows.map((row) => (
			<tr>
				<th scope="row">{row.label}</th>
				<td>
					<rvt-button {...row.props}>
						<a href="#">Call to action</a>
					</rvt-button>
				</td>
				<td>
					<rvt-button {...row.props}>
						<a href="/">Call to action</a>
					</rvt-button>
				</td>
				<td>
					<rvt-button {...row.props}>
						<a href="https://rivet.iu.edu">Call to action</a>
					</rvt-button>
				</td>
				<td>
					<rvt-button {...row.props}>
						<a>Call to action</a>
					</rvt-button>
				</td>
			</tr>
		))}
	</tbody>
</table>
