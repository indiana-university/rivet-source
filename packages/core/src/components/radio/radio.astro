---
import { createId } from "../../utilities/createId.js";

export const title = "Radio";

const radioOneId = `radio-one-${createId()}`;
const radioTwoId = `radio-two-${createId()}`;
const radioThreeId = `radio-three-${createId()}`;
const radioFourId = `radio-four-${createId()}`;
const radioDescriptionId = `radio-description-${createId()}`;
---

<fieldset class="rvt-fieldset">
	<legend>Radio group</legend>
	<ul class="rvt-list-plain">
		<li>
			<div class="rvt-radio">
				<input type="radio" name="radio-group-1" id={radioOneId} />
				<label for={radioOneId}>Option one</label>
			</div>
		</li>
		<li>
			<div class="rvt-radio">
				<input type="radio" name="radio-group-1" id={radioTwoId} />
				<label for={radioTwoId}>Option two</label>
			</div>
		</li>
		<li>
			<div class="rvt-radio">
				<input
					type="radio"
					name="radio-group-1"
					id={radioThreeId}
					checked
					disabled
				/>
				<label for={radioThreeId}>Option three</label>
			</div>
		</li>
		<li>
			<div class="rvt-radio">
				<input
					type="radio"
					name="radio-group-1"
					id={radioFourId}
					aria-describedby={radioDescriptionId}
				/>
				<label for={radioFourId}>Option one</label>
				<div id={radioDescriptionId} class="rvt-radio__description">
					This is a description for the radio button.
				</div>
			</div>
		</li>
	</ul>
</fieldset>
