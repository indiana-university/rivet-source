---
import { createId } from "../../utilities/createId.js";

export const title = "Inline Alert";

const defaultAlertMessageId = `inline-alert-default-${createId()}`;
const successAlertMessageId = `inline-alert-success-${createId()}`;
const warningAlertMessageId = `inline-alert-warning-${createId()}`;
const errorAlertMessageId = `inline-alert-error-${createId()}`;
---

<!-- Default -->
<div
	aria-labelledby={defaultAlertMessageId}
	class="rvt-alert rvt-alert--medium rvt-alert--info"
	data-rvt-alert="info"
	role="alert"
>
	<p class="rvt-alert__message" id={defaultAlertMessageId}>
		This system will be unavailable on August 1st due to scheduled system
		maintenance. Please check back on August 2nd.
	</p>
</div>

<!-- Success -->
<div
	aria-labelledby={successAlertMessageId}
	class="rvt-alert rvt-alert--medium rvt-alert--success [ rvt-m-top-md ]"
	data-rvt-alert="success"
	role="alert"
>
	<p class="rvt-alert__message" id={successAlertMessageId}>
		We have received your application. Check your email in a few weeks to find
		out if you’ve been admitted.
	</p>
</div>

<!-- Warning -->
<div
	aria-labelledby={warningAlertMessageId}
	class="rvt-alert rvt-alert--medium rvt-alert--warning [ rvt-m-top-md ]"
	data-rvt-alert="warning"
	role="alert"
>
	<p class="rvt-alert__message" id={warningAlertMessageId}>
		Your changes have not been saved. To save your changes, click ‘Save my
		changes’ or click ‘Cancel’ to exit without saving.
	</p>
</div>

<!-- Error -->
<div
	aria-labelledby={errorAlertMessageId}
	class="rvt-alert rvt-alert--medium rvt-alert--danger [ rvt-m-top-md ]"
	data-rvt-alert="error"
	role="alert"
>
	<p class="rvt-alert__message" id={errorAlertMessageId}>
		The user ID and password you entered do not match. Please check your entries
		and try again.
	</p>
</div>
