---
import { createId } from "../../utilities/createId.js";

export const title = "Alert";

const defaultAlertTitleId = `default-alert-title-${createId()}`;
const infoAlertTitleId = `info-alert-title-${createId()}`;
const successAlertTitleId = `success-alert-title-${createId()}`;
const warningAlertTitleId = `warning-alert-title-${createId()}`;
const errorAlertTitleId = `error-alert-title-${createId()}`;
---

<div class="rvt-stack" style="--rvt-stack-space: var(--rvt-spacing-md)">
	<!-- Default -->
	<div
		aria-labelledby={defaultAlertTitleId}
		class="rvt-alert"
		data-rvt-alert="info"
		role="alert"
	>
		<div class="rvt-alert__title" id={defaultAlertTitleId}>Please note</div>
		<div class="rvt-alert__content">
			<p>
				Use the default alert to <a href="#">add inline notes</a> to text content.
			</p>
			<div class="rvt-button-group">
				<button
					class="rvt-button rvt-button--medium rvt-button--strong"
					type="button"
				>
					Okay
				</button>
				<button class="rvt-button rvt-button--medium" type="button">
					Dismiss
				</button>
			</div>
		</div>
		<button class="rvt-alert__dismiss" data-rvt-alert-close type="button">
			<span class="rvt-sr-only">Dismiss this alert</span>
		</button>
	</div>

	<!-- Info -->
	<div
		aria-labelledby={infoAlertTitleId}
		class="rvt-alert rvt-alert--info"
		data-rvt-alert="info"
		role="alert"
	>
		<div class="rvt-alert__title" id={infoAlertTitleId}>
			Scheduled System Maintenance
		</div>
		<div class="rvt-alert__content">
			<p>
				This system will be unavailable on August 1st due to
				<a href="#">scheduled system maintenance</a>. Please check back on
				August 2nd.
			</p>
			<ul>
				<li>
					Voluptatum, sunt assumenda incidunt asperiores architecto obcaecati
					vero!
				</li>
				<li>Architecto obcaecati vero!</li>
			</ul>
			<div class="rvt-button-group">
				<button
					class="rvt-button rvt-button--medium rvt-button--strong"
					type="button"
				>
					Okay
				</button>
				<button class="rvt-button rvt-button--medium" type="button">
					Dismiss
				</button>
			</div>
		</div>
		<button class="rvt-alert__dismiss" data-rvt-alert-close type="button">
			<span class="rvt-sr-only">Dismiss this alert</span>
		</button>
	</div>

	<!-- Success -->
	<div
		aria-labelledby={successAlertTitleId}
		class="rvt-alert rvt-alert--success"
		data-rvt-alert="success"
		role="alert"
	>
		<div class="rvt-alert__title" id={successAlertTitleId}>Thank you!</div>
		<div class="rvt-alert__content">
			<p>
				We have <a href="#">received your application</a>. Check your email in a
				few weeks to find out if you've been admitted.
			</p>
			<div class="rvt-button-group">
				<button
					class="rvt-button rvt-button--medium rvt-button--strong"
					type="button"
				>
					Okay
				</button>
				<button class="rvt-button rvt-button--medium" type="button">
					Dismiss
				</button>
			</div>
		</div>
		<button class="rvt-alert__dismiss" data-rvt-alert-close type="button">
			<span class="rvt-sr-only">Dismiss this alert</span>
		</button>
	</div>

	<!-- Warning -->
	<div
		aria-labelledby={warningAlertTitleId}
		class="rvt-alert rvt-alert--warning"
		data-rvt-alert="warning"
		role="alert"
	>
		<div class="rvt-alert__title" id={warningAlertTitleId}>Unsaved Changes</div>
		<div class="rvt-alert__content">
			<p>
				Your changes have <a href="#">not been saved</a>. To save your changes,
				click 'Save my changes' or click Cancel' to exit without saving.
			</p>
			<div class="rvt-button-group">
				<button
					class="rvt-button rvt-button--medium rvt-button--strong"
					type="button"
				>
					Okay
				</button>
				<button class="rvt-button rvt-button--medium" type="button">
					Dismiss
				</button>
			</div>
		</div>
		<button class="rvt-alert__dismiss" data-rvt-alert-close type="button">
			<span class="rvt-sr-only">Dismiss this alert</span>
		</button>
	</div>

	<!-- Error -->
	<div
		aria-labelledby={errorAlertTitleId}
		class="rvt-alert rvt-alert--danger"
		data-rvt-alert="error"
		role="alert"
	>
		<div class="rvt-alert__title" id={errorAlertTitleId}>
			Incorrect User ID or Password
		</div>
		<div class="rvt-alert__content">
			<p>
				The user ID and password you entered do not match. Please
				<a href="#">check your entries</a> and try again.
			</p>
			<div class="rvt-button-group">
				<button
					class="rvt-button rvt-button--medium rvt-button--strong"
					type="button"
				>
					Okay
				</button>
				<button class="rvt-button rvt-button--medium" type="button">
					Dismiss
				</button>
			</div>
		</div>
		<button class="rvt-alert__dismiss" data-rvt-alert-close type="button">
			<span class="rvt-sr-only">Dismiss this alert</span>
		</button>
	</div>
</div>
