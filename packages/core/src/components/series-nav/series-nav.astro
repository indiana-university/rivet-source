---
export const title = "Series Nav";

const label = Astro.props.label ? `Series (${Astro.props.label})` : "Series";
---

<nav aria-label={label}>
	<rvt-series-nav>
		<a href="?prev" rel="prev">
			<rvt-eyebrow>Previous</rvt-eyebrow>
			<span>Norval Ashton</span>
		</a>
		<a href="?next" rel="next">
			<rvt-eyebrow>Next</rvt-eyebrow>
			<span>Elta Era</span>
		</a>
	</rvt-series-nav>
</nav>

<nav aria-label={label} class="rvt-series-nav">
	<a class="rvt-series-nav__previous" href="#">
		<rvt-eyebrow>Previous</rvt-eyebrow>
		<span class="rvt-series-nav__item">Norval Ashton</span>
	</a>
	<a class="rvt-series-nav__next" href="#">
		<rvt-eyebrow>Next</rvt-eyebrow>
		<span class="rvt-series-nav__item">Elta Era</span>
	</a>
</nav>
