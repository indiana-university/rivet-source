---
export const title = "Factoid";
---

<div class="rvt-factoid">
	<div class="rvt-factoid__item">
		<div class="rvt-factoid__label">Phone:</div>
		<div class="rvt-factoid__content">(317)&nbsp;222&#8209;1111</div>
	</div>
	<div class="rvt-factoid__item">
		<div class="rvt-factoid__label">Email:</div>
		<div class="rvt-factoid__content">
			<a href="#">example@iu.edu</a>
		</div>
	</div>
	<div class="rvt-factoid__item">
		<div class="rvt-factoid__label">Location or Campus:</div>
		<div class="rvt-factoid__content">
			000 University Blvd, Indianapolis, IN 46202
		</div>
	</div>
	<div class="rvt-factoid__item">
		<div class="rvt-factoid__label">Office Hours or Room:</div>
		<div class="rvt-factoid__content">M–F 9:00am–5pm</div>
	</div>
	<div class="rvt-factoid__item">
		<div class="rvt-factoid__label">Pronouns:</div>
		<div class="rvt-factoid__content">They/Them</div>
	</div>
	<div class="rvt-factoid__item">
		<div class="rvt-factoid__label">Social:</div>
		<div class="rvt-factoid__content">
			<ul class="rvt-flex rvt-flex-row rvt-wrap rvt-gap-xs rvt-list-plain">
				<li>
					<a class="rvt-social-link rvt-social-link--bluesky" href="#">
						<rvt-sr-only>Bluesky</rvt-sr-only>
					</a>
				</li>
				<li>
					<a class="rvt-social-link rvt-social-link--facebook" href="#">
						<rvt-sr-only>Facebook</rvt-sr-only>
					</a>
				</li>
				<li>
					<a class="rvt-social-link rvt-social-link--instagram" href="#">
						<rvt-sr-only>Instagram</rvt-sr-only>
					</a>
				</li>
				<li>
					<a class="rvt-social-link rvt-social-link--linkedin" href="#">
						<rvt-sr-only>LinkedIn</rvt-sr-only>
					</a>
				</li>
			</ul>
		</div>
	</div>
</div>
