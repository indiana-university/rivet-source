---
import { createId } from "../../utilities/createId.js";

export const title = "Checkbox - Inline";

const checkboxOneName = `checkbox-demo-${createId()}`;
const checkboxTwoName = `checkbox-demo-${createId()}`;
const checkboxThreeName = `checkbox-demo-${createId()}`;
const checkboxOneId = `checkbox-inline-one-${createId()}`;
const checkboxTwoId = `checkbox-inline-two-${createId()}`;
const checkboxThreeId = `checkbox-inline-three-${createId()}`;
---

<fieldset class="rvt-fieldset">
	<legend>Checkbox list</legend>
	<ul class="rvt-list-inline">
		<li>
			<div class="rvt-checkbox">
				<input
					checked
					id={checkboxOneId}
					name={checkboxOneName}
					type="checkbox"
				/>
				<label for={checkboxOneId}>Option one</label>
			</div>
		</li>
		<li>
			<div class="rvt-checkbox">
				<input id={checkboxTwoId} name={checkboxTwoName} type="checkbox" />
				<label for={checkboxTwoId}>Option two</label>
			</div>
		</li>
		<li>
			<div class="rvt-checkbox">
				<input id={checkboxThreeId} name={checkboxThreeName} type="checkbox" />
				<label for={checkboxThreeId}>Option three</label>
			</div>
		</li>
	</ul>
</fieldset>
