---
import { createId } from "../../utilities/createId.js";

export const title = "Checkbox";

const checkboxOneName = `checkbox-demo-${createId()}`;
const checkboxUnknownName = `checkbox-demo-${createId()}`;
const checkboxTwoName = `checkbox-demo-${createId()}`;
const checkboxThreeName = `checkbox-demo-${createId()}`;
const checkboxLongName = `checkbox-demo-${createId()}`;
const checkboxHiddenLabelName = `checkbox-demo-${createId()}`;
const checkboxOneId = `checkbox-one-${createId()}`;
const checkboxUnknownId = `checkbox-unknown-${createId()}`;
const checkboxTwoId = `checkbox-two-${createId()}`;
const checkboxThreeId = `checkbox-three-${createId()}`;
const checkboxLongId = `checkbox-long-${createId()}`;
const checkboxDescriptionId = `checkbox-description-${createId()}`;
const checkboxHiddenLabelId = `checkbox-hidden-label-${createId()}`;
---

<fieldset class="rvt-fieldset">
	<legend>Checkbox list</legend>
	<ul class="rvt-list-plain rvt-width-xl">
		<li>
			<div class="rvt-checkbox">
				<input
					type="checkbox"
					name={checkboxOneName}
					id={checkboxOneId}
					checked
				/>
				<label for={checkboxOneId}>Option one</label>
			</div>
		</li>
		<li>
			<div class="rvt-checkbox">
				<input
					type="checkbox"
					name={checkboxUnknownName}
					id={checkboxUnknownId}
					indeterminate
				/>
				<label for={checkboxUnknownId}>Option unknown</label>
			</div>
		</li>
		<li>
			<div class="rvt-checkbox">
				<input
					type="checkbox"
					name={checkboxTwoName}
					id={checkboxTwoId}
					disabled
				/>
				<label for={checkboxTwoId}>Option two</label>
			</div>
		</li>
		<li>
			<div class="rvt-checkbox">
				<input
					type="checkbox"
					name={checkboxThreeName}
					id={checkboxThreeId}
					disabled
					checked
				/>
				<label for={checkboxThreeId}>Option three</label>
			</div>
		</li>
		<li>
			<div class="rvt-checkbox">
				<input
					aria-describedby={checkboxDescriptionId}
					type="checkbox"
					name={checkboxLongName}
					id={checkboxLongId}
				/>
				<label for={checkboxLongId}>Just a quick note</label>
				<div id={checkboxDescriptionId} class="rvt-checkbox__description">
					This checkbox has a really long label that can wrap on to two lines
					and still have nice left alignment.
				</div>
			</div>
		</li>
		<li>
			<div class="rvt-checkbox rvt-checkbox--sr-only-label">
				<input
					type="checkbox"
					name={checkboxHiddenLabelName}
					id={checkboxHiddenLabelId}
				/>
				<label for={checkboxHiddenLabelId}
					>This label text is visually hidden</label
				>
			</div>
		</li>
	</ul>
</fieldset>

<script define:vars={{ checkboxUnknownId }}>
	var checkbox = document.getElementById(checkboxUnknownId);
	checkbox.indeterminate = true;
</script>
