---
import { createId } from "../../utilities/createId.js";

export const title = "Dropdown with buttons";

const dropdownId = `dropdown-buttons-${createId()}`;
---

<div class="rvt-dropdown" data-rvt-dropdown={dropdownId}>
	<button
		aria-expanded="false"
		class="rvt-button"
		data-rvt-dropdown-toggle={dropdownId}
		type="button"
	>
		<span class="rvt-dropdown__toggle-text">Dropdown with buttons</span>
		<svg
			aria-hidden="true"
			class="rvt-m-left-xs"
			height="16"
			viewBox="0 0 16 16"
			width="16"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path
				d="M8,12.46a2,2,0,0,1-1.52-.7L1.24,5.65a1,1,0,1,1,1.52-1.3L8,10.46l5.24-6.11a1,1,0,0,1,1.52,1.3L9.52,11.76A2,2,0,0,1,8,12.46Z"
				fill="currentColor"></path>
		</svg>
	</button>
	<div class="rvt-dropdown__menu" data-rvt-dropdown-menu hidden id={dropdownId}>
		<button role="menuitemradio" type="button">
			<span>Notify all</span>
		</button>
		<button aria-checked="true" role="menuitemradio" type="button">
			<span>Notify admins</span>
		</button>
		<button role="menuitemradio" type="button">
			<span>Notify contributors</span>
		</button>
		<div aria-label="Personal settings" role="group">
			<button role="menuitem" type="button">
				<span>Dark mode</span>
			</button>
			<button role="menuitem" type="button">
				<span>Sign out</span>
			</button>
		</div>
	</div>
</div>
