---
export const title = "Dropdown - Open on hover";
---

<div class="rvt-dropdown" data-rvt-dropdown data-rvt-dropdown-open-on-hover>
	<rvt-button>
		<button data-rvt-dropdown-toggle type="button">
			Dropdown menu
			<rvt-icon name="chevron-down"></rvt-icon>
		</button>
	</rvt-button>
	<div class="rvt-dropdown__menu" data-rvt-dropdown-menu hidden>
		<a href="#">Item one</a>
		<a aria-current="page" href="#">
			Item two
		</a>
		<a href="#">Item three</a>
	</div>
</div>
