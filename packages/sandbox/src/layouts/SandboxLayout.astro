---
import pkg from "@rivet-iu/core/package.json";
import Layout from "./BaseLayout.astro";
import { baseUrl } from "../utils/baseUrl.js";
import { removeEnd } from "../utils/removeEnd.js";
import { removeStart } from "../utils/removeStart.js";

const APP_NAME = `Rivet v${pkg.version}`;
const title = Astro.props.title || APP_NAME;
const currentPath = removeStart(Astro.url.pathname, import.meta.env.BASE_URL);
const breadcrumbs = removeEnd(currentPath, "/")
	.split("/")
	.map((part: any, i: any, source: any) => {
		const first = i === 0;
		const last = i === source.length - 1;
		const current: boolean | "page" = last ? "page" : false;
		const label = current ? title : part || APP_NAME;
		const _url = source.slice(1, i + 1).join("/");
		const url = baseUrl(_url);
		return { current, first, label, last, url };
	});
---

<Layout {...Astro.props}>
	<header>
		<a href={breadcrumbs.at(0).url}>{APP_NAME}</a>
		{
			breadcrumbs.length > 1 && (
				<nav>
					<ol class="rvt-breadcrumbs">
						{breadcrumbs.map((item: any) => (
							<li aria-current={item.current}>
								{!item.last && (
									<a href={item.url}>
										<span class={item.first && "rvt-sr-only"}>
											{item.label}
										</span>
									</a>
								)}
								{item.last && item.label}
							</li>
						))}
					</ol>
				</nav>
			)
		}
	</header>
	<h1 class="rvt-sr-only">{title}</h1>
	<slot />
</Layout>

<style>
	header {
		align-items: center;
		background-color: var(--rvt-color-theme-background-strong);
		border-block-end: var(--rvt-border);
		display: flex;
		flex-wrap: wrap;
		gap: var(--rvt-size-8) var(--rvt-size-32);
		padding: var(--rvt-size-16);

		> a {
			color: inherit;
			font: var(--rvt-font-16-bold);
			text-decoration: none;
		}

		> nav {
			display: flex;
		}
	}
</style>
