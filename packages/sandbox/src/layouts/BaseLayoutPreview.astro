---
import Template from "./BaseLayoutTemplate.astro";
import { CORE_PATH } from "../const.js";
---

<Template {...Astro.props}>
	<Fragment slot="head">
		<link href={`${CORE_PATH}/rivet.css`} rel="stylesheet" />
		<link href={`${CORE_PATH}/rivet-icons.css`} rel="stylesheet" />
		<link href={`${CORE_PATH}/rivet-stickers.css`} rel="stylesheet" />
		<script src={`${CORE_PATH}/rivet.js`} type="module"></script>
	</Fragment>
	<slot />
</Template>
