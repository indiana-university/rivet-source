---
import Template from "./BaseLayoutTemplate.astro";
import { baseUrl } from "../utils/baseUrl.js";

const corePath = baseUrl("/@rivet-iu/core/dist");
---

<Template {...Astro.props}>
	<Fragment slot="head">
		<link href={`${corePath}/rivet.css`} rel="stylesheet" />
		<link href={`${corePath}/rivet-icons.css`} rel="stylesheet" />
		<link href={`${corePath}/rivet-stickers.css`} rel="stylesheet" />
		<script src={`${corePath}/rivet.js`} type="module"></script>
	</Fragment>
	<slot />
</Template>
