---
import Template from "./BaseLayoutTemplate.astro";

const corePath = `${import.meta.env.BASE_URL}/@rivet-iu/core/dist`;
---

<Template {...Astro.props}>
	<Fragment slot="head">
		<link rel="icon" href={`${corePath}/favicon.ico`} sizes="32x32" />
		<link rel="icon" href={`${corePath}/favicon.svg`} type="image/svg+xml" />
		<link rel="apple-touch-icon" href={`${corePath}/apple-touch-icon.png`} />
		<link rel="stylesheet" href={`${corePath}/rivet.css`} />
		<link rel="stylesheet" href={`${corePath}/rivet-icons.css`} />
		<link rel="stylesheet" href={`${corePath}/rivet-stickers.css`} />
		<script type="module" src={`${corePath}/rivet.js`}></script>
	</Fragment>
	<slot />
</Template>
