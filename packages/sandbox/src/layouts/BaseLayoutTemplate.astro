---
import appleTouchIcon from "@rivet-iu/core/dist/apple-touch-icon.png?no-inline";
import faviconIco from "@rivet-iu/core/dist/favicon.ico?no-inline";
import { SITE_TITLE } from "../const.js";
import { removeStart } from "../utils/removeStart.js";

const site = Astro.props.site || SITE_TITLE;
const title = Astro.props.title || site;
const currentPath = removeStart(Astro.url.pathname, import.meta.env.BASE_URL);
const isRoot = Astro.props.root || currentPath === "/" || currentPath === "";
const docTitle = isRoot ? site : [title, site].join(" - ");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width, initial-scale=1" name="viewport" />
		<title>{docTitle}</title>
		<link rel="icon" href={faviconIco} sizes="16x16 32x32 48x48" />
		<link rel="apple-touch-icon" href={appleTouchIcon} />
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>
