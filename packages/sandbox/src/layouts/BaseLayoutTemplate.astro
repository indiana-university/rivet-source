---
import { CORE_PATH, SITE_TITLE } from "../const.js";
import { removeStart } from "../utils/removeStart.js";

const site = Astro.props.site || SITE_TITLE;
const title = Astro.props.title || site;
const currentPath = removeStart(Astro.url.pathname, import.meta.env.BASE_URL);
const isRoot = Astro.props.root || currentPath === "/" || currentPath === "";
const docTitle = isRoot ? site : [title, site].join(" - ");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width, initial-scale=1" name="viewport" />
		<title>{docTitle}</title>
		<link href={`${CORE_PATH}/favicon.svg`} rel="icon" type="image/svg+xml" />
		<link
			href={`${CORE_PATH}/favicon.ico`}
			rel="icon"
			sizes="16x16 32x32 48x48"
		/>
		<link href={`${CORE_PATH}/apple-touch-icon.png`} rel="apple-touch-icon" />
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>
