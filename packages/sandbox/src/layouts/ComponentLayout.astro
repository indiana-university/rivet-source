---
import Layout from "./SandboxLayout.astro";

const { page } = Astro.props;
const themes = "light|dark|crimson".split("|");
---

<Layout {...Astro.props}>
	{
		themes.map((theme) => (
			<div class={`rvt-theme-${theme} rvt-p-all-sm`}>
				<page.default label={theme} />
			</div>
		))
	}
</Layout>
