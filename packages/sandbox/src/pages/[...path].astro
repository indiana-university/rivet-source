---
import BaseLayout from "../layouts/BaseLayout.astro";
import ComponentLayout from "../layouts/ComponentLayout.astro";
import IndexLayout from "../layouts/IndexLayout.astro";
import SandboxLayout from "../layouts/SandboxLayout.astro";

export function getStaticPaths() {
	const allPages = import.meta.glob(
		["@src/**/*.astro"],
		{ eager: true },
	);
	const pageEntries: [string, any][] = Object.entries(allPages)
		.map(([k, page]) => {
			const key = k.replace("../../src", "");
			return [key, page] as [string, any];
		})
		.filter(([key, page]) => page.title);
	const pageMap = new Map<string, any>(pageEntries);
	const flatPaths = [...pageMap.keys()];
	const allUniquePaths = new Set();

	for (const path of flatPaths) {
		allUniquePaths.add(path);
		let currentPath = path;
		let lastSlashIndex;
		while ((lastSlashIndex = currentPath.lastIndexOf("/")) !== -1) {
			currentPath = currentPath.slice(0, lastSlashIndex);
			allUniquePaths.add(currentPath || "/");
		}
	}

	const sortedPaths = Array.from(allUniquePaths).sort((a, b) =>
		(a as string).localeCompare((b as string)),
	);
	const pathMap = new Map();

	for (const path of sortedPaths as string[]) {
		const segments = path.split("/");
		const page = pageMap.get(path);
		const root = page?.root;
		const site = page?.site;
		const title = page?.title || segments.at(-1);
		const isFile = /\.astro$/.test(path);
		const type = isFile ? "file" : "folder";
		const isBase = /^\/base\//.test(path);
		const isComponent = /^\/components\//.test(path);
		const isLayout = /^\/layouts\//.test(path);
		const isPrototype = /^\/prototypes\//.test(path);
		const isUtility = /^\/utilities\//.test(path);
		const [fileType] = [
			isBase && "component",
			isComponent && "component",
			isLayout && "layout",
			isPrototype && "prototype",
			isUtility && "utility",
		].filter((ft) => ft);
		const children: any[] = [];
		const cleanPath = path
			.replace(".astro", "");
		const currentNode = {
			children,
			fileType,
			page,
			path: cleanPath,
			root,
			site,
			title,
			type,
		};
		pathMap.set(path, currentNode);
		const parentPath = path.replace(/\/[^/]*$/, "") || "/";

		if (parentPath !== path && pathMap.has(parentPath)) {
			const parentNode = pathMap.get(parentPath);
			parentNode.children.push(currentNode);
		}
	}

	const staticPathPages = import.meta.glob(["@src/**/getStaticPaths.astro"], {
		eager: true,
	});
	const staticPaths = Object.values(staticPathPages).flatMap(
		(file: any) => file.getStaticPaths() || [],
	);

	return [...staticPaths, ...pathMap.values()].map((props) => {
		const { path } = props;
		const params = { path };
		return { params, props };
	});
}

const { page, fileType, type } = Astro.props;
---

{
	type === "file" && fileType === "component" && (
		<ComponentLayout {...Astro.props}>
			<page.default />
		</ComponentLayout>
	)
}

{
	type === "file" && fileType === "layout" && (
		<SandboxLayout {...Astro.props}>
			<page.default />
		</SandboxLayout>
	)
}

{
	type === "file" && fileType === "prototype" && (
		<BaseLayout {...Astro.props}>
			<page.default {...Astro.props} />
		</BaseLayout>
	)
}

{
	type === "file" && fileType === "utility" && (
		<SandboxLayout {...Astro.props}>
			<div class="rvt-p-all-sm">
				<page.default />
			</div>
		</SandboxLayout>
	)
}

{type === "folder" && <IndexLayout {...Astro.props} />}
