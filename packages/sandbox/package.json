{
	"name": "@rivet-iu/sandbox",
	"description": "Development environment",
	"private": true,
	"license": "BSD-3-Clause",
	"homepage": "https://rivet.iu.edu",
	"type": "module",
	"scripts": {
		"dev": "astro dev --open --host",
		"prebuild": "rimraf public",
		"build": "copyfiles ../core/dist/* public/@rivet-iu/*",
		"postbuild": "astro build",
		"prepreview": "pnpm build",
		"preview": "astro preview --open --host"
	},
	"devDependencies": {
		"astro": "6.4.6",
		"copyfiles": "2.4.1",
		"rimraf": "6.1.3"
	},
	"dependencies": {
		"@rivet-iu/core": "workspace:*"
	}
}
