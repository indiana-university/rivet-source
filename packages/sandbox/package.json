{
	"name": "@rivet-iu/sandbox",
	"description": "Development environment",
	"private": true,
	"license": "BSD-3-Clause",
	"homepage": "https://rivet.iu.edu",
	"type": "module",
	"scripts": {
		"dev": "astro dev --open --host",
		"predeps": "rimraf public",
		"deps": "cpy ../core/dist public/@rivet-iu/core",
		"prebuild": "pnpm deps",
		"build": "astro build",
		"postbuild": "pnpm lint",
		"lint": "html-validate --config ../core/.htmlvalidate.js ./dist",
		"prepreview": "pnpm build",
		"preview": "astro preview --open --host"
	},
	"devDependencies": {
		"@rollup/plugin-yaml": "5.0.0",
		"astro": "7.3.5",
		"cpy-cli": "7.0.0",
		"html-validate": "catalog:",
		"rimraf": "6.1.3"
	},
	"dependencies": {
		"@rivet-iu/core": "workspace:*",
		"rivet-source": "workspace:*"
	}
}
