{
	"name": "rivet-core",
	"description": "Rivet Design System for Indiana University",
	"homepage": "https://rivet.iu.edu",
	"version": "3.0.0-alpha.8",
	"license": "BSD-3-Clause",
	"repository": {
		"type": "git",
		"url": "https://github.com/indiana-university/rivet-source"
	},
	"bugs": {
		"url": "https://github.com/indiana-university/rivet-source/issues",
		"email": "rivet@iu.edu"
	},
	"type": "module",
	"module": "./dist/rivet.js",
	"unpkg": "./dist/rivet.js",
	"exports": {
		".": {
			"browser": "./dist/rivet.js",
			"import": "./dist/rivet.js"
		}
	},
	"scripts": {
		"start": "run-s build:tokens start:astro",
		"start:astro": "astro dev --open --host",
		"build": "run-s build:clean build:tokens build:dist build:dist:clean build:zip",
		"build:clean": "rimraf src/**/*tmp* src/**/**/*tmp* dist rivet.zip",
		"build:tokens": "style-dictionary build -c tokens.config.js",
		"build:dist": "vite build",
		"build:dist:clean": "rimraf dist/rivet-{icons,stickers}.js*",
		"build:zip": "zip -r rivet.zip dist",
		"changelog": "node tasks/generate-changelog.js",
		"format": "prettier --write ."
	},
	"files": [
		"dist/**/*",
		"rivet.zip"
	],
	"devDependencies": {
		"@octokit/rest": "22.0.1",
		"astro": "5.16.7",
		"npm-run-all": "4.1.5",
		"prettier": "3.7.4",
		"prettier-plugin-astro": "0.14.1",
		"rimraf": "6.1.2",
		"sass": "1.97.2",
		"style-dictionary": "5.1.3",
		"vite": "7.3.1",
		"vite-plugin-banner": "0.8.1"
	},
	"dependencies": {
		"wicked-elements": "3.1.2"
	}
}
