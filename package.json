{
	"name": "rivet-source",
	"description": "Rivet Design System for Indiana University",
	"homepage": "https://rivet.iu.edu",
	"private": true,
	"type": "module",
	"license": "BSD-3-Clause",
	"repository": {
		"type": "git",
		"url": "https://github.com/indiana-university/rivet-source"
	},
	"bugs": {
		"url": "https://github.com/indiana-university/rivet-source/issues",
		"email": "rivet@iu.edu"
	},
	"scripts": {
		"build": "pnpm --filter @rivet-iu/core... build",
		"changelog": "node tasks/generate-changelog.js",
		"dev": "pnpm --filter @rivet-iu/sandbox... dev",
		"format": "prettier --write .",
		"preview": "pnpm --filter @rivet-iu/sandbox... preview"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.5.0",
			"onFail": "download"
		}
	},
	"devDependencies": {
		"@octokit/rest": "22.0.1",
		"prettier": "3.8.3",
		"prettier-plugin-astro": "0.14.1"
	}
}
