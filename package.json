{
	"name": "rivet-source",
	"description": "Rivet Design System for Indiana University",
	"private": true,
	"homepage": "https://rivet.iu.edu",
	"license": "BSD-3-Clause",
	"type": "module",
	"scripts": {
		"build": "pnpm --filter @rivet-iu/sandbox... build",
		"dev": "pnpm --filter @rivet-iu/sandbox... dev",
		"format": "prettier --write .",
		"preview": "pnpm --filter @rivet-iu/sandbox... preview"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.x",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "11.x",
			"onFail": "download"
		}
	},
	"devDependencies": {
		"prettier": "3.8.3",
		"prettier-plugin-astro": "0.14.1"
	}
}
