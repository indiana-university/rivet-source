{
	"name": "rivet-source",
	"description": "Rivet Design System for Indiana University",
	"private": true,
	"homepage": "https://rivet.iu.edu",
	"license": "BSD-3-Clause",
	"type": "module",
	"scripts": {
		"build": "pnpm --filter @rivet-iu/sandbox... build",
		"dev": "pnpm --filter @rivet-iu/sandbox... dev",
		"lint": "lint-staged",
		"prepare": "husky",
		"preview": "pnpm --filter @rivet-iu/sandbox... preview"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "12",
			"onFail": "download"
		}
	},
	"devDependencies": {
		"@changesets/changelog-github": "1.0.1",
		"@changesets/cli": "3.0.3",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "3.9.6",
		"prettier-plugin-astro": "1.1.0"
	}
}
